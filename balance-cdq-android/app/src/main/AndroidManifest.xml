<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.google.android.apps.docs.editors.sheets" />
        <package android:name="com.ilovepdf.www" />
        <package android:name="com.adobe.reader" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Balance CDQ"
        android:supportsRtl="true"
        android:theme="@style/Theme.BalanceCDQ"
        android:usesCleartextTraffic="false">

        <provider
            android:name=".DrivePdfProvider"
            android:authorities="${applicationId}.pdf"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".AccountSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BalanceCDQ.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cdqaccount" android:host="pick" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SheetOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BalanceCDQ.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cdqsheet" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PdfOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BalanceCDQ.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cdqpdf" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
