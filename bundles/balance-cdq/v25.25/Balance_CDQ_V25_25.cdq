      "file": "Selector.html",
      "op": "replace_literal",
      "search": "(function(){\n'use strict';\nconst ROOT=CDQ_PWA_ORIGIN+'/Rapports--talonnages-CDQ/';\nconst session=crypto.randomUUID();let dialog,progress=null,running=false,checking=false;\nfunction owner(){return typeof estProprietairePrincipalInterface==='function'&&estProprietairePrincipalInterface()&&cdqAccessState==='ready';}\nfunction rpc(name,args=[]){if(!owner())return Promise.reject(Error('Réservé au propriétaire principal.'));return window.cdqAppelServeur(name,args).then(v=>{if(!owner())throw Error('Le compte a changé.');return v;});}\nfunction button(text,fn){const b=document.createElement('button');b.type='button';b.textContent=text;b.onclick=()=>Promise.resolve(fn()).catch(error);return b;}\nfunction error(e){ensure();dialog.querySelector('[data-status]').textContent=e.message||String(e);}\nfunction ensure(){if(dialog)return;dialog=document.createElement('dialog');dialog.id='cdqMigration23';dialog.setAttribute('aria-labelledby','cdqMigrationTitle23');dialog.innerHTML='<h2 id=\"cdqMigrationTitle23\">Sheets → PDF de plancher</h2><p>Les Sheets originaux seront conservés. Chaque balance de plancher sera copiée dans VAPP1.0, sous le même client, dans ses rapports d’étalonnage.</p><progress max=\"100\"></progress><p data-counts></p><p data-current></p><p data-status role=\"status\"></p><details><summary>Fichiers à vérifier</summary><ul></ul></details><p class=\"cdq23-note\">Le traitement continue tant que CDQ reste ouvert et déverrouillé. Après une interruption, il reprend au même fichier à la prochaine ouverture. La pause prend effet après le fichier en cours.</p><footer></footer>';const footer=dialog.querySelector('footer');footer.append(button('Démarrer / reprendre',async()=>{progress=await rpc('demarrerConversionPlancherCDQV2523',[false]);render();loop();}),button('Pause',async()=>{progress=await rpc('suspendreConversionPlancherCDQV2523');render();}),button('Réessayer les erreurs',async()=>{progress=await rpc('demarrerConversionPlancherCDQV2523',[true]);render();loop();}),button('Fermer',()=>dialog.close()));document.body.append(dialog);}\nfunction render(){ensure();if(!progress?.exists){dialog.querySelector('[data-status]').textContent='Prêt à faire l’inventaire, puis à traiter un fichier à la fois.';return;}const p=dialog.querySelector('progress');if(progress.percent===null)p.removeAttribute('value');else p.value=progress.percent;dialog.querySelector('[data-counts]').textContent=progress.phase==='scan'?'Inventaire : '+progress.total+' Sheets trouvés…':progress.processed+' / '+progress.total+' vérifiés · '+progress.remaining+' restants · '+progress.percent+' % — '+progress.converted+' PDF créés, '+progress.skipped+' autres types ignorés, '+progress.errors+' à vérifier';dialog.querySelector('[data-current]').textContent=progress.current;dialog.querySelector('[data-status]').textContent=progress.message||(progress.status==='running'?'Traitement en cours…':progress.status==='completed'?'Parcours terminé.':'En pause.');const ul=dialog.querySelector('ul');ul.replaceChildren();for(const issue of progress.issues||[]){const li=document.createElement('li');li.textContent=issue.client+' / '+issue.file+' : '+issue.error;ul.append(li);}dialog.querySelector('details').hidden=!progress.errors;}\nasync function base64(blob){const bytes=new Uint8Array(await blob.arrayBuffer());let s='';for(let i=0;i<bytes.length;i+=32768)s+=String.fromCharCode(...bytes.subarray(i,i+32768));return btoa(s);}\nasync function loop(){if(running||!owner()||progress?.status!=='running'||navigator.onLine===false)return;running=true;let wake;try{try{wake=await navigator.wakeLock?.request('screen');}catch{}const {fillInFrame}=await import(ROOT+'pdf-fill-client-v2523.mjs');while(owner()&&navigator.onLine!==false&&progress?.status==='running'){\n const step=await rpc('prochaineConversionPlancherCDQV2523',[session]);progress=step.progress;render();if(step.wait){await new Promise(r=>setTimeout(r,5000));continue;}if(step.work){const w=step.work;let blob;try{blob=await fillInFrame(w.values);}catch(e){progress=await rpc('signalerErreurConversionPlancherCDQV2523',[w.id,w.token,e.message]);render();continue;}if(!owner())break;\n // Do not mark an uncertain upload as failed: the reserved ID resolves lost replies on resume.\n progress=await rpc('enregistrerConversionPlancherCDQV2523',[w.id,w.token,await base64(blob)]);render();}\n }}catch(e){error(e);}finally{running=false;wake?.release?.().catch(()=>{});}}\nasync function open(){if(!owner())return;ensure();dialog.showModal();progress=await rpc('obtenirConversionPlancherCDQV2523');render();loop();}\nasync function resume(){if(checking||!owner())return;checking=true;try{progress=await rpc('obtenirConversionPlancherCDQV2523');if(progress.exists){render();loop();}}catch{}finally{checking=false;}}\nfunction mount(){for(const target of document.querySelectorAll('#pc18Users,#cdqAdminSettingsButton')){const parent=target.parentElement;let b=parent.querySelector('[data-migration23]');if(owner()&&!b){b=button('Convertir les Sheets de plancher',open);b.dataset.migration23='';b.className=target.className;parent.append(b);}if(b)b.hidden=!owner();}if(!owner()&&dialog?.open)dialog.close();}\nlet scheduled=false;new MutationObserver(()=>{if(!scheduled){scheduled=true;requestAnimationFrame(()=>{scheduled=false;mount();});}}).observe(document.body,{childList:true,subtree:true});\nwindow.addEventListener('cdq:access-ready',()=>{mount();resume();});window.addEventListener('online',resume);window.addEventListener('focus',()=>{if(progress?.status==='running')resume();});window.cdqFloorMigration23={open};mount();resume();\n})();\n",
      "replacement": "(function(){\n'use strict';\nlet dialog,client=null,progress=null,timer=null;\nconst owner=()=>typeof estProprietairePrincipalInterface==='function'&&estProprietairePrincipalInterface()&&cdqAccessState==='ready';\nasync function rpc(name,args=[]){if(!owner())throw Error('Réservé au propriétaire principal.');const email=utilisateurCourantEmail,result=await window.cdqAppelServeur(name,args);if(!owner()||email!==utilisateurCourantEmail)throw Error('Le compte a changé.');return result;}\nfunction status(text){dialog.querySelector('[data-status]').textContent=text;}\nfunction button(label,fn){const b=document.createElement('button');b.type='button';b.textContent=label;b.onclick=async()=>{b.disabled=true;try{await fn();}catch(e){status(e.message||String(e));}finally{b.disabled=false;}};return b;}\nfunction render(){if(!dialog)return;const p=progress;dialog.querySelector('[data-client]').textContent=client?.nom||'';const bar=dialog.querySelector('progress');if(p?.percent==null)bar.removeAttribute('value');else bar.value=p.percent;dialog.querySelector('[data-counts]').textContent=!p?.exists?'Prêt à parcourir uniquement ce dossier client et ses sous-dossiers.':p.phase==='scan'?'Inventaire : '+p.total+' Sheets trouvés…':p.processed+' / '+p.total+' vérifiés · '+p.percent+' % · '+p.converted+' PDF créés · '+p.errors+' à vérifier';status(p?.message||'');dialog.querySelector('[data-current]').textContent=p?.current||'';const ul=dialog.querySelector('ul');ul.replaceChildren();for(const issue of p?.issues||[]){const li=document.createElement('li');li.textContent=issue.file+' : '+issue.error;ul.append(li);}dialog.querySelector('details').hidden=!p?.errors;}\nasync function poll(){if(!owner()||!dialog?.open||!client)return;try{progress=await rpc('obtenirConversionPlancherCDQV2525',[client.id]);render();}catch(e){status(e.message);}finally{clearTimeout(timer);if(dialog?.open)timer=setTimeout(poll,10000);}}\nasync function open(){\n if(!owner())return;if(!compagnieSelectionnee){afficherErreur(Error('Ouvrez le client source avant de convertir ses Sheets.'));return;}\n client={id:String(compagnieSelectionnee),nom:nomCompagnieSelectionnee||''};\n if(!dialog){dialog=document.createElement('dialog');dialog.id='cdqMigration25';dialog.setAttribute('aria-label','Conversion des Sheets de plancher');dialog.innerHTML='<h2>Sheets → PDF de plancher</h2><h3 data-client></h3><p>Source : ce client et ses sous-dossiers. Destination : VAPP1.0 → même client → Rapports d’étalonnage. Les Sheets originaux restent conservés; les PDF gardent leur titre.</p><progress max=\"100\"></progress><p data-counts></p><p data-current></p><p data-status role=\"status\"></p><details><summary>Fichiers à vérifier</summary><ul></ul></details><p>La conversion continue sur le serveur même si CDQ ou le téléphone est fermé. Un fichier est traité à la fois, environ chaque minute. « Charge utilisée » du Sheet devient « Charge de contrainte » du PDF.</p><footer></footer>';\n  const footer=dialog.querySelector('footer');for(const [label,retry] of [['Démarrer / reprendre',false],['Réessayer les erreurs',true]])footer.append(button(label,async()=>{progress=await rpc('demarrerConversionPlancherCDQV2525',[client.id,retry]);render();}));footer.append(button('Pause',async()=>{progress=await rpc('suspendreConversionPlancherCDQV2525',[client.id]);render();}),button('Fermer',()=>dialog.close()));dialog.onclose=()=>clearTimeout(timer);document.body.append(dialog);\n }\n if(!dialog.open)dialog.showModal();await poll();\n}\nfunction mount(){for(const target of document.querySelectorAll('#pc18Users,#cdqAdminSettingsButton')){const parent=target.parentElement;let b=parent.querySelector('[data-migration25]');if(owner()&&!b){b=button('Convertir les Sheets de plancher',open);b.dataset.migration25='';b.className=target.className;parent.append(b);}if(b)b.hidden=!owner();}if(!owner()&&dialog?.open)dialog.close();}\nlet scheduled=false;new MutationObserver(()=>{if(!scheduled){scheduled=true;requestAnimationFrame(()=>{scheduled=false;mount();});}}).observe(document.body,{childList:true,subtree:true});window.addEventListener('cdq:access-ready',mount);window.cdqFloorMigration25={open};mount();\n})();\n"
    },
