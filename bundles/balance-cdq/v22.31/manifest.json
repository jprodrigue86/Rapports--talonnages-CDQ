      "text": "\n<style id=\"cdqPcV2231StableCss\">\n/* V22.31 — PC stable: bas visible, gauche complet, client stable, mur 16:9 dense */\nhtml.windows #cdqPcV16 .pc16-body{\n  grid-template-columns:190px minmax(0,1fr)!important;\n  gap:8px!important;\n}\nhtml.windows #cdqPcV16 .pc16-sidebar{\n  width:auto!important;\n  min-width:190px!important;\n  height:732px!important;\n  margin:0!important;\n  padding:8px 10px 10px!important;\n  border:1px solid #1e5874!important;\n  border-radius:7px!important;\n  background:linear-gradient(180deg,#061622 0%,#04131d 70%,#05141f 100%)!important;\n  box-shadow:inset 0 0 20px rgba(0,0,0,.38),0 0 0 1px rgba(20,133,195,.08)!important;\n  overflow:hidden!important;\n}\nhtml.windows #cdqPcV16 .pc16-center{height:732px!important;min-width:0!important;}\nhtml.windows #cdqPcV16 .pc16-kpi[data-follow=\"clients\"],\nhtml.windows #cdqPcV16 .pc16-kpi[data-follow=\"clients\"] *{\n  animation:none!important;\n  transition:none!important;\n}\nhtml.windows #cdqPcV16 .pc16-kpi[data-follow=\"clients\"] .ico{\n  font-size:31px!important;\n  line-height:1!important;\n  filter:none!important;\n  text-shadow:none!important;\n}\nhtml.pc16-startup-lock #accessOverlay{\n  background:#030507!important;\n  overflow:hidden!important;\n  isolation:isolate!important;\n}\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231{\n  position:absolute!important;\n  left:50%!important;top:50%!important;\n  width:max(100vw,177.778vh)!important;\n  height:max(56.25vw,100vh)!important;\n  transform:translate(-50%,-50%)!important;\n  z-index:0!important;\n  display:grid!important;\n  grid-template-columns:repeat(8,minmax(0,1fr))!important;\n  align-content:space-evenly!important;\n  gap:0!important;\n  padding:3.2vh 2vw!important;\n  overflow:hidden!important;\n  background:\n    radial-gradient(circle at 50% 50%,rgba(135,20,24,.36) 0 9%,rgba(42,8,10,.27) 22%,transparent 47%),\n    linear-gradient(180deg,#030405,#090405 52%,#020304)!important;\n  box-shadow:inset 0 0 13vw rgba(0,0,0,.94)!important;\n}\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231::after{\n  content:\"BALANCE  CDQ\"!important;\n  position:absolute!important;\n  left:50%!important;top:51%!important;\n  transform:translate(-50%,-50%)!important;\n  color:rgba(32,198,231,.16)!important;\n  font:900 clamp(52px,7vw,126px)/.9 Impact,\"Arial Black\",sans-serif!important;\n  letter-spacing:.02em!important;\n  white-space:nowrap!important;\n}\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231 span{\n  display:block!important;\n  padding:.15em .35em!important;\n  color:#d7dbde!important;\n  font:900 clamp(13px,1.25vw,25px)/.92 Impact,\"Arial Black\",Arial,sans-serif!important;\n  text-align:center!important;\n  text-transform:uppercase!important;\n  white-space:nowrap!important;\n  overflow:hidden!important;\n  text-overflow:clip!important;\n  text-shadow:0 2px 6px #000,0 0 9px rgba(255,255,255,.08)!important;\n  opacity:.9!important;\n}\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231 span:nth-child(7n+1),\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231 span:nth-child(11n+3){\n  color:#ce2b32!important;\n}\nhtml.pc16-startup-lock #accessOverlay .cdq-music-wall-v2231 span:nth-child(9n+2){\n  color:#d4b16b!important;\n}\nhtml.pc16-startup-lock #accessOverlay .access-card{\n  position:relative!important;\n  z-index:4!important;\n}\n</style>\n<script id=\"cdqPcV2231StableJs\">\n(function(){\n\"use strict\";\nvar bands=[\"METALLICA\",\"SLAYER\",\"MEGADETH\",\"IRON MAIDEN\",\"JUDAS PRIEST\",\"BLACK SABBATH\",\"PANTERA\",\"MOTÖRHEAD\",\"AC/DC\",\"SLIPKNOT\",\"KORN\",\"LINKIN PARK\",\"SYSTEM OF A DOWN\",\"DISTURBED\",\"TOOL\",\"DEFTONES\",\"ALICE IN CHAINS\",\"SEPULTURA\",\"FEAR FACTORY\",\"STATIC-X\",\"MARILYN MANSON\",\"RAMMSTEIN\",\"GOJIRA\",\"MESHUGGAH\",\"LAMB OF GOD\",\"CANNIBAL CORPSE\",\"DEICIDE\",\"OBITUARY\",\"DYING FETUS\",\"SUFFOCATION\",\"NAPALM DEATH\",\"CARCASS\",\"AMON AMARTH\",\"IN FLAMES\",\"CHILDREN OF BODOM\",\"ARCH ENEMY\",\"BEHEMOTH\",\"DIMMU BORGIR\",\"CRADLE OF FILTH\",\"MAYHEM\",\"BURZUM\",\"LORNA SHORE\",\"WHITECHAPEL\",\"THE BLACK DAHLIA MURDER\",\"DESPISED ICON\",\"TRIVIUM\",\"KILLSWITCH ENGAGE\",\"AS I LAY DYING\",\"PARKWAY DRIVE\",\"AUGUST BURNS RED\",\"BORN OF OSIRIS\",\"VEIL OF MAYA\",\"PERIPHERY\",\"ERRA\",\"TESSERACT\",\"MACHINE HEAD\",\"SOULFLY\",\"TESTAMENT\",\"EXODUS\",\"OVERKILL\",\"KREATOR\",\"SODOM\",\"DESTRUCTION\",\"ANTHRAX\",\"MASTODON\",\"DREAM THEATER\",\"OPETH\",\"TYPE O NEGATIVE\",\"ALL THAT REMAINS\",\"HELLYEAH\",\"SOILWORK\",\"HAMMERFALL\",\"DARK TRANQUILLITY\",\"SUICIDAL TENDENCIES\",\"ASKING ALEXANDRIA\",\"BRING ME THE HORIZON\",\"FALLING IN REVERSE\",\"MOTIONLESS IN WHITE\",\"BAD OMENS\"];\nfunction installWall(){\n  var overlay=document.getElementById(\"accessOverlay\");\n  if(!overlay||overlay.querySelector(\".cdq-music-wall-v2231\"))return;\n  var wall=document.createElement(\"div\");\n  wall.className=\"cdq-music-wall-v2231\";\n  wall.setAttribute(\"aria-hidden\",\"true\");\n  wall.innerHTML=bands.map(function(x){return \"<span>\"+x+\"</span>\";}).join(\"\");\n  overlay.insertBefore(wall,overlay.firstChild);\n}\nfunction fixPc(){\n  var root=document.getElementById(\"cdqPcV16\");\n  if(!root)return false;\n  root.dataset.build=\"v22.31-pc-stable-mur-16x9\";\n  var ver=root.querySelector(\".pc16-side-meta span\");\n  if(ver)ver.textContent=\"V22.31\";\n  var settings=root.querySelector('.pc16-nav button[data-view=\"settings\"]');\n  if(settings){\n    settings.innerHTML='<span class=\"ico\">⚙</span>Outils & paramètres';\n    settings.title=\"Outils et paramètres\";\n  }\n  return true;\n}\ninstallWall();\nif(!fixPc()){\n  var obs=new MutationObserver(function(){\n    installWall();\n    if(fixPc())obs.disconnect();\n  });\n  obs.observe(document.documentElement,{childList:true,subtree:true});\n  setTimeout(function(){installWall();fixPc();},500);\n}\ndocument.addEventListener(\"click\",function(e){\n  var root=document.getElementById(\"cdqPcV16\");\n  if(!root)return;\n  var t=e.target.closest(\"[data-setting],[data-tool]\");\n  if(!t)return;\n  var a=t.dataset.setting||t.dataset.tool||\"\";\n  if(a===\"display\"&&typeof window.ouvrirReglagesAffichage===\"function\"){\n    e.preventDefault();e.stopImmediatePropagation();window.ouvrirReglagesAffichage();\n  }else if(a===\"users\"&&typeof window.ouvrirGestionUtilisateurs===\"function\"){\n    e.preventDefault();e.stopImmediatePropagation();window.ouvrirGestionUtilisateurs();\n  }else if(a===\"inventory\"&&typeof window.ouvrirInventaireCDQ===\"function\"){\n    e.preventDefault();e.stopImmediatePropagation();window.ouvrirInventaireCDQ();\n  }\n},true);\n})();\n</script>\n"
