      "text": "\n<style id=\"cdqV2400FileOpenCss\">\n#cdqV24PdfOverlay{position:fixed!important;inset:0!important;z-index:2147483600!important;display:grid!important;place-items:center!important;padding:18px!important;background:rgba(2,8,13,.90)!important;box-sizing:border-box!important}\n#cdqV24PdfOverlay .cdq-v24-pdf-card{width:min(520px,100%)!important;box-sizing:border-box!important;padding:20px!important;border:1px solid #178fc8!important;border-radius:16px!important;background:linear-gradient(180deg,#0a2232,#06141f)!important;color:#eefaff!important;box-shadow:0 20px 70px rgba(0,0,0,.58),inset 0 0 24px rgba(33,183,255,.04)!important;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif!important}\n#cdqV24PdfOverlay .cdq-v24-pdf-title{margin:0 0 12px!important;font-size:20px!important;line-height:1.15!important;font-weight:900!important;color:#fff!important}\n#cdqV24PdfOverlay .cdq-v24-pdf-text{min-height:24px!important;margin:0 0 12px!important;font-size:15px!important;line-height:1.35!important;font-weight:800!important;color:#dff7ff!important}\n#cdqV24PdfOverlay .cdq-v24-pdf-track{width:100%!important;height:12px!important;overflow:hidden!important;border:1px solid #31566d!important;border-radius:999px!important;background:#07131c!important}\n#cdqV24PdfBar{width:0;height:100%!important;border-radius:999px!important;background:linear-gradient(90deg,#16a9e8,#42d2ff)!important;transition:width .15s linear!important}\n#cdqV24PdfOverlay .cdq-v24-pdf-detail{min-height:20px!important;margin-top:11px!important;color:#9cb9c9!important;font-size:12.5px!important;line-height:1.4!important;word-break:break-word!important}\n#cdqV24PdfClose{width:100%!important;min-height:46px!important;margin-top:14px!important;border:1px solid #2baee5!important;border-radius:10px!important;background:#0d3850!important;color:#fff!important;font-weight:900!important}\n#cdqV24PdfOverlay.error .cdq-v24-pdf-card{border-color:#d6535f!important}\n#cdqV24PdfOverlay.error #cdqV24PdfBar{background:linear-gradient(90deg,#b63845,#eb6570)!important}\n#cdqV24PdfOverlay.error .cdq-v24-pdf-text{color:#ffdce0!important}\n</style>\n<script id=\"cdqV2400FileOpenJs\">\n(function(){\n'use strict';\n\nconst GH_ORIGIN='https://jprodrigue86.github.io';\nconst READER_URL=GH_ORIGIN+'/Rapports--talonnages-CDQ/reader.html?cdq=1&v=24.00';\nlet pdfBusy=false;\nlet originalModify=null;\n\nfunction rpc(name,args,timeoutMs){\n  args=Array.isArray(args)?args:[];\n  let p;\n  try{\n    if(typeof window.cdqAppelServeur==='function')p=window.cdqAppelServeur(name,args);\n    else if(typeof cdqV19Gs==='function')p=cdqV19Gs(name,args);\n    else throw new Error('Pont serveur Balance CDQ indisponible.');\n  }catch(e){return Promise.reject(e);}\n  return Promise.race([\n    Promise.resolve(p),\n    new Promise(function(_,reject){setTimeout(function(){reject(new Error('Le serveur ne répond pas. Réessayez.'));},timeoutMs||30000);})\n  ]);\n}\n\nfunction getMetaFromRow(id){\n  const box=document.querySelector('.file-checkbox[data-file-id=\"'+String(id).replace(/[^A-Za-z0-9_-]/g,'')+'\"]');\n  const row=box&&box.closest('.file-row');\n  return row?{id:String(id),nom:String(row.dataset.fileName||''),type:String(row.dataset.fileType||''),dateModification:String(row.dataset.fileDate||'')}:null;\n}\n\nfunction markOpened(id){\n  try{\n    fichierOuvertPourModification=id;\n    const meta=getMetaFromRow(id)||{};\n    sessionStorage.setItem('fichierEnModification',String(id));\n    sessionStorage.setItem('ancienneDateModification',String(meta.dateModification||''));\n    sessionStorage.setItem('momentModification',String(Date.now()));\n  }catch(_){}\n}\n\nfunction ensureOverlay(){\n  let o=document.getElementById('cdqV24PdfOverlay');\n  if(o)return o;\n  o=document.createElement('div');\n  o.id='cdqV24PdfOverlay';\n  o.innerHTML='<div class=\"cdq-v24-pdf-card\">'+\n    '<div class=\"cdq-v24-pdf-title\">Ouverture du PDF</div>'+\n    '<div class=\"cdq-v24-pdf-text\" id=\"cdqV24PdfText\">Préparation…</div>'+\n    '<div class=\"cdq-v24-pdf-track\"><div id=\"cdqV24PdfBar\"></div></div>'+\n    '<div class=\"cdq-v24-pdf-detail\" id=\"cdqV24PdfDetail\"></div>'+\n    '<button type=\"button\" id=\"cdqV24PdfClose\" hidden>Fermer</button>'+\n  '</div>';\n  document.body.appendChild(o);\n  o.querySelector('#cdqV24PdfClose').onclick=function(){o.remove();pdfBusy=false;};\n  return o;\n}\n\nfunction progress(text,pct,detail,error){\n  const o=ensureOverlay();\n  const t=o.querySelector('#cdqV24PdfText'),b=o.querySelector('#cdqV24PdfBar'),d=o.querySelector('#cdqV24PdfDetail'),c=o.querySelector('#cdqV24PdfClose');\n  if(t)t.textContent=String(text||'');\n  if(b)b.style.width=Math.max(0,Math.min(100,Number(pct)||0))+'%';\n  if(d)d.textContent=String(detail||'');\n  if(c)c.hidden=!error;\n  o.classList.toggle('error',!!error);\n}\nfunction closeOverlay(){const o=document.getElementById('cdqV24PdfOverlay');if(o)o.remove();}\nfunction b64ToBytes(base64){const bin=atob(String(base64||'')),out=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i);return out;}\n\nasync function blobToBase64(blob){\n  const bytes=new Uint8Array(await blob.arrayBuffer());\n  let binary='';\n  const step=0x8000;\n  for(let i=0;i<bytes.length;i+=step)binary+=String.fromCharCode.apply(null,bytes.subarray(i,i+step));\n  return btoa(binary);\n}\nfunction isReadOnly(){try{return String(utilisateurCourantRole||'')==='lecture';}catch(_){return false;}}\n\nfunction openReader(id,name,blob){\n  return new Promise(function(resolve,reject){\n    const old=document.getElementById('cdqReaderFrame');if(old)old.remove();\n    const frame=document.createElement('iframe');\n    frame.id='cdqReaderFrame';frame.title=name||'Rapport PDF';frame.src=READER_URL;frame.referrerPolicy='origin';\n    frame.style.cssText='position:fixed;inset:0;width:100%;height:100%;border:0;z-index:2147483000;background:#101820';\n    let ready=false,finished=false;\n    const saveIds=new Set();\n    const timer=setTimeout(function(){\n      if(ready||finished)return;\n      finished=true;window.removeEventListener('message',receive);frame.remove();\n      reject(new Error('Le lecteur PDF CDQ n’a pas répondu.'));\n    },20000);\n\n    async function receive(event){\n      if(event.source!==frame.contentWindow||event.origin!==GH_ORIGIN)return;\n      const data=event.data||{};\n      if(data.type==='CDQ_READER_READY'){\n        ready=true;clearTimeout(timer);\n        frame.contentWindow.postMessage({type:'CDQ_READER_OPEN',blob:blob,name:name||'Rapport.pdf',fileId:String(id),readOnly:isReadOnly()},GH_ORIGIN);\n        if(!finished){finished=true;resolve(true);}\n        return;\n      }\n      if(data.type==='CDQ_READER_CLOSE'){\n        window.removeEventListener('message',receive);frame.remove();return;\n      }\n      if(data.type==='CDQ_READER_SAVE'&&data.blob instanceof Blob&&typeof data.requestId==='string'){\n        if(saveIds.has(data.requestId))return;\n        saveIds.add(data.requestId);\n        try{\n          const base64=await blobToBase64(data.blob);\n          const uploadId='v24-'+crypto.randomUUID().replace(/[^A-Za-z0-9_-]/g,'');\n          await rpc('enregistrerPdfRempliCDQV24',[String(id),base64,uploadId],60000);\n          frame.contentWindow.postMessage({type:'CDQ_READER_SAVED',requestId:data.requestId,ok:true,queued:false},GH_ORIGIN);\n        }catch(err){\n          frame.contentWindow.postMessage({type:'CDQ_READER_SAVED',requestId:data.requestId,ok:false,error:err&&err.message?err.message:String(err)},GH_ORIGIN);\n        }\n      }\n    }\n    window.addEventListener('message',receive);\n    document.body.appendChild(frame);\n  });\n}\n\nasync function openPdf(id){\n  id=String(id||'');\n  if(!/^[A-Za-z0-9_-]{10,200}$/.test(id))return false;\n  if(pdfBusy)return true;\n  pdfBusy=true;markOpened(id);\n  progress('Préparation du PDF…',4,'Connexion au fichier…',false);\n  try{\n    const meta=await rpc('preparerPdfOuvertureCDQV24',[id],20000);\n    if(!meta||!meta.ok||!meta.token||!meta.chunks||!meta.taille)throw new Error('Le serveur n’a pas préparé le PDF.');\n    if(meta.taille>15*1024*1024)throw new Error('Ce PDF dépasse la limite de 15 Mo.');\n    const parts=[];\n    for(let i=0;i<meta.chunks;i++){\n      const pct=8+Math.round((i/meta.chunks)*72);\n      progress('Téléchargement du PDF…',pct,'Bloc '+(i+1)+' sur '+meta.chunks,false);\n      const part=await rpc('obtenirBlocPdfOuvertureCDQV24',[meta.token,i],30000);\n      if(!part||!part.ok||Number(part.index)!==i||!part.base64)throw new Error('Bloc PDF invalide : '+(i+1)+'.');\n      parts.push(b64ToBytes(part.base64));\n    }\n    progress('Vérification du PDF…',84,'Assemblage du document…',false);\n    const blob=new Blob(parts,{type:'application/pdf'});\n    if(blob.size!==Number(meta.taille))throw new Error('Le PDF reçu est incomplet.');\n    if((await blob.slice(0,5).text())!=='%PDF-')throw new Error('Le fichier reçu n’est pas un PDF valide.');\n    progress('Ouverture du lecteur…',94,String(meta.nom||'Rapport.pdf'),false);\n    await openReader(id,String(meta.nom||'Rapport.pdf'),blob);\n    closeOverlay();pdfBusy=false;return true;\n  }catch(err){\n    pdfBusy=false;\n    progress('Impossible d’ouvrir le PDF',100,err&&err.message?err.message:String(err),true);\n    try{if(typeof afficherMessage==='function')afficherMessage(err&&err.message?err.message:String(err),false);}catch(_){}\n    return false;\n  }\n}\n\nfunction openSheet(id){\n  id=String(id||'');\n  if(!/^[A-Za-z0-9_-]{10,200}$/.test(id))return false;\n  const web='https://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit';\n  const href=/Android/i.test(navigator.userAgent||'')\n    ? 'intent://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit#Intent;scheme=https;package=com.google.android.apps.docs.editors.sheets;S.browser_fallback_url='+encodeURIComponent(web)+';end'\n    : web;\n  markOpened(id);\n  const a=document.createElement('a');a.href=href;a.target='_self';a.rel='noopener';a.style.display='none';\n  document.body.appendChild(a);a.click();a.remove();return true;\n}\n\nfunction clarifyAccountSettings(){\n  const status=document.getElementById('cdqDefaultGoogleStatusV2294');\n  if(status){\n    const saved=(function(){try{return String(localStorage.getItem('cdqDefaultGoogleAccountV2294')||'').trim();}catch(_){return '';}})();\n    status.innerHTML=saved\n      ? 'Compte mémorisé dans Balance CDQ : <strong>'+saved.replace(/[&<>\"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]);})+'</strong><br><small>L’application Google Sheets peut quand même afficher son propre sélecteur de compte.</small>'\n      : 'Compte mémorisé dans Balance CDQ : <strong>Aucun</strong><br><small>Le compte actif de l’application Google Sheets reste géré par Google.</small>';\n    const card=status.closest('.cdq-settings-card-v2294');\n    if(card)card.querySelectorAll('p').forEach(function(p){\n      if(/Ce compte sera proposé automatiquement à Google/i.test(p.textContent||'')){\n        p.textContent='Balance CDQ peut mémoriser un compte préféré, mais Android ne fournit pas de mécanisme public pour imposer ce compte à l’application Google Sheets.';\n      }\n    });\n  }\n  const native=document.getElementById('cdqNativeAccountBoxV2311');\n  if(native){const p=native.querySelector('p');if(p)p.textContent='Compte mémorisé par la couche Android Balance CDQ. Google Sheets conserve toutefois le contrôle de son compte actif.';}\n}\n\nfunction metaForId(id){try{if(typeof cdqDocumentMeta==='function')return cdqDocumentMeta(id);}catch(_){}return getMetaFromRow(id);}\nwindow.cdqV24OpenPdf=openPdf;window.cdqV24OpenSheet=openSheet;\nclarifyAccountSettings();setTimeout(clarifyAccountSettings,300);setTimeout(clarifyAccountSettings,1000);\ndocument.addEventListener('click',function(e){\n  if(e.target&&e.target.closest&&e.target.closest('#cdqTopDisplayButtonV2204,#displayModeButton')){\n    setTimeout(clarifyAccountSettings,80);setTimeout(clarifyAccountSettings,300);\n  }\n},true);\n\ntry{window.cdqOuvrirPdfCommeSheetV2275=openPdf;cdqOuvrirPdfCommeSheetV2275=openPdf;}catch(_){}\ntry{window.cdqV19OpenOfflineSheet=openSheet;cdqV19OpenOfflineSheet=openSheet;}catch(_){}\n\ntry{\n  originalModify=window.modifierFichier;\n  const cleanModify=function(id){\n    const meta=metaForId(id);\n    if(meta&&meta.type==='PDF')return openPdf(id);\n    if(meta&&meta.type==='GOOGLE_SHEETS')return openSheet(id);\n    return typeof originalModify==='function'?originalModify(id):undefined;\n  };\n  window.modifierFichier=cleanModify;modifierFichier=cleanModify;\n}catch(_){}\n\nlet fileTap=null;\ndocument.addEventListener('pointerdown',function(e){\n  if(e.target&&e.target.closest&&e.target.closest('button'))return;\n  const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;if(!row)return;\n  const box=row.querySelector('.file-checkbox[data-file-id]');if(!box)return;\n  const type=String(row.dataset.fileType||'');if(type!=='PDF'&&type!=='GOOGLE_SHEETS')return;\n  fileTap={row:row,id:String(box.dataset.fileId||''),type:type,pid:e.pointerId,x:e.clientX,y:e.clientY,moved:false};\n},true);\ndocument.addEventListener('pointermove',function(e){\n  if(!fileTap||fileTap.pid!==e.pointerId)return;\n  if(Math.abs(e.clientX-fileTap.x)>18||Math.abs(e.clientY-fileTap.y)>18)fileTap.moved=true;\n},true);\ndocument.addEventListener('pointercancel',function(e){if(fileTap&&fileTap.pid===e.pointerId)fileTap=null;},true);\ndocument.addEventListener('pointerup',function(e){\n  if(!fileTap||fileTap.pid!==e.pointerId)return;\n  const t=fileTap;fileTap=null;\n  if(t.moved)return;\n  if(e.target&&e.target.closest&&e.target.closest('button'))return;\n  if(document.body.classList.contains('selection-active'))return;\n  try{if(typeof modeSelectionFichiers!=='undefined'&&modeSelectionFichiers)return;}catch(_){}\n  if(t.row.classList.contains('cdq-swiped-left')||t.row.classList.contains('cdq-swiped-right'))return;\n  t.row.dataset.cdqV24Opened='1';\n  if(t.type==='PDF')openPdf(t.id);else if(t.type==='GOOGLE_SHEETS')openSheet(t.id);\n  setTimeout(function(){try{delete t.row.dataset.cdqV24Opened;}catch(_){}},900);\n},true);\ndocument.addEventListener('click',function(e){\n  const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;if(!row)return;\n  if(row.dataset.cdqV24Opened==='1'){e.preventDefault();e.stopImmediatePropagation();delete row.dataset.cdqV24Opened;return;}\n  if(e.target&&e.target.closest&&e.target.closest('button'))return;\n  if(document.body.classList.contains('selection-active'))return;\n  if(row.classList.contains('cdq-swiped-left')||row.classList.contains('cdq-swiped-right'))return;\n  const type=String(row.dataset.fileType||'');if(type!=='PDF'&&type!=='GOOGLE_SHEETS')return;\n  const box=row.querySelector('.file-checkbox[data-file-id]');if(!box)return;\n  e.preventDefault();e.stopImmediatePropagation();\n  if(type==='PDF')openPdf(box.dataset.fileId);else openSheet(box.dataset.fileId);\n},true);\n})();\n</script>\n"
