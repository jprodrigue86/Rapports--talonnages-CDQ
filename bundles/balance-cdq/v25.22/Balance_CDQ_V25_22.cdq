      "replacement": "<style id=\"cdqInterfaceV2522\">\n/* Compact controls stay independent from the document/icon scale sliders. */\n#selectionBar.selection-mode-bar{box-sizing:border-box!important;min-height:52px!important;height:auto!important;max-width:100%!important;padding:5px 8px!important;gap:8px!important;align-items:center!important;flex-wrap:nowrap!important;border-radius:12px!important;background:#17232b!important}\n#selectionBar .selection-mode-copy{display:none!important}\n#selectionBar #fileCount{flex:1 1 auto!important;min-width:0!important;font:600 14px/1.25 system-ui,sans-serif!important;color:#eef3f7!important;white-space:normal!important}\n#selectionBar #deleteButton,#selectionBar #finishSelectionButton{box-sizing:border-box!important;flex:0 0 42px!important;width:42px!important;min-width:42px!important;height:42px!important;min-height:42px!important;padding:0!important;margin:0!important;border-radius:9px!important;font:600 23px/1 system-ui,sans-serif!important}\n#selectionBar #finishSelectionButton{background:#26323b!important;color:#fff!important;border:1px solid #61717f!important}\n#selectionBar #deleteButton{background:#662f35!important;color:#fff!important}\nhtml.windows #cdqPcV16 .pc17-clock,html.windows #cdqPcV16 .pc16-side-meta,html.windows #cdqPcV16 #pc16UpdateBadge,html.windows #cdqPcV16 #cdqPcUpdateBannerV2244{display:none!important}\nhtml.windows #cdqPcV16 .pc22-online-version{display:flex!important;align-items:center!important;gap:9px!important;font-size:11px!important;white-space:nowrap!important}\nhtml.windows #cdqPcV16 .pc22-version{color:#bdc8d3!important;font-weight:600!important}\nhtml.windows #cdqPcV16 .pc17-context-bar{min-height:44px!important;padding:5px 8px!important;gap:7px!important;flex-wrap:wrap!important}\nhtml.windows #cdqPcV16 .pc17-context-bar>span{font-size:13px!important;min-width:0!important;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\nhtml.windows #cdqPcV16 .pc17-context-bar button{min-height:3