      "replacement": "setStatus(\"Copie créée sur cet appareil. Synchronisation dès que possible.\",\"success\");"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "      type:\"CDQ_OFFLINE_CREATE_LOCAL\",\n      requestId:requestId,",
      "replacement": "      type:\"CDQ_OFFLINE_CREATE_LOCAL\",\n      open:modeleId==='plancher',\n      requestId:requestId,"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "async function cdqV2112EnsureTemplateOfflineCachedImpl(showProgress,modeleId){\n  modeleId=cdqModeleIntermediaireId(modeleId);",
      "replacement": "async function cdqV2112EnsureTemplateOfflineCachedImpl(showProgress,modeleId){\n  modeleId=cdqModeleIntermediaireId(modeleId);\n  if(modeleId==='plancher')return window.cdqEnsureFloorV2519();"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "async function cdqV2112TemplateReady(modeleId){\n  const r=await cdqV2112GetCachedTemplate(modeleId);",
      "replacement": "async function cdqV2112TemplateReady(modeleId){\n  const r=await cdqV2112GetCachedTemplate(modeleId);\n  if(cdqModeleIntermediaireId(modeleId)==='plancher'){const t=await window.cdqFloorTemplateV2519();return !!(r&&r.templateId===t.templateId&&r.sha256===t.sha256&&r.blob instanceof Blob&&r.blob.size===t.taille);}"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "async function cdqV2112CreerCopieLocaleTemplate(destinationId,idClient,modeleId,requestId){",
      "replacement": "async function cdqV2112CreerCopieLocaleTemplate(destinationId,idClient,modeleId,requestId){\n  if(modeleId==='plancher'){\n    if(cdqAccessState!=='ready'||!['admin','technicien'].includes(utilisateurCourantRole))throw new Error('Votre compte ne peut pas créer de rapport.');\n    await cdqV2112EnsureTemplateOfflineCached(false,'plancher');\n    cdqPublierSessionHorsLigne();\n  }"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "<script id=\"cdqV2291PlancherEmbeddedWarmupJs\">\n(function(){\n  'use strict';\n  let running=null,done=false;\n  async function warmPlancher(){\n    if(done||running||navigator.onLine===false||cdqAccessState!=='ready')return running;\n    const email=String(utilisateurCourantEmail||'');\n    if(!email)return;\n    running=(async function(){\n      try{\n        if(typeof cdqPublierSessionHorsLigne==='function')cdqPublierSessionHorsLigne();\n        await cdqV2112EnsureTemplateOfflineCached(false,'plancher');\n        const rec=await cdqV2112GetCachedTemplate('plancher');\n        if(!rec||!(rec.blob instanceof Blob)||rec.blob.type!=='application/pdf')return;\n        const blobRapport=typeof cdqPersonnaliserBlobTechnicienPdf==='function'\n          ? await cdqPersonnaliserBlobTechnicienPdf(rec.blob) : rec.blob;\n        if(email!==String(utilisateurCourantEmail||'')||cdqAccessState!=='ready')return;\n        cdqPostToPwa({type:'CDQ_OFFLINE_TEMPLATE',email:email,modeleId:'plancher',blob:blobRapport,\n          templateId:rec.templateId,modifieLe:rec.modifieLe,revision:rec.revision,sha256:'',name:'Balance de plancher'});\n        done=true;\n      }catch(e){console.warn('Préparation intégrée Balance de plancher :',e&&e.message?e.message:e);}\n      finally{running=null;}\n    })();\n    return running;\n  }\n  window.addEventListener('cdq:access-ready',function(){setTimeout(warmPlancher,900);});\n  window.addEventListener('online',function(){setTimeout(warmPlancher,700);});\n  if(document.readyState!=='loading')setTimeout(warmPlancher,1400);\n})();\n</script>",
      "replacement": "<script id=\"cdqV2519PlancherEmbeddedJs\">\n(function(){\n'use strict';\nconst meta=Object.freeze({\"modeleId\":\"plancher\",\"templateId\":\"cdq-app-plancher-v2519-d386179c7186debc0f7f\",\"name\":\"Balance de plancher.pdf\",\"sha256\":\"d386179c7186debc0f7fc17ded80133f739c15ca6f8a44407b69b6f147f5ee92\",\"taille\":628837,\"modifieLe\":1790117959420});\nconst encoded=\"\";\nlet ready;\nfunction floorTemplate(){\n  if(!ready)ready=(async()=>{\n    const bytes=Uint8Array.from(atob(encoded),c=>c.charCodeAt(0));\n    const hash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),b=>b.toString(16).padStart(2,'0')).join('');\n    if(bytes.length!==meta.taille||hash!==meta.sha256)throw new Error('Le modèle intégré est incomplet.');\n    return Object.freeze({...meta,blob:new Blob([bytes],{type:'application/pdf'})});\n  })().catch(e=>{ready=null;throw e;});\n  return ready;\n}\n\nwindow.cdqFloorTemplateV2519=floorTemplate;\nwindow.cdqEnsureFloorV2519=async function(){\n  const email=String(utilisateurCourantEmail||'');\n  const valid=()=>{if(!email||email!==String(utilisateurCourantEmail||'')||cdqAccessState!=='ready')throw new Error('Déverrouillez votre compte pour utiliser le modèle.');};\n  valid();const t=await floorTemplate();valid();\n  const old=await cdqV2112GetCachedTemplate('plancher');valid();\n  if(!old||old.templateId!==t.templateId||old.sha256!==t.sha256||!(old.blob instanceof Blob)||old.blob.size!==t.taille){\n    await cdqV19PutRecord('template-pdf',cdqTemplateRecord('plancher'),{...t,templateType:'plancher',nom:t.name,revision:CDQ_TEMPLATE_REVISION,cachedAt:Date.now()});valid();\n  }\n  return true;\n};\nasync function warm(){\n  if(cdqAccessState!=='ready')return;\n  const email=String(utilisateurCourantEmail||'');\n  try{\n    await window.cdqEnsureFloorV2519();const t=await floorTemplate();\n    if(cdqAccessState!=='ready'||email!==String(utilisateurCourantEmail||''))return;\n    cdqPublierSessionHorsLigne();\n    cdqPostToPwa({...t,type:'CDQ_OFFLINE_TEMPLATE',email:email,revision:CDQ_TEMPLATE_REVISION});\n  }catch(e){console.warn('Modèle intégré :',e.message||String(e));}\n}\nwindow.addEventListener('cdq:access-ready',warm);\nwindow.addEventListener('message',e=>{if(cdqFromPwa(e)&&e.data?.type==='CDQ_OFFLINE_PREPARE')warm();});\nif(document.readyState!=='loading')setTimeout(warm,300);\n})();\n</script>"
    }
  ],
