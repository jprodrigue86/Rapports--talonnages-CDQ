      "op": "replace_literal",
      "search": "  const modele = obtenirModeleIntermediaireCDQ_(modeleId);\n  const systeme = obtenirDossierSystemeCDQ_();",
      "replacement": "  const modele = obtenirModeleIntermediaireCDQ_(modeleId);\n  if(modele.cle === 'plancher')return cdqTemplateEmbarque_('plancher');\n  const systeme = obtenirDossierSystemeCDQ_();"
    },
    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "    if(navigator.onLine === false){\n      await window.cdqCopierTemplateHorsLigne",
      "replacement": "    if(navigator.onLine === false || (modeleId==='plancher' && cdqPwaAvailable())){\n      await window.cdqCopierTemplateHorsLigne"
    },
