      "text": "\n<style id=\"cdqV2255MajorProgressCss\">\n#cdqMajorProgressV2255{\n  position:fixed;left:50%;\n  bottom:calc(92px + env(safe-area-inset-bottom,0px));\n  transform:translateX(-50%) translateY(14px);\n  width:min(570px,calc(100vw - 24px));\n  z-index:2147483000;opacity:0;visibility:hidden;pointer-events:none;\n  transition:opacity .18s ease,transform .18s ease,visibility .18s;\n  font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;\n}\n#cdqMajorProgressV2255.show{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0)}\n#cdqMajorProgressV2255 .card{\n  padding:12px 14px;border:1px solid rgba(47,205,242,.75);border-radius:14px;\n  background:rgba(5,22,34,.97);color:#f2fbff;box-shadow:0 12px 38px rgba(0,0,0,.42);\n}\n#cdqMajorProgressV2255 .head{display:flex;align-items:center;gap:9px}\n#cdqMajorProgressV2255 .spin{width:17px;height:17px;border-radius:50%;border:2px solid rgba(93,224,255,.25);border-top-color:#5de0ff;animation:cdqMajorSpin2255 .8s linear infinite;flex:0 0 auto}\n#cdqMajorProgressV2255 .title{flex:1;min-width:0;font-size:14px;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n#cdqMajorProgressV2255 .pct{min-width:48px;text-align:right;font-size:15px;font-weight:900;color:#63e3ff}\n#cdqMajorProgressV2255 .track{height:9px;margin-top:9px;border-radius:999px;overflow:hidden;background:#112d3d;border:1px solid rgba(70,174,213,.26)}\n#cdqMajorProgressV2255 .fill{height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#1aa9d6,#53e3ff);transition:width .2s ease}\n#cdqMajorProgressV2255 .detail{margin-top:6px;color:#a9c4d1;font-size:12px}\n#cdqMajorProgressV2255.done .spin{animation:none;background:#47d890;border-color:#47d890}\n#cdqMajorProgressV2255.done .pct{color:#62e8a8}\n#cdqMajorProgressV2255.error .spin{animation:none;background:#ff6673;border-color:#ff6673}\n#cdqMajorProgressV2255.error .pct{color:#ff7d87}\n@keyframes cdqMajorSpin2255{to{transform:rotate(360deg)}}\nhtml.windows #cdqMajorProgressV2255{bottom:22px}\nhtml.windows #cdqPcV16 .pc16-side-meta > span:last-child{font-size:0!important;line-height:1!important}\nhtml.windows #cdqPcV16 .pc16-side-meta > span:last-child::after{\n  content:\"V22.55\";font-size:9px!important;font-weight:800!important;color:#dbe8ee!important;white-space:nowrap!important\n}\n</style>\n<script id=\"cdqV2255MajorProgressJs\">\n(function(){\n  'use strict';\n  let seq=0,current=null;\n\n  function ensure(){\n    let e=document.getElementById('cdqMajorProgressV2255');\n    if(e)return e;\n    e=document.createElement('div');e.id='cdqMajorProgressV2255';e.setAttribute('role','status');e.setAttribute('aria-live','polite');\n    e.innerHTML='<div class=\"card\"><div class=\"head\"><span class=\"spin\"></span><strong class=\"title\">Chargement…</strong><span class=\"pct\">0 %</span></div><div class=\"track\"><div class=\"fill\"></div></div><div class=\"detail\">Veuillez patienter…</div></div>';\n    document.body.appendChild(e);return e;\n  }\n  function render(){\n    if(!current)return;\n    const e=ensure(),p=Math.max(0,Math.min(100,Math.round(current.pct||0)));\n    e.classList.toggle('done',current.state==='done');e.classList.toggle('error',current.state==='error');\n    e.querySelector('.title').textContent=current.title||'Chargement…';\n    e.querySelector('.pct').textContent=current.state==='error'?'—':p+' %';\n    e.querySelector('.fill').style.width=p+'%';\n    e.querySelector('.detail').textContent=current.detail||'Traitement en cours…';\n    if(current.shown)e.classList.add('show');\n  }\n  function clear(s){if(!s)return;clearTimeout(s.showTimer);clearTimeout(s.hideTimer);clearInterval(s.autoTimer)}\n  function start(title,detail,opts){\n    opts=opts||{};if(current)clear(current);\n    const token=++seq;current={token,title,detail,pct:Number(opts.start||3),cap:Number(opts.cap||88),state:'work',shown:false,started:Date.now()};\n    current.showTimer=setTimeout(function(){if(current&&current.token===token){current.shown=true;render()}},Number(opts.delay==null?350:opts.delay));\n    if(opts.auto!==false){\n      current.autoTimer=setInterval(function(){\n        if(!current||current.token!==token||current.state!=='work')return;\n        if(current.pct<current.cap)current.pct=Math.min(current.cap,current.pct+Math.max(1,Math.ceil((current.cap-current.pct)*.08)));\n        const s=Math.floor((Date.now()-current.started)/1000);\n        if(s>=12)current.detail=String(detail||'Traitement en cours…')+' · '+s+' s';\n        render();\n      },500);\n    }\n    render();return token;\n  }\n  function update(token,pct,title,detail){\n    if(!current||current.token!==token)return false;\n    if(Number.isFinite(Number(pct)))current.pct=Math.max(current.pct,Math.min(99,Number(pct)));\n    if(title)current.title=title;if(detail)current.detail=detail;render();return true;\n  }\n  function finish(token,title){\n    if(!current||current.token!==token)return false;clear(current);\n    current.pct=100;current.state='done';current.title=title||'Terminé';current.detail='Opération terminée.';current.shown=true;render();\n    current.hideTimer=setTimeout(function(){const e=ensure();e.classList.remove('show');setTimeout(function(){if(current&&current.token===token){clear(current);current=null}},220)},650);\n    return true;\n  }\n  function fail(token,msg){\n    if(!current||current.token!==token)return false;clear(current);\n    current.state='error';current.title='Erreur';current.detail=String(msg||'Opération impossible.');current.shown=true;render();\n    current.hideTimer=setTimeout(function(){const e=ensure();e.classList.remove('show');setTimeout(function(){if(current&&current.token===token){clear(current);current=null}},220)},2200);\n    return true;\n  }\n  window.cdqMajorProgressStartV2255=start;\n  window.cdqMajorProgressUpdateV2255=update;\n  window.cdqMajorProgressFinishV2255=finish;\n  window.cdqMajorProgressFailV2255=fail;\n\n  // Remplace uniquement le téléchargement/préparation des gros PDF.\n  try{\n    cdqEnsurePdf=async function(id,refresh){\n      if(cdqDocumentDownloads.has(id))return cdqDocumentDownloads.get(id);\n      const token=(window.__cdqPdfProgressTokenV2255||0);\n      const op=(async function(){\n        const old=await cdqV19GetRecord('document-pdf',id);\n        if(!navigator.onLine){\n          if(old&&old.blob)return old;\n          throw new Error('Ce PDF n’a pas été préparé. Reconnectez Internet et ouvrez-le une fois.');\n        }\n        if(!refresh&&old&&old.blob&&old.instantCopy&&Number(old.localReadyUntil||0)>Date.now())return old;\n\n        if(token)update(token,8,null,'Lecture des informations du PDF…');\n        let meta;\n        try{meta=await cdqV19Gs('obtenirMetaDocumentPdfCDQ',[id]);}\n        catch(e){if(old&&old.blob&&!refresh)return Object.assign({},old,{stale:true});throw e;}\n\n        if(old&&old.blob&&old.revision===meta.revision&&old.blob.size===meta.taille)return old;\n        if(!meta||!Number.isInteger(Number(meta.chunks))||Number(meta.chunks)<1||Number(meta.chunks)>64||Number(meta.taille)>CDQ_DOCUMENT_MAX_BYTES)\n          throw new Error('Taille PDF invalide.');\n\n        const total=Number(meta.chunks),parts=new Array(total);\n        let done=0,next=0;\n        const workers=Math.min(3,total);\n        if(token)update(token,12,null,'Téléchargement du PDF · 0 / '+total+' blocs');\n\n        async function worker(){\n          while(true){\n            const i=next++;if(i>=total)return;\n            const part=await cdqV19Gs('obtenirChunkDocumentPdfCDQ',[id,meta.revision,i]);\n            if(part.revision!==meta.revision)throw new Error('Le PDF a changé pendant la préparation. Réessayez.');\n            parts[i]=cdqV2112Base64ToBytes(part.base64);\n            done++;\n            if(token){\n              const pct=12+Math.round((done/total)*72);\n              update(token,pct,null,'Téléchargement du PDF · '+done+' / '+total+' blocs');\n            }\n          }\n        }\n        await Promise.all(Array.from({length:workers},worker));\n\n        if(token)update(token,87,null,'Assemblage et vérification du PDF…');\n        const blob=new Blob(parts,{type:'application/pdf'});\n        if(blob.size!==meta.taille||(await blob.slice(0,5).text())!=='%PDF-')throw new Error('Copie PDF incomplète. Réessayez.');\n        const rec=Object.assign({},meta,{blob:blob});\n        await cdqV19PutRecord('document-pdf',id,rec);\n        if(token)update(token,91,null,'Préparation des champs du rapport…');\n        return rec;\n      })();\n      cdqDocumentDownloads.set(id,op);\n      try{return await op;}finally{cdqDocumentDownloads.delete(id);}\n    };\n  }catch(e){}\n\n  // Barre dédiée uniquement quand l'utilisateur ouvre un PDF.\n  try{\n    const originalOpen=cdqOpenPdf;\n    cdqOpenPdf=async function(id){\n      const token=start('Préparation du PDF','Chargement du rapport…',{start:4,delay:300,cap:90,auto:false});\n      window.__cdqPdfProgressTokenV2255=token;\n      try{\n        const rec=await cdqLoadPdfRecord(id);\n        update(token,96,'Préparation du PDF','Ouverture du lecteur…');\n        if(cdqPdfReaderPreference()==='cdq')await cdqOpenPdfInternal(id,rec);\n        else cdqShowPdfReaderChoice(id,rec);\n        finish(token,'PDF prêt');\n      }catch(e){\n        fail(token,e&&e.message?e.message:String(e||'Erreur'));\n        afficherErreur(e);\n      }finally{\n        if(window.__cdqPdfProgressTokenV2255===token)window.__cdqPdfProgressTokenV2255=0;\n      }\n    };\n  }catch(e){}\n\n  // Barre dédiée uniquement à la création d'un nouveau PDF.\n  try{\n    const originalCopy=confirmerCopie;\n    confirmerCopie=async function(){\n      const token=start('Copie du PDF','Création du rapport dans le dossier client…',{start:6,delay:300,cap:86,auto:true});\n      try{\n        const r=await originalCopy.apply(this,arguments);\n        const s=document.getElementById('copyModalStatus');\n        if(s&&s.classList.contains('error'))fail(token,s.textContent||'La copie a échoué.');\n        else finish(token,'PDF copié');\n        return r;\n      }catch(e){\n        fail(token,e&&e.message?e.message:String(e||'Erreur'));throw e;\n      }\n    };\n  }catch(e){}\n\n  // Version PC.\n  function stamp(){\n    const root=document.getElementById('cdqPcV16');if(!root)return;\n    root.dataset.build='v22.55-major-progress-pdf-open';\n    const meta=root.querySelector('.pc16-side-meta span:last-child');if(meta)meta.textContent='V22.55';\n  }\n  setTimeout(stamp,300);\n})();\n</script>\n"
    }
