      "replacement": "<style id=\"cdqInterfaceV2523\">\n#accessOverlay:not([data-state=\"pending\"]):not([data-state=\"loading\"]) .access-card{width:min(320px,calc(100vw - 32px))!important;max-width:320px!important;padding:18px 16px!important;border-radius:16px!important;box-sizing:border-box!important;max-height:calc(100dvh - 32px);overflow:auto}\n#accessOverlay .access-card h2{font-size:19px!important;margin:0 0 10px!important;line-height:1.2!important}\n#accessOverlay .access-card p{font-size:14px!important;line-height:1.4!important;margin:8px 0!important}\n#accessOverlay .cdq-access-lock{width:23px!important;height:23px!important;flex-basis:23px!important}\n#accessOverlay .access-card input{font-size:22px!important;padding:9px!important;min-height:42px!important;box-sizing:border-box}\n#accessOverlay .access-card button{font-size:14px!important;min-height:40px!important;padding:9px 12px!important;margin-top:8px!important}\n#accessOverlay[data-state=\"pending\"]::before,#accessOverlay[data-state=\"loading\"]::before{top:auto!important;bottom:max(22px,env(safe-area-inset-bottom))!important;transform:translateX(-50%)!important}\n.cdq-swipe-action.copy svg,.cdq-swipe-action.copy .icon{width:24px!important;height:24px!important;max-width:24px!important;max-height:24px!important}\n.cdq-swipe-action.copy{font-size:14px!important}\n.cdq23-row-spinner{display:inline-block!important;flex:0 0 16px!important;width:16px!important;height:16px!important;border:2px solid #86929a66!important;border-top-color:#53d5ff!important;border-radius:50%!important;margin:0 8px!important;animation:cdq23-spin .7s linear infinite!important;vertical-align:middle}\n@keyframes cdq23-spin{to{transform:rotate(360deg)}}\n#cdqMigration23{background:#191d23;color:#eef3f8;border:1px solid #596571;border-radius:16px;width:min(620px,calc(100vw - 28px));max-height:calc(100dvh - 36px);overflow:auto;box-sizing:border-box;padding:20px;font:15px/1.5 system-ui}\n#cdqMigration23::backdrop{background:#000a}#cdqMigration23 h2{font-size:21px;margin:0 0 12px}#cdqMigration23 progress{width:100%;height:16px;accent-color:#47c4f0}#cdqMigration23 footer{display:flex;flex-wrap:wrap;gap:8px}#cdqMigration23 button,.cdq23-drive-main button{background:#242e39;color:#eef3f8;border:1px solid #667483;border-radius:8px;padding:9px 12px;font:inherit;cursor:pointer}#cdqMigration23 .cdq23-note{font-size:13px;color:#bfcbd5}#cdqMigration23 li{overflow-wrap:anywhere}\n.cdq23-drive-main{display:flex;flex-direction:column;min-height:160px;height:100%;overflow:hidden;color:inherit;box-sizing:border-box;padding:12px}.cdq23-drive-main header{display:flex;gap:12px;align-items:center;justify-content:space-between}.cdq23-drive-main h2{font:600 20px system-ui;margin:0;overflow-wrap:anywhere}.cdq23-drive-status{font:14px system-ui;color:inherit;margin:8px 0}.cdq23-drive-list{overflow:auto;min-height:0;flex:1}.cdq23-drive-row{display:flex;gap:6px;align-items:center;border-bottom:1px solid #74829144;min-height:54px}.cdq23-drive-row>button{flex:0 0 auto}.cdq23-drive-row>.cdq23-drive-item{display:flex;align-items:center;gap:10px;flex:1;min-width:0;text-align:left;background:transparent;border:0;color:inherit}.cdq23-drive-item>span:last-child{overflow-wrap:anywhere}.cdq23-file-icon{font:600 16px system-ui;width:28px;flex:0 0 28px;color:#efc148}.cdq23-highlight{outline:2px solid #4acaff;outline-offset:-2px}\nhtml:not(.windows) #filesContainer:has(#cdqDriveMain23){display:block!important;height:auto!important;max-height:none!important;overflow:visible!important}.cdq23-drive-main .cdq-drive-crumbs{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}\n.cdq23-drive-item>.cdq23-file-icon{min-width:30px;margin-right:10px}\nhtml:not(.windows) .cdq23-drive-main{height:auto;overflow:visible}html:not(.windows) .cdq23-drive-list{overflow:visible;flex:none}\n@media(prefers-reduced-motion:reduce){.cdq23-row-spinner{animation-duration:1.5s!important}}\n\n@media(max-width:899px){#accessOverlay{background-size:100% 100%!important;background-position:top center!important}}\n\n</style>\n<script id=\"cdq-row-loading-23\">\n(function(){\nconst active=new Map();\nfunction finish(id){const old=active.get(id);if(!old)return;clearTimeout(old.timer);for(const el of old.elements)el.remove();for(const row of old.rows)row.removeAttribute('aria-busy');active.delete(id);}\nwindow.cdqRowLoading23={start(id){finish(id);const key=CSS.escape(String(id)),rows=[...document.querySelectorAll('[data-file=\"'+key+'\"],[data-file-id=\"'+key+'\"]')].map(n=>n.closest('tr,.file-row,.cdq23-drive-row')||n).filter((n,i,a)=>a.indexOf(n)===i),elements=[];for(const row of rows){const spinner=document.createElement('span');spinner.className='cdq23-row-spinner';spinner.setAttribute('role','status');spinner.setAttribute('aria-label','Ouverture du PDF en cours');const host=row.matches('tr')?row.querySelector('td'):row;host?.append(spinner);row.setAttribute('aria-busy','true');elements.push(spinner);}active.set(id,{rows,elements,timer:setTimeout(()=>finish(id),90000)});return ()=>finish(id);},finish};\n})();\n\n</script>\n<script id=\"cdq-creation-23\">\n(function(){\nconst base=CDQ_PWA_ORIGIN+'/Rapports--talonnages-CDQ/';\nwindow.cdqCreationV2523={\n async context(clientId){\n  const email=String(utilisateurCourantEmail||''),key='cdq-client-context23:'+email+':'+clientId;let v={};try{v=JSON.parse(localStorage.getItem(key)||'{}')}catch{}\n  if(navigator.onLine!==false){try{const fresh=await window.cdqAppelServeur('obtenirContexteCreationCDQV2523',[clientId]);if(String(utilisateurCourantEmail||'')!==email)throw Error('Le compte a changé.');v=fresh;try{localStorage.setItem(key,JSON.stringify(v));}catch{}}catch(error){if(String(utilisateurCourantEmail||'')!==email)throw Error('Le compte a changé.');if(/autorisé|autorisation|permission|droits|Choisissez un client/i.test(error.message||''))throw error;/* Un réseau indisponible ne bloque pas la copie locale : garder les coordonnées connues. */}}\n  v.client_nom=String(clientId)===String(compagnieSelectionnee)?String(nomCompagnieSelectionnee||v.client_nom||''):v.client_nom||'';\n  v.client_technicien=String(utilisateurCourantNomRapport||v.client_technicien||'').trim();return v;\n },\n async fill(blob,clientId){const values=await this.context(clientId),{fillInFrame}=await import(base+'pdf-fill-client-v2523.mjs');return fillInFrame(values,{blob,strict:false});},\n async created(result,clientId,requestId){\n  if(!result?.id)return;if(await window.cdqAppelServeur('verifierCreationPreRemplieCDQV2523',[result.id,'save-'+requestId]))return;const email=String(utilisateurCourantEmail||''),meta=await window.cdqAppelServeur('obtenirPdfLecteurCDQV2520',[result.id,'']);\n  let bytes;if(meta.base64)bytes=Uint8Array.from(atob(meta.base64),c=>c.charCodeAt(0));else{const parts=[];for(let i=0;i<meta.chunks;i++){const p=await window.cdqAppelServeur('obtenirChunkDocumentPdfCDQ',[result.id,meta.revision,i]);parts.push(Uint8Array.from(atob(p.base64),c=>c.charCodeAt(0)));}bytes=new Uint8Array(await new Blob(parts).arrayBuffer());}\n  const blob=await this.fill(new Blob([bytes],{type:'application/pdf'}),clientId);if(String(utilisateurCourantEmail||'')!==email)throw Error('Le compte a changé.');const out=new Uint8Array(await blob.arrayBuffer());let bin='';for(let i=0;i<out.length;i+=32768)bin+=String.fromCharCode(...out.subarray(i,i+32768));\n  await window.cdqAppelServeur('enregistrerPdfLecteurCDQV2520',[result.id,btoa(bin),'save-'+requestId,meta.revision]);\n }\n};\n})();\n\n</script>\n<script id=\"cdq-drive-main-23\">\n(function(){\nlet current=null,request=0,account='',mobileSaved=null;\nfunction allowed(){if(cdqAccessState!=='ready')throw Error('Déverrouillez CDQ.');return String(utilisateurCourantEmail||'');}\nasync function rpc(name,args){const owner=allowed(),v=await window.cdqAppelServeur(name,args);if(owner!==allowed())throw Error('Le compte a changé.');return v;}\nfunction el(tag,text,cls){const e=document.createElement(tag);if(text!=null)e.textContent=text;if(cls)e.className=cls;return e;}\nfunction button(text,fn,label){const b=el('button',text);b.type='button';if(label)b.setAttribute('aria-label',label);b.onclick=()=>Promise.resolve(fn()).catch(afficherErreur);return b;}\nfunction target(){return document.documentElement.classList.contains('windows')?document.getElementById('pc16Main'):document.getElementById('filesContainer');}\nfunction render(container=target()){\n if(!container||!current)return;container.replaceChildren();const panel=el('section',null,'cdq23-drive-main');panel.id='cdqDriveMain23';\n const header=el('header');header.append(el('h2',current.nom||'Drive général'),button('Retour aux clients',back));panel.append(header);\n const nav=el('nav',null,'cdq-drive-crumbs');nav.setAttribute('aria-label','Emplacement');for(const c of current.crumbs||[])nav.append(button(c.nom,()=>open(c.id)));panel.append(nav);\n const status=el('p',current.loading?'Chargement…':current.items.length+' éléments','cdq23-drive-status');status.setAttribute('role','status');panel.append(status);\n const list=el('div',null,'cdq23-drive-list pc17-scroll');\n for(const item of current.items){const row=el('div',null,'cdq23-drive-row');row.dataset.fileId=item.id;row.dataset.fileName=item.nom;row.dataset.fileType=item.mimeType==='application/pdf'?'PDF':'';\n const openButton=button('',()=>item.kind==='folder'?open(item.id):openFile(item),'Ouvrir '+item.nom);openButton.className='cdq23-drive-item';openButton.append(el('span',item.kind==='folder'?'📁':item.mimeType==='application/pdf'?'PDF':'▤','cdq23-file-icon'),el('span',item.nom));row.append(openButton);\n row.append(button(item.favori?'★':'☆',async()=>{const r=await rpc('definirFavoriGeneralCDQV2521',[item.id,!item.favori]);item.favori=r.favori;render();},'Favori : '+item.nom));\n if(window.cdqCopyV2522?.authorized())row.append(button('⧉',()=>window.cdqCopyV2522.open(item),'Copier '+item.nom));list.append(row);}\n if(!current.items.length&&!current.loading)list.append(el('p','Ce dossier est vide.'));panel.append(list);\n if(current.nextPageToken)panel.append(button('Charger la suite',()=>open(current.id,'',true)));\n container.append(panel);if(current.highlight){const row=panel.querySelector('[data-file-id=\"'+CSS.escape(current.highlight)+'\"]');row?.classList.add('cdq23-highlight');row?.scrollIntoView({block:'nearest'});}\n}\nfunction back(){request++;current=null;if(document.documentElement.classList.contains('windows'))document.querySelector('#cdqPcV16 [data-view=\"clients\"]')?.click();else{const t=target();if(t&&mobileSaved){t.replaceChildren(...mobileSaved);mobileSaved=null;}}}\nasync function open(id,highlight='',append=false){\n account=allowed();const seq=++request;\n if(!document.documentElement.classList.contains('windows')&&!mobileSaved)mobileSaved=Array.from(target()?.childNodes||[]);\n current=append?current:{id,nom:'Drive général',items:[],crumbs:[],nextPageToken:''};current.loading=true;current.highlight=highlight;\n if(document.documentElement.classList.contains('windows'))window.cdqDesktopV2517?.showDrive?.();else render();\n try{const result=await rpc('obtenirDossierGeneralCDQV2521',[id,append?current.nextPageToken:'']);if(seq!==request)return;current={...result,items:append?[...current.items,...result.items]:result.items,loading:false,highlight};render();}catch(e){if(seq===request){current.loading=false;render();target()?.querySelector('[role=\"status\"]')?.replaceChildren(document.createTextNode(e.message||String(e)));}throw e;}\n}\nasync function openFile(item){if(item.mimeType==='application/pdf')return window.cdqOpenPdfV2520(item.id,{nom:item.nom});const url=item.mimeType==='application/vnd.google-apps.spreadsheet'?'https://docs.google.com/spreadsheets/d/'+item.id+'/edit':'https://drive.google.com/file/d/'+item.id+'/view';window.open(url,'_blank','noopener');}\nasync function show(item){document.getElementById('cdqDriveDialogV2521')?.close();if(item.kind==='folder')return open(item.id);const location=await rpc('obtenirEmplacementGeneralCDQV2523',[item.id]);await open(location.parentId,item.id);}\nwindow.cdqDriveMain23={show,open,render,active:()=>!!current};\nconst afficher=window.afficherContenu;if(typeof afficher==='function')window.afficherContenu=function(...args){if(!current)return afficher.apply(this,args);};\ndocument.addEventListener('click',e=>{const selector=document.documentElement.classList.contains('windows')?'#cdqPcV16 .pc16-nav button':'#companyMenu .company-item,.bottom-nav button';if(current&&e.target.closest(selector)){request++;current=null;mobileSaved=null;}},true);\nwindow.addEventListener('cdq:access-ready',()=>{if(current&&account!==allowed()){request++;current=null;mobileSaved=null;target()?.querySelector('#cdqDriveMain23')?.remove();}});\n})();\n\n</script>\n<script id=\"cdq-migration-23\">\n(function(){\n'use strict';\nconst ROOT=CDQ_PWA_ORIGIN+'/Rapports--talonnages-CDQ/';\nconst session=crypto.randomUUID();let dialog,progress=null,running=false,checking=false;\nfunction owner(){return typeof estProprietairePrincipalInterface==='function'&&estProprietairePrincipalInterface()&&cdqAccessState==='ready';}\nfunction rpc(name,args=[]){if(!owner())return Promise.reject(Error('Réservé au propriétaire principal.'));return window.cdqAppelServeur(name,args).then(v=>{if(!owner())throw Error('Le compte a changé.');return v;});}\nfunction button(text,fn){const b=document.createElement('button');b.type='button';b.textContent=text;b.onclick=()=>Promise.resolve(fn()).catch(error);return b;}\nfunction error(e){ensure();dialog.querySelector('[data-status]').textContent=e.message||String(e);}\nfunction ensure(){if(dialog)return;dialog=document.createElement('dialog');dialog.id='cdqMigration23';dialog.setAttribute('aria-labelledby','cdqMigrationTitle23');dialog.innerHTML='<h2 id=\"cdqMigrationTitle23\">Sheets → PDF de plancher</h2><p>Les Sheets originaux seront conservés. Chaque balance de plancher sera copiée dans VAPP1.0, sous le même client, dans ses rapports d’étalonnage.</p><progress max=\"100\"></progress><p data-counts></p><p data-current></p><p data-status role=\"status\"></p><details><summary>Fichiers à vérifier</summary><ul></ul></details><p class=\"cdq23-note\">Le traitement continue tant que CDQ reste ouvert et déverrouillé. Après une interruption, il reprend au même fichier à la prochaine ouverture. La pause prend effet après le fichier en cours.</p><footer></footer>';const footer=dialog.querySelector('footer');footer.append(button('Démarrer / reprendre',async()=>{progress=await rpc('demarrerConversionPlancherCDQV2523',[false]);render();loop();}),button('Pause',async()=>{progress=await rpc('suspendreConversionPlancherCDQV2523');render();}),button('Réessayer les erreurs',async()=>{progress=await rpc('demarrerConversionPlancherCDQV2523',[true]);render();loop();}),button('Fermer',()=>dialog.close()));document.body.append(dialog);}\nfunction render(){ensure();if(!progress?.exists){dialog.querySelector('[data-status]').textContent='Prêt à faire l’inventaire, puis à traiter un fichier à la fois.';return;}const p=dialog.querySelector('progress');if(progress.percent===null)p.removeAttribute('value');else p.value=progress.percent;dialog.querySelector('[data-counts]').textContent=progress.phase==='scan'?'Inventaire : '+progress.total+' Sheets trouvés…':progress.processed+' / '+progress.total+' vérifiés · '+progress.remaining+' restants · '+progress.percent+' % — '+progress.converted+' PDF créés, '+progress.skipped+' autres types ignorés, '+progress.errors+' à vérifier';dialog.querySelector('[data-current]').textContent=progress.current;dialog.querySelector('[data-status]').textContent=progress.message||(progress.status==='running'?'Traitement en cours…':progress.status==='completed'?'Parcours terminé.':'En pause.');const ul=dialog.querySelector('ul');ul.replaceChildren();for(const issue of progress.issues||[]){const li=document.createElement('li');li.textContent=issue.client+' / '+issue.file+' : '+issue.error;ul.append(li);}dialog.querySelector('details').hidden=!progress.errors;}\nasync function base64(blob){const bytes=new Uint8Array(await blob.arrayBuffer());let s='';for(let i=0;i<bytes.length;i+=32768)s+=String.fromCharCode(...bytes.subarray(i,i+32768));return btoa(s);}\nasync function loop(){if(running||!owner()||progress?.status!=='running'||navigator.onLine===false)return;running=true;let wake;try{try{wake=await navigator.wakeLock?.request('screen');}catch{}const {fillInFrame}=await import(ROOT+'pdf-fill-client-v2523.mjs');while(owner()&&navigator.onLine!==false&&progress?.status==='running'){\n const step=await rpc('prochaineConversionPlancherCDQV2523',[session]);progress=step.progress;render();if(step.wait){await new Promise(r=>setTimeout(r,5000));continue;}if(step.work){const w=step.work;let blob;try{blob=await fillInFrame(w.values);}catch(e){progress=await rpc('signalerErreurConversionPlancherCDQV2523',[w.id,w.token,e.message]);render();continue;}if(!owner())break;\n // Do not mark an uncertain upload as failed: the reserved ID resolves lost replies on resume.\n progress=await rpc('enregistrerConversionPlancherCDQV2523',[w.id,w.token,await base64(blob)]);render();}\n }}catch(e){error(e);}finally{running=false;wake?.release?.().catch(()=>{});}}\nasync function open(){if(!owner())return;ensure();dialog.showModal();progress=await rpc('obtenirConversionPlancherCDQV2523');render();loop();}\nasync function resume(){if(checking||!owner())return;checking=true;try{progress=await rpc('obtenirConversionPlancherCDQV2523');if(progress.exists){render();loop();}}catch{}finally{checking=false;}}\nfunction mount(){for(const target of document.querySelectorAll('#pc18Users,#cdqAdminSettingsButton')){const parent=target.parentElement;let b=parent.querySelector('[data-migration23]');if(owner()&&!b){b=button('Convertir les Sheets de plancher',open);b.dataset.migration23='';b.className=target.className;parent.append(b);}if(b)b.hidden=!owner();}if(!owner()&&dialog?.open)dialog.close();}\nlet scheduled=false;new MutationObserver(()=>{if(!scheduled){scheduled=true;requestAnimationFrame(()=>{scheduled=false;mount();});}}).observe(document.body,{childList:true,subtree:true});\nwindow.addEventListener('cdq:access-ready',()=>{mount();resume();});window.addEventListener('online',resume);window.addEventListener('focus',()=>{if(progress?.status==='running')resume();});window.cdqFloorMigration23={open};mount();resume();\n})();\n\n</script>\n</body>"
