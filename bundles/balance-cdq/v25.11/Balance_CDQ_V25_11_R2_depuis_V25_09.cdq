      "file": "Code.gs",
      "op": "replace_literal",
      "search": "  if(fichier.cdqEmbedded){\n    const bytes=cdqChunkEmbarque_(String(modeleId||'plancher'),index);\n    return {ok:true,index:index,debut:index*CDQ_TEMPLATE_OFFLINE_CHUNK_BYTES_,fin:index*CDQ_TEMPLATE_OFFLINE_CHUNK_BYTES_+bytes.length,total:Number(fichier.getSize()),base64:Utilities.base64Encode(bytes)};\n  }\n",
