      "file": "Selector.html",
      "op": "replace_literal",
      "search": "function cdqDefaultGoogleAccountV2299(){\n  try{\n    if(localStorage.getItem(CDQ_DEFAULT_GOOGLE_ACCOUNT_RESET_V2299)==='1')return '';\n    const saved=String(\n      localStorage.getItem(CDQ_DEFAULT_GOOGLE_ACCOUNT_KEY_V2299)||\n      localStorage.getItem('cdqDefaultGoogleAccountV2294')||\n      ''\n    ).trim().toLowerCase();\n    if(saved)return saved;\n  }catch(e){}\n  try{return String(utilisateurCourantEmail||'').trim().toLowerCase();}catch(e){return '';}\n}\n",
      "replacement": "function cdqDefaultGoogleAccountV2299(){\n  try{return String(localStorage.getItem('cdqDefaultGoogleAccountV2294')||'').trim().toLowerCase();}\n  catch(e){return '';}\n}\n"
