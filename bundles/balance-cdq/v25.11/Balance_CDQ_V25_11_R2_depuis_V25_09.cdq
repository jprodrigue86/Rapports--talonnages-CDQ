    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "// Filet de sécurité Android : certains anciens gestionnaires de swipe\n// consomment le click synthétique après pointerup. On déclenche donc le PDF\n// au pointerup, pendant le vrai geste, puis on supprime seulement le click\n// qui suit afin d'éviter une double ouverture.\n(function(){\n  if(!/Android/i.test(navigator.userAgent||''))return;\n\n  let tap=null;\n\n  document.addEventListener('pointerdown',function(e){\n    if(e.target&&e.target.closest&&e.target.closest('button'))return;\n    const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;\n    if(!row)return;\n    const box=row.querySelector('.file-checkbox[data-file-id]');\n    if(!box)return;\n    const id=String(box.dataset.fileId||'');\n    const meta=cdqDocumentMeta(id);\n    if(!meta||meta.type!=='PDF')return;\n    tap={row:row,id:id,pointerId:e.pointerId,x:e.clientX,y:e.clientY,moved:false};\n  },true);\n\n  document.addEventListener('pointermove',function(e){\n    if(!tap||tap.pointerId!==e.pointerId)return;\n    if(Math.abs(e.clientX-tap.x)>18||Math.abs(e.clientY-tap.y)>18)tap.moved=true;\n  },true);\n\n  document.addEventListener('pointercancel',function(e){\n    if(tap&&tap.pointerId===e.pointerId)tap=null;\n  },true);\n\n  document.addEventListener('pointerup',function(e){\n    if(!tap||tap.pointerId!==e.pointerId)return;\n    const t=tap;tap=null;\n\n    if(t.moved)return;\n    if(typeof modeSelectionFichiers!=='undefined'&&modeSelectionFichiers)return;\n    if(e.target&&e.target.closest&&e.target.closest('button'))return;\n\n    t.row.dataset.cdqPdfOpenedV2275='1';\n    try{\n      cdqOuvrirPdfCommeSheetV2275(t.id);\n    }catch(err){\n      try{afficherErreur(err);}catch(_){}\n    }\n\n    setTimeout(function(){\n      try{delete t.row.dataset.cdqPdfOpenedV2275;}catch(_){}\n    },800);\n  },true);\n\n  document.addEventListener('click',function(e){\n    const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;\n    if(!row||row.dataset.cdqPdfOpenedV2275!=='1')return;\n    e.preventDefault();\n    e.stopImmediatePropagation();\n    delete row.dataset.cdqPdfOpenedV2275;\n  },true);\n})();\n\n",
      "replacement": "// Document taps are handled by cdqDocumentOpen; swipe/selection keep their own handlers.\n\n"
    },
    {
