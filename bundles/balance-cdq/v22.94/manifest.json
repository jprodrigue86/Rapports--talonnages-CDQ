      "before": "</body>",
      "text": "\n\n<style id=\"cdqV2294SettingsCss\">\n#cdqSettingsModalV2294 .modal{max-width:620px}\n#cdqSettingsModalV2294 .cdq-settings-v2294{display:grid;gap:12px;padding:4px 0 8px}\n#cdqSettingsModalV2294 .cdq-settings-card-v2294{\n  border:1px solid #31516a;border-radius:13px;background:#0b1c2b;padding:13px;\n}\n#cdqSettingsModalV2294 .cdq-settings-card-v2294 h3{margin:0 0 4px;font-size:15px}\n#cdqSettingsModalV2294 .cdq-settings-card-v2294 p{margin:4px 0 10px;color:#9fb6c9;font-size:12px;line-height:1.45}\n#cdqSettingsModalV2294 .cdq-settings-row-v2294{display:flex;gap:8px;flex-wrap:wrap}\n#cdqSettingsModalV2294 .cdq-settings-row-v2294 button{\n  flex:1 1 180px;min-height:46px;border:1px solid #268bc0;border-radius:10px;\n  background:#10283d;color:#fff;font-weight:800;padding:9px 11px;\n}\n#cdqSettingsModalV2294 .cdq-settings-email-v2294{\n  width:100%;box-sizing:border-box;min-height:44px;margin:2px 0 9px;padding:9px 11px;\n  border:1px solid #3b5e77;border-radius:9px;background:#071522;color:#fff;font-size:14px;\n}\n#cdqSettingsModalV2294 .cdq-account-current-v2294{\n  padding:9px 10px;border-radius:9px;background:#071522;border:1px solid #203e54;\n  color:#dff6ff;font-size:13px;margin:7px 0 10px;word-break:break-all;\n}\n#cdqSettingsModalV2294 .cdq-account-current-v2294 strong{color:#5de6ff}\n#cdqSettingsModalV2294 .danger-v2294{border-color:#854149!important;background:#32161b!important;color:#ffd8db!important}\nbody.light #cdqSettingsModalV2294 .cdq-settings-card-v2294,\nbody.light #cdqSettingsModalV2294 .cdq-account-current-v2294,\nbody.light #cdqSettingsModalV2294 .cdq-settings-email-v2294{\n  background:#fff;color:#172838;border-color:#c6d5df;\n}\n@media(max-width:620px){\n  #cdqSettingsModalV2294 .modal{width:calc(100vw - 14px)!important;max-width:none!important}\n  #cdqSettingsModalV2294 .cdq-settings-row-v2294{display:grid;grid-template-columns:1fr}\n}\n</style>\n<script id=\"cdqV2294SettingsJs\">\n(function(){\n'use strict';\n\nconst KEY='cdqDefaultGoogleAccountV2294';\nlet originalDisplayOpenV2294=null;\nlet originalBottomDisplayOpenV2294=null;\n\nfunction normalizeEmail(v){\n  return String(v||'').trim().toLowerCase();\n}\nfunction getDefault(){\n  try{return normalizeEmail(localStorage.getItem(KEY)||'');}catch(_){return '';}\n}\nfunction setDefault(email){\n  email=normalizeEmail(email);\n  if(email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))throw new Error('Adresse Google invalide.');\n  try{\n    if(email)localStorage.setItem(KEY,email);\n    else localStorage.removeItem(KEY);\n  }catch(_){}\n  refreshSettings();\n  if(typeof afficherMessage==='function'){\n    afficherMessage(email?'Compte Google par défaut enregistré : '+email:'Compte Google par défaut réinitialisé.',true);\n  }\n  return email;\n}\nfunction withDefault(url){\n  const email=getDefault();\n  if(!email)return String(url||'');\n  try{\n    const u=new URL(String(url||''),location.href);\n    u.searchParams.set('authuser',email);\n    return u.href;\n  }catch(_){return String(url||'');}\n}\nwindow.cdqGoogleDefaultAccountV2294=getDefault;\nwindow.cdqSetGoogleDefaultAccountV2294=setDefault;\nwindow.cdqWithDefaultGoogleAccountV2294=withDefault;\n\n// Google Sheets : conserver le même chemin natif mais ajouter le compte préféré.\nif(typeof cdqSheetUrl==='function'){\n  cdqSheetUrl=function(id){\n    id=String(id||'');\n    if(!/^[\\w-]+$/.test(id))throw new Error('Identifiant de feuille invalide.');\n    return withDefault('https://docs.google.com/spreadsheets/d/'+id+'/edit');\n  };\n  window.cdqSheetUrl=cdqSheetUrl;\n}\nif(typeof cdqSheetAppUrl==='function'){\n  cdqSheetAppUrl=function(id){\n    const url=cdqSheetUrl(id);\n    if(!/Android/i.test(navigator.userAgent||''))return url;\n    const u=new URL(url);\n    return 'intent://docs.google.com'+u.pathname+u.search+\n      '#Intent;scheme=https;package=com.google.android.apps.docs.editors.sheets;'+\n      'S.browser_fallback_url='+encodeURIComponent(url)+';end';\n  };\n  window.cdqSheetAppUrl=cdqSheetAppUrl;\n}\n\n// PDF : même chemin Google Drive natif que V22.90, avec authuser si configuré.\nif(typeof cdqPdfDriveUrlV2275==='function'){\n  cdqPdfDriveUrlV2275=function(id){\n    id=String(id||'');\n    if(!/^[A-Za-z0-9_-]+$/.test(id))throw new Error('Identifiant PDF invalide.');\n    return withDefault('https://drive.google.com/file/d/'+encodeURIComponent(id)+'/view?usp=drivesdk');\n  };\n  window.cdqPdfDriveUrlV2275=cdqPdfDriveUrlV2275;\n}\nif(typeof cdqPdfDriveIntentV2275==='function'){\n  cdqPdfDriveIntentV2275=function(id){\n    const drive=cdqPdfDriveUrlV2275(id);\n    if(!/Android/i.test(navigator.userAgent||''))return drive;\n    const u=new URL(drive);\n    return 'intent://drive.google.com'+u.pathname+u.search+\n      '#Intent;scheme=https;package=com.google.android.apps.docs;'+\n      'S.browser_fallback_url='+encodeURIComponent(drive)+';end';\n  };\n  window.cdqPdfDriveIntentV2275=cdqPdfDriveIntentV2275;\n}\n\nfunction ensureModal(){\n  let o=document.getElementById('cdqSettingsModalV2294');\n  if(o)return o;\n  o=document.createElement('div');\n  o.id='cdqSettingsModalV2294';\n  o.className='modal-overlay';\n  o.style.display='none';\n  o.innerHTML=\n    '<div class=\"modal\">'+\n      '<h2 class=\"cdq-modal-title\">⚙️ Réglages</h2>'+\n      '<div class=\"cdq-modal-body\"><div class=\"cdq-settings-v2294\">'+\n        '<section class=\"cdq-settings-card-v2294\">'+\n          '<h3>🎨 Affichage</h3>'+\n          '<p>Thème, taille de l’interface, texte, icônes et préférences du lecteur PDF.</p>'+\n          '<div class=\"cdq-settings-row-v2294\"><button type=\"button\" id=\"cdqOpenDisplayV2294\">Ouvrir les réglages d’affichage</button></div>'+\n        '</section>'+\n        '<section class=\"cdq-settings-card-v2294\">'+\n          '<h3>☁️ Compte Google par défaut</h3>'+\n          '<p>Ce compte sera proposé automatiquement à Google pour ouvrir les fichiers Sheets et PDF sur cet appareil.</p>'+\n          '<div id=\"cdqDefaultGoogleStatusV2294\" class=\"cdq-account-current-v2294\"></div>'+\n          '<div class=\"cdq-settings-row-v2294\" id=\"cdqCurrentGoogleRowV2294\"></div>'+\n          '<p style=\"margin-top:11px\">Pour utiliser un autre compte Google déjà ajouté sur cet appareil, entre son adresse :</p>'+\n          '<input class=\"cdq-settings-email-v2294\" id=\"cdqDefaultGoogleEmailV2294\" type=\"email\" inputmode=\"email\" autocomplete=\"email\" placeholder=\"nom@gmail.com\">'+\n          '<div class=\"cdq-settings-row-v2294\">'+\n            '<button type=\"button\" id=\"cdqSaveGoogleDefaultV2294\">Enregistrer ce compte</button>'+\n            '<button type=\"button\" id=\"cdqResetGoogleDefaultV2294\" class=\"danger-v2294\">Réinitialiser le compte par défaut</button>'+\n          '</div>'+\n        '</section>'+\n      '</div></div>'+\n      '<div class=\"modal-buttons\"><button type=\"button\" class=\"modal-button cancel-button\" id=\"cdqSettingsCloseV2294\">Fermer</button></div>'+\n    '</div>';\n  document.body.appendChild(o);\n  o.querySelector('#cdqSettingsCloseV2294').onclick=function(){o.style.display='none';};\n  o.addEventListener('click',function(e){if(e.target===o)o.style.display='none';});\n  o.querySelector('#cdqSaveGoogleDefaultV2294').onclick=function(){\n    try{setDefault(o.querySelector('#cdqDefaultGoogleEmailV2294').value);}\n    catch(e){if(typeof afficherErreur==='function')afficherErreur(e);else alert(e.message||e);}\n  };\n  o.querySelector('#cdqResetGoogleDefaultV2294').onclick=function(){setDefault('');};\n  o.querySelector('#cdqOpenDisplayV2294').onclick=function(){\n    o.style.display='none';\n    // Reprendre le vrai panneau Affichage déjà existant.\n    try{\n      const inline=document.getElementById('cdqInlineDisplayPanelV2204');\n      if(originalDisplayOpenV2294){originalDisplayOpenV2294.call(document.getElementById('cdqTopDisplayButtonV2204'));return;}\n      if(originalBottomDisplayOpenV2294){originalBottomDisplayOpenV2294.call(document.getElementById('displayModeButton'));return;}\n      if(typeof window.ouvrirReglagesAffichage==='function'){window.ouvrirReglagesAffichage();return;}\n      if(inline)inline.classList.add('open');\n    }catch(e){if(typeof afficherErreur==='function')afficherErreur(e);}\n  };\n  return o;\n}\nfunction refreshSettings(){\n  const o=ensureModal();\n  const saved=getDefault();\n  const current=normalizeEmail(typeof utilisateurCourantEmail!=='undefined'?utilisateurCourantEmail:'');\n  const status=o.querySelector('#cdqDefaultGoogleStatusV2294');\n  status.innerHTML=saved\n    ? 'Compte par défaut : <strong>'+saved.replace(/[&<>\"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]);})+'</strong>'\n    : 'Compte par défaut : <strong>Aucun</strong> — Google demandera le compte.';\n  const row=o.querySelector('#cdqCurrentGoogleRowV2294');\n  row.innerHTML='';\n  if(current){\n    const b=document.createElement('button');\n    b.type='button';\n    b.textContent='Utiliser mon compte CDQ : '+current;\n    b.onclick=function(){setDefault(current);};\n    row.appendChild(b);\n  }\n  const input=o.querySelector('#cdqDefaultGoogleEmailV2294');\n  if(input&&!input.matches(':focus'))input.value=saved||current||'';\n}\nfunction openSettings(){\n  const inline=document.getElementById('cdqInlineDisplayPanelV2204');\n  if(inline)inline.classList.remove('open');\n  refreshSettings();\n  ensureModal().style.display='flex';\n}\nwindow.cdqOpenSettingsV2294=openSettings;\n\nfunction applyButtons(){\n  const top=document.getElementById('cdqTopDisplayButtonV2204');\n  if(top){\n    if(!top.__cdqOriginalDisplayV2294){\n      top.__cdqOriginalDisplayV2294=top.onclick;\n      if(!originalDisplayOpenV2294)originalDisplayOpenV2294=top.onclick;\n    }\n    if(top.dataset.cdqSettingsV2294!=='1'){\n      top.dataset.cdqSettingsV2294='1';\n    }\n    top.title='Réglages';\n    top.setAttribute('aria-label','Réglages');\n    top.innerHTML='<span aria-hidden=\"true\" style=\"font-size:22px;line-height:1\">⚙</span><span>Réglages</span>';\n    top.onclick=openSettings;\n  }\n\n  const bottom=document.getElementById('displayModeButton');\n  if(bottom){\n    if(!bottom.__cdqOriginalDisplayV2294){\n      bottom.__cdqOriginalDisplayV2294=bottom.onclick;\n      if(!originalBottomDisplayOpenV2294)originalBottomDisplayOpenV2294=bottom.onclick;\n    }\n    bottom.title='Réglages';\n    bottom.setAttribute('aria-label','Réglages');\n    const small=bottom.querySelector('small');if(small)small.textContent='Réglages';\n    const icon=bottom.querySelector('span');if(icon)icon.textContent='⚙';\n    bottom.onclick=openSettings;\n  }\n\n  document.querySelectorAll('.desktop-sidebar-action').forEach(function(btn){\n    const txt=String(btn.textContent||'').trim().toLowerCase();\n    if(txt.indexOf('affichage')!==-1 || btn.dataset.cdqSettingsV2294==='1'){\n      btn.dataset.cdqSettingsV2294='1';\n      btn.innerHTML='<span class=\"side-icon\">⚙</span><span>Réglages</span>';\n      btn.onclick=openSettings;\n    }\n  });\n}\nfunction scheduleApply(){\n  clearTimeout(window.__cdqSettingsApplyV2294);\n  window.__cdqSettingsApplyV2294=setTimeout(applyButtons,70);\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){applyButtons();setTimeout(applyButtons,500);},{once:true});\nelse{applyButtons();setTimeout(applyButtons,500);}\nwindow.addEventListener('load',function(){setTimeout(applyButtons,120);setTimeout(applyButtons,1100);});\ntry{new MutationObserver(scheduleApply).observe(document.body,{childList:true,subtree:true});}catch(_){}\nwindow.addEventListener('cdq:access-ready',function(){setTimeout(refreshSettings,100);});\n})();\n</script>\n\n"
    }
