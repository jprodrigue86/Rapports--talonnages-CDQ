      "file": "Selector.html",
      "op": "insert_before_literal",
      "before": "<script id=\"cdqIconThemesJsV2514\">",
      "text": "<style id=\"cdqIconThemesCssV2514\">\n:root{--cdq-icon-original-v2515:url(\"https://jprodrigue86.github.io/Rapports--talonnages-CDQ/bundles/balance-cdq/v25.14/icons-reference.png\")}\n/* Transparent artwork is embedded once; no external request, tint or rectangular background. */\n.cdq-icon-sample-v2514 {\n  display:block; width:36px; height:36px; flex:0 0 auto;\n  background-image:var(--cdq-icon-art-v2514); background-repeat:no-repeat;\n  background-size:var(--cdq-art-size); background-position:var(--cdq-art-position);\n  filter:none!important;box-shadow:none!important;mix-blend-mode:normal;clip-path:var(--cdq-art-clip,none);\n}\n/* Preserve the original markup, dimensions, click handlers and dynamic action state. */\n.bottom-nav > .bottom-nav-item > .cdq-icon-host-v2514 {position:relative!important;visibility:hidden!important}\n.bottom-nav > .bottom-nav-item > .cdq-icon-host-v2514 * {visibility:hidden!important}\n.bottom-nav > .bottom-nav-item > .cdq-icon-host-v2514::after {\n  content:\"\"; display:block!important; position:absolute!important; visibility:visible!important;\n  height:100%; width:auto; aspect-ratio:1; top:0; left:50%; transform:translateX(-50%);\n  background-image:var(--cdq-icon-art-v2514); background-repeat:no-repeat;\n  background-size:var(--cdq-art-size); background-position:var(--cdq-art-position);\n  mix-blend-mode:normal;clip-path:var(--cdq-art-clip,none); pointer-events:none; filter:none!important; box-shadow:none!important;\n}\n.cdq-icon-picker-v2514 {margin-top:16px;padding-top:14px;border-top:1px solid #31516a}\n.cdq-icon-picker-v2514 h3 {font-size:14px!important;margin:0 0 5px!important;color:inherit}\n.cdq-icon-picker-v2514 p {font-size:12px!important;line-height:1.4!important;margin:0 0 10px!important;color:inherit;opacity:.85}\n.cdq-icon-choices-v2514 {display:grid;gap:8px}\n.cdq-icon-choice-v2514 {\n  width:100%;min-width:0;min-height:76px;padding:10px!important;border:1px solid #34586c;\n  border-radius:10px;background:#0a1d2b;color:#e6f3fb;text-align:left;cursor:pointer;\n}\n.cdq-icon-choice-v2514[aria-pressed=true] {border-color:#43caff;background:#10364a;box-shadow:inset 0 0 0 1px #43caff}\n.cdq-icon-choice-v2514:focus-visible {outline:2px solid #fff;outline-offset:2px}\n.cdq-icon-choice-v2514:disabled {opacity:.55;cursor:default}\n.cdq-icon-choice-head-v2514 {display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;font-size:12px!important;font-weight:700;line-height:1.3}\n.cdq-icon-choice-mark-v2514 {font-size:11px!important;font-weight:400;color:#8fdaff}\n.cdq-icon-preview-v2514 {display:flex;justify-content:space-between;align-items:center;gap:4px;background:#020d14;border-radius:6px;padding:3px}\n@media(max-width:359px){.cdq-icon-preview-v2514 .cdq-icon-sample-v2514{width:30px;height:30px}.cdq-icon-choice-v2514{padding:8px!important}}\n.cdq-icon-status-v2514 {min-height:2.8em;margin-top:10px!important;margin-bottom:0!important}\n\n.cdq-icon-sample-v2514,.bottom-nav > .bottom-nav-item > .cdq-icon-host-v2514::after{background-image:url(\"https://jprodrigue86.github.io/Rapports--talonnages-CDQ/bundles/balance-cdq/v25.15/icons-transparent.webp\")}\n.cdq-icon-sample-v2514[data-art-source=original]{background-image:var(--cdq-icon-original-v2515)}\n</style>\n"
    },
