      "text": "\n<style id=\"cdqV2250GlobalProgressCss\">\n#cdqGlobalProgressV2250{\n  position:fixed;\n  left:50%;\n  bottom:calc(92px + env(safe-area-inset-bottom,0px));\n  transform:translateX(-50%) translateY(16px);\n  width:min(560px,calc(100vw - 24px));\n  z-index:2147483000;\n  opacity:0;\n  visibility:hidden;\n  pointer-events:none;\n  transition:opacity .18s ease,transform .18s ease,visibility .18s;\n  font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif;\n}\n#cdqGlobalProgressV2250.show{\n  opacity:1;\n  visibility:visible;\n  transform:translateX(-50%) translateY(0);\n}\n#cdqGlobalProgressV2250 .cdq-pg-card{\n  border:1px solid rgba(51,204,255,.72);\n  border-radius:14px;\n  padding:12px 14px 13px;\n  background:rgba(5,22,34,.97);\n  box-shadow:0 14px 40px rgba(0,0,0,.45),0 0 0 1px rgba(36,173,220,.10) inset;\n  color:#f2fbff;\n}\n#cdqGlobalProgressV2250 .cdq-pg-head{\n  display:flex;\n  align-items:center;\n  gap:10px;\n}\n#cdqGlobalProgressV2250 .cdq-pg-spinner{\n  width:18px;height:18px;border-radius:50%;\n  border:2px solid rgba(87,216,255,.25);\n  border-top-color:#5de0ff;\n  animation:cdqPgSpinV2250 .8s linear infinite;\n  flex:0 0 auto;\n}\n#cdqGlobalProgressV2250 .cdq-pg-title{\n  flex:1;min-width:0;font-weight:850;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n#cdqGlobalProgressV2250 .cdq-pg-pct{\n  min-width:48px;text-align:right;font-weight:900;font-size:16px;color:#62e3ff;\n}\n#cdqGlobalProgressV2250 .cdq-pg-track{\n  height:9px;margin-top:10px;border-radius:999px;overflow:hidden;\n  background:#112d3d;border:1px solid rgba(70,174,213,.28);\n}\n#cdqGlobalProgressV2250 .cdq-pg-fill{\n  height:100%;width:0;border-radius:inherit;\n  background:linear-gradient(90deg,#1aa9d6,#53e3ff);\n  transition:width .24s ease;\n}\n#cdqGlobalProgressV2250 .cdq-pg-detail{\n  margin-top:7px;color:#a9c4d1;font-size:12px;line-height:1.25;\n}\n#cdqGlobalProgressV2250.done .cdq-pg-spinner{animation:none;border-color:#47d890;background:#47d890}\n#cdqGlobalProgressV2250.done .cdq-pg-pct{color:#62e8a8}\n#cdqGlobalProgressV2250.error .cdq-pg-spinner{animation:none;border-color:#ff6673;background:#ff6673}\n#cdqGlobalProgressV2250.error .cdq-pg-pct{color:#ff7d87}\n@keyframes cdqPgSpinV2250{to{transform:rotate(360deg)}}\nhtml.windows #cdqGlobalProgressV2250{bottom:22px;width:min(620px,calc(100vw - 40px))}\n@media(max-width:700px){\n  #cdqGlobalProgressV2250 .cdq-pg-card{padding:11px 12px 12px}\n  #cdqGlobalProgressV2250 .cdq-pg-title{font-size:14px}\n  #cdqGlobalProgressV2250 .cdq-pg-pct{font-size:15px}\n}\nhtml.windows #cdqPcV16 .pc16-side-meta > span:last-child{font-size:0!important;line-height:1!important}\nhtml.windows #cdqPcV16 .pc16-side-meta > span:last-child::after{\n  content:\"V22.50\";font-size:9px!important;font-weight:800!important;color:#dbe8ee!important;white-space:nowrap!important\n}\n</style>\n<script id=\"cdqV2250GlobalProgressJs\">\n(function(){\n  'use strict';\n\n  let seq=0,current=null,lastGesture=0;\n  let originalApiRun=null;\n  const RPC_META={\n    obtenirContenuClientOptimise:{label:'Chargement des fichiers',detail:'Lecture du dossier client…',start:14},\n    obtenirContenuDossierParesseux:{label:'Chargement du dossier',detail:'Lecture du contenu…',start:16},\n    actualiserContenuClient:{label:'Actualisation du client',detail:'Synchronisation avec Drive…',start:18},\n    copierTemplateBalanceIntermediaire:{label:'Copie du PDF',detail:'Création du rapport dans le dossier client…',start:22},\n    creerDossierClient:{label:'Création du client',detail:'Création du dossier client…',start:20},\n    creerDossierDansCompagnie:{label:'Création du dossier',detail:'Création en cours…',start:22},\n    creerDossiersEnLotPrive:{label:'Création des dossiers',detail:'Traitement du lot…',start:14},\n    supprimerDossier:{label:'Suppression du dossier',detail:'Suppression en cours…',start:26},\n    supprimerFichiers:{label:'Suppression des fichiers',detail:'Suppression en cours…',start:24},\n    supprimerSelectionMultiple:{label:'Suppression de la sélection',detail:'Traitement des éléments…',start:20},\n    renommerDossier:{label:'Renommage du dossier',detail:'Enregistrement du nouveau nom…',start:30},\n    renommerFichier:{label:'Renommage du fichier',detail:'Enregistrement du nouveau nom…',start:30},\n    dupliquerFichier:{label:'Duplication du fichier',detail:'Création de la copie…',start:22},\n    dupliquerFichiers:{label:'Duplication des rapports',detail:'Création des copies…',start:18},\n    restaurerDossier:{label:'Restauration du dossier',detail:'Restauration en cours…',start:22},\n    restaurerFichiers:{label:'Restauration des fichiers',detail:'Restauration en cours…',start:22},\n    restaurerSelectionMultiple:{label:'Restauration',detail:'Restauration des éléments…',start:20},\n    ouvrirFichierPourModification:{label:'Ouverture du PDF',detail:'Préparation du fichier…',start:18},\n    ouvrirFichierLectureSeule:{label:'Ouverture du fichier',detail:'Chargement du document…',start:18},\n    importerFichierClientPC:{label:'Importation du fichier',detail:'Transfert vers le dossier client…',start:12},\n    enregistrerPdfRempliCDQ:{label:'Enregistrement du PDF',detail:'Sauvegarde des modifications…',start:18},\n    copierFichierVersClientPC:{label:'Copie du fichier',detail:'Copie vers le client…',start:20}\n  };\n\n  const EXCLUDED=/^(obtenirProgression|obtenirListeTechniciens|obtenirResumeSuivi|obtenirNonConformites|obtenirSurveillances|obtenirEtatAcces|reprendreActivation|verifierJeton|creerDefiConnexionGoogle|deverrouiller|restaurerSessionApresBiometrie)/i;\n\n  function ensure(){\n    let box=document.getElementById('cdqGlobalProgressV2250');\n    if(box)return box;\n    box=document.createElement('div');\n    box.id='cdqGlobalProgressV2250';\n    box.setAttribute('role','status');\n    box.setAttribute('aria-live','polite');\n    box.innerHTML='<div class=\"cdq-pg-card\"><div class=\"cdq-pg-head\"><span class=\"cdq-pg-spinner\"></span><strong class=\"cdq-pg-title\">Chargement…</strong><span class=\"cdq-pg-pct\">0 %</span></div><div class=\"cdq-pg-track\"><div class=\"cdq-pg-fill\"></div></div><div class=\"cdq-pg-detail\">Veuillez patienter…</div></div>';\n    document.body.appendChild(box);\n    return box;\n  }\n\n  function render(){\n    if(!current)return;\n    const box=ensure(),pct=Math.max(0,Math.min(100,Math.round(current.value||0)));\n    box.classList.toggle('done',current.state==='done');\n    box.classList.toggle('error',current.state==='error');\n    box.querySelector('.cdq-pg-title').textContent=current.label||'Chargement…';\n    box.querySelector('.cdq-pg-pct').textContent=current.state==='error'?'—':pct+' %';\n    box.querySelector('.cdq-pg-fill').style.width=pct+'%';\n    box.querySelector('.cdq-pg-detail').textContent=current.detail||'Traitement en cours…';\n    if(current.shown)box.classList.add('show');\n  }\n\n  function clearTimers(s){\n    if(!s)return;\n    clearTimeout(s.delayTimer);clearTimeout(s.hideTimer);clearInterval(s.autoTimer);\n  }\n\n  function start(label,detail,opts){\n    opts=opts||{};\n    if(current)clearTimers(current);\n    const token=++seq;\n    current={\n      token,label:String(label||'Chargement…'),detail:String(detail||'Traitement en cours…'),\n      value:Math.max(1,Number(opts.start||4)),cap:Math.max(55,Math.min(97,Number(opts.cap||92))),\n      state:'working',lock:!!opts.lock,shown:false\n    };\n    const delay=Math.max(0,Number(opts.delay==null?180:opts.delay));\n    current.delayTimer=setTimeout(function(){\n      if(!current||current.token!==token)return;\n      current.shown=true;render();\n    },delay);\n    current.autoTimer=setInterval(function(){\n      if(!current||current.token!==token||current.state!=='working')return;\n      const remain=current.cap-current.value;\n      if(remain<=0)return;\n      current.value=Math.min(current.cap,current.value+Math.max(1,Math.ceil(remain*.075)));\n      render();\n    },420);\n    render();\n    return token;\n  }\n\n  function update(token,pct,label,detail){\n    if(!current||current.token!==token)return false;\n    if(Number.isFinite(Number(pct)))current.value=Math.max(current.value,Math.min(99,Number(pct)));\n    if(label)current.label=String(label);\n    if(detail)current.detail=String(detail);\n    render();return true;\n  }\n\n  function finish(token,message){\n    if(!current||current.token!==token)return false;\n    clearInterval(current.autoTimer);clearTimeout(current.delayTimer);\n    current.value=100;current.state='done';current.label=message||'Terminé';\n    current.detail='Opération terminée avec succès.';current.shown=true;render();\n    current.hideTimer=setTimeout(function(){\n      if(!current||current.token!==token)return;\n      const box=ensure();box.classList.remove('show');\n      setTimeout(function(){if(current&&current.token===token){clearTimers(current);current=null;}},220);\n    },650);\n    return true;\n  }\n\n  function fail(token,message){\n    if(!current||current.token!==token)return false;\n    clearInterval(current.autoTimer);clearTimeout(current.delayTimer);\n    current.state='error';current.label='Erreur';\n    current.detail=String(message||'L’opération n’a pas pu être terminée.');\n    current.shown=true;render();\n    current.hideTimer=setTimeout(function(){\n      if(!current||current.token!==token)return;\n      const box=ensure();box.classList.remove('show');\n      setTimeout(function(){if(current&&current.token===token){clearTimers(current);current=null;}},220);\n    },2200);\n    return true;\n  }\n\n  function active(){return current;}\n  window.cdqProgressStartV2250=start;\n  window.cdqProgressUpdateV2250=update;\n  window.cdqProgressFinishV2250=finish;\n  window.cdqProgressFailV2250=fail;\n  window.cdqProgressCurrentV2250=active;\n\n  document.addEventListener('pointerdown',function(){lastGesture=Date.now();},{capture:true,passive:true});\n  document.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' ')lastGesture=Date.now();},{capture:true});\n\n  function inferredMeta(name){\n    if(RPC_META[name])return RPC_META[name];\n    if(EXCLUDED.test(name))return null;\n    if(Date.now()-lastGesture>1800)return null;\n    if(/^(copier|importer|enregistrer|dupliquer)/i.test(name))return{label:'Traitement du fichier',detail:'Opération en cours…',start:16};\n    if(/^(creer|ajouter)/i.test(name))return{label:'Création',detail:'Création en cours…',start:18};\n    if(/^(supprimer)/i.test(name))return{label:'Suppression',detail:'Suppression en cours…',start:24};\n    if(/^(renommer|modifier)/i.test(name))return{label:'Enregistrement',detail:'Application des modifications…',start:28};\n    if(/^(ouvrir|charger)/i.test(name))return{label:'Chargement',detail:'Ouverture en cours…',start:16};\n    if(/^(restaurer)/i.test(name))return{label:'Restauration',detail:'Restauration en cours…',start:20};\n    return null;\n  }\n\n  function installApiWrapper(){\n    if(typeof window.cdqApiRun!=='function'||window.cdqApiRun.__cdqV2250)return false;\n    originalApiRun=window.cdqApiRun;\n    function wrappedApiRun(){\n      let success=null,failure=null,userObject=null,hasUserObject=false,proxy=null;\n      const chain={\n        withSuccessHandler:function(fn){success=fn;return proxy;},\n        withFailureHandler:function(fn){failure=fn;return proxy;},\n        withUserObject:function(obj){userObject=obj;hasUserObject=true;return proxy;}\n      };\n      proxy=new Proxy(chain,{\n        get:function(target,prop){\n          if(prop in target)return target[prop];\n          if(typeof prop!=='string')return undefined;\n          return function(){\n            const args=Array.prototype.slice.call(arguments);\n            const meta=inferredMeta(prop);\n            const existing=active();\n            let token=0,owned=false;\n            if(meta){\n              if(existing&&existing.lock&&existing.state==='working'){\n                token=existing.token;\n                update(token,Math.max(existing.value||0,meta.start||15),existing.label,meta.detail);\n              }else{\n                token=start(meta.label,meta.detail,{start:meta.start||10,delay:220,cap:92});\n                owned=true;\n              }\n            }\n            let runner=originalApiRun();\n            const ok=function(){\n              if(token){\n                if(owned)finish(token,'Terminé');\n                else update(token,Math.min(94,(active()&&active().value||70)+12),null,'Étape terminée…');\n              }\n              if(typeof success==='function')return success.apply(this,arguments);\n            };\n            const ko=function(err){\n              if(token)fail(token,err&&err.message?err.message:String(err||'Erreur'));\n              if(typeof failure==='function')return failure.apply(this,arguments);\n            };\n            if(meta)runner=runner.withSuccessHandler(ok).withFailureHandler(ko);\n            else{\n              if(typeof success==='function')runner=runner.withSuccessHandler(success);\n              if(typeof failure==='function')runner=runner.withFailureHandler(failure);\n            }\n            if(hasUserObject)runner=runner.withUserObject(userObject);\n            const fn=runner[prop];\n            if(typeof fn!=='function')throw new Error('Fonction serveur absente : '+prop);\n            return fn.apply(runner,args);\n          };\n        }\n      });\n      return proxy;\n    }\n    wrappedApiRun.__cdqV2250=true;\n    wrappedApiRun.__original=originalApiRun;\n    window.cdqApiRun=wrappedApiRun;\n    try{cdqApiRun=wrappedApiRun}catch(e){}\n    return true;\n  }\n\n  function installCopyWrapper(){\n    if(typeof window.confirmerCopie!=='function'||window.confirmerCopie.__cdqV2250)return false;\n    const original=window.confirmerCopie;\n    const wrapped=async function(){\n      const model=(document.getElementById('copyTemplateName')||{}).textContent||'PDF';\n      const token=start('Copie du PDF',String(model).replace(/[«»]/g,'').trim()||'Préparation du rapport…',{start:5,delay:100,cap:96,lock:true});\n      update(token,8,'Copie du PDF','Préparation du modèle…');\n      try{\n        const result=await original.apply(this,arguments);\n        const status=document.getElementById('copyModalStatus');\n        if(status&&status.classList.contains('error')){\n          fail(token,status.textContent||'La copie a échoué.');\n        }else{\n          finish(token,'PDF copié');\n        }\n        return result;\n      }catch(e){\n        fail(token,e&&e.message?e.message:String(e||'Erreur'));\n        throw e;\n      }\n    };\n    wrapped.__cdqV2250=true;\n    window.confirmerCopie=wrapped;\n    try{confirmerCopie=wrapped}catch(e){}\n    return true;\n  }\n\n  function installLoadWrapper(){\n    if(typeof window.chargerFichiers!=='function'||window.chargerFichiers.__cdqV2250)return false;\n    const original=window.chargerFichiers;\n    const wrapped=function(){\n      const token=start('Chargement des fichiers','Lecture du dossier client…',{start:8,delay:260,cap:90,lock:true});\n      const container=document.getElementById('filesContainer');\n      let done=false,observer=null;\n      const complete=function(){\n        if(done)return;done=true;\n        if(observer)observer.disconnect();\n        finish(token,'Chargement terminé');\n      };\n      if(container&&window.MutationObserver){\n        observer=new MutationObserver(function(){\n          if(container.querySelector('.file-row,.folder-header,.folder-content,.cdq-desktop-folder-row')||String(container.textContent||'').trim())setTimeout(complete,120);\n        });\n        observer.observe(container,{childList:true,subtree:true});\n      }\n      try{\n        const r=original.apply(this,arguments);\n        setTimeout(complete,12000);\n        return r;\n      }catch(e){\n        if(observer)observer.disconnect();fail(token,e&&e.message?e.message:String(e||'Erreur'));throw e;\n      }\n    };\n    wrapped.__cdqV2250=true;\n    window.chargerFichiers=wrapped;\n    try{chargerFichiers=wrapped}catch(e){}\n    return true;\n  }\n\n  function stampVersion(){\n    const root=document.getElementById('cdqPcV16');\n    if(root){\n      root.dataset.build='v22.50-global-progress';\n      const meta=root.querySelector('.pc16-side-meta span:last-child');\n      if(meta)meta.textContent='V22.50';\n    }\n  }\n\n  function installAll(){\n    ensure();installApiWrapper();installCopyWrapper();installLoadWrapper();stampVersion();\n  }\n\n  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(installAll,0)},{once:true});\n  else setTimeout(installAll,0);\n\n  let tries=0;\n  const retry=setInterval(function(){\n    tries++;installAll();\n    if(tries>30)clearInterval(retry);\n  },300);\n})();\n</script>\n"
    }
