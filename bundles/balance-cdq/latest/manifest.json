    {
      "file": "Selector.html",
      "op": "remove_style_id_if_present",
      "id": "cdqV2404PdfSystemCss"
    },
    {
      "file": "Selector.html",
      "op": "insert_before_literal",
      "before": "</body>",
      "text": "\n<style id=\"cdqV2404PdfSystemCss\">\nhtml:is(.android,.mobile-device) .cdq-display-group [data-pdf-reader]{\n  display:none!important;\n}\n</style>\n<script id=\"cdqV2404PdfSystemJs\">\n(function(){\n'use strict';\n\nfunction metaForIdV2404(id){\n  try{\n    if(typeof cdqDocumentMeta==='function'){\n      const m=cdqDocumentMeta(id);\n      if(m)return m;\n    }\n  }catch(_){}\n  const box=document.querySelector('.file-checkbox[data-file-id=\"'+String(id||'').replace(/[^A-Za-z0-9_-]/g,'')+'\"]');\n  const row=box&&box.closest('.file-row');\n  return row?{id:String(id),nom:String(row.dataset.fileName||''),type:String(row.dataset.fileType||''),dateModification:String(row.dataset.fileDate||'')}:null;\n}\n\nfunction markOpenedV2404(id){\n  try{\n    if(String(utilisateurCourantRole||'')==='lecture')return;\n    fichierOuvertPourModification=String(id||'');\n    const meta=metaForIdV2404(id)||{};\n    sessionStorage.setItem('fichierEnModification',String(id||''));\n    sessionStorage.setItem('ancienneDateModification',String(meta.dateModification||''));\n    sessionStorage.setItem('momentModification',String(Date.now()));\n  }catch(_){}\n}\n\nfunction pdfNativeIntentV2404(id,name){\n  const fallback='https://drive.google.com/file/d/'+encodeURIComponent(String(id||''))+'/view?usp=drivesdk';\n  return 'intent://open?fileId='+encodeURIComponent(String(id||''))+\n    '&name='+encodeURIComponent(String(name||'Rapport.pdf'))+\n    '#Intent;scheme=cdqpdf;package=ca.balancecdq.android;'+\n    'S.browser_fallback_url='+encodeURIComponent(fallback)+';end';\n}\n\nfunction openPdfNativeV2404(id){\n  id=String(id||'');\n  if(!/^[A-Za-z0-9_-]{10,200}$/.test(id))return false;\n\n  const meta=metaForIdV2404(id)||{};\n  markOpenedV2404(id);\n\n  // Aucun écran Balance CDQ, aucun téléchargement dans le Selector.\n  // La couche Android affiche directement son résolveur PDF système.\n  window.location.href=pdfNativeIntentV2404(id,String(meta.nom||'Rapport.pdf'));\n  return true;\n}\n\nfunction resetPdfDefaultV2404(){\n  const fallback='https://jprodrigue86.github.io/Rapports--talonnages-CDQ/';\n  const intent='intent://reset#Intent;scheme=cdqpdf;package=ca.balancecdq.android;'+\n    'S.browser_fallback_url='+encodeURIComponent(fallback)+';end';\n  window.location.href=intent;\n}\n\nfunction patchPdfSettingsV2404(){\n  const modal=document.getElementById('cdqDisplayModal');\n  if(!modal)return;\n\n  const groups=Array.from(modal.querySelectorAll('.cdq-display-group'));\n  const group=groups.find(function(g){\n    const label=g.querySelector('.cdq-display-label');\n    return label&&/Lecteur PDF par défaut/i.test(label.textContent||'');\n  });\n  if(!group||group.dataset.cdqV2404==='1')return;\n\n  group.dataset.cdqV2404='1';\n  group.innerHTML=\n    '<div class=\"cdq-display-label\">Lecteur PDF Android</div>'+\n    '<div class=\"cdq-v20-note\" style=\"margin-bottom:10px\">'+\n      'Balance CDQ ouvre directement le sélecteur Android. Choisissez « Une seule fois » ou « Toujours ». '+\n      'Si « Toujours » est choisi, les prochains PDF s’ouvriront directement dans cette application.'+\n    '</div>'+\n    '<button type=\"button\" id=\"cdqResetPdfDefaultV2404\" class=\"cdq-ui-scale-reset\">'+\n      'Réinitialiser l’application PDF par défaut'+\n    '</button>';\n\n  const b=group.querySelector('#cdqResetPdfDefaultV2404');\n  if(b)b.onclick=resetPdfDefaultV2404;\n}\n\nfunction installV2404(){\n  // Neutraliser les anciens chemins PDF sur Android.\n  try{window.cdqV24OpenPdf=openPdfNativeV2404;}catch(_){}\n  try{window.cdqOuvrirPdfCommeSheetV2275=openPdfNativeV2404;cdqOuvrirPdfCommeSheetV2275=openPdfNativeV2404;}catch(_){}\n  try{window.cdqOpenPdf=openPdfNativeV2404;cdqOpenPdf=openPdfNativeV2404;}catch(_){}\n  try{\n    window.cdqPdfReaderPreference=function(){return 'ask';};\n    cdqPdfReaderPreference=window.cdqPdfReaderPreference;\n  }catch(_){}\n\n  if(typeof window.modifierFichier==='function'&&!window.__cdqV2404ModifierInstalled){\n    const old=window.modifierFichier;\n    window.__cdqV2404ModifierInstalled=true;\n    const wrapped=function(id){\n      const meta=metaForIdV2404(id);\n      if(/Android/i.test(navigator.userAgent||'')&&meta&&String(meta.type||'').toUpperCase()==='PDF'){\n        return openPdfNativeV2404(id);\n      }\n      return old.apply(this,arguments);\n    };\n    window.modifierFichier=wrapped;\n    try{modifierFichier=wrapped;}catch(_){}\n  }\n\n  patchPdfSettingsV2404();\n}\n\n// Capture AVANT le gestionnaire click de la ligne fichier.\n// Cela empêche les anciens modals/lecteurs PDF de se déclencher derrière.\ndocument.addEventListener('click',function(e){\n  if(!/Android/i.test(navigator.userAgent||''))return;\n  if(e.target&&e.target.closest&&e.target.closest('button'))return;\n\n  const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;\n  if(!row)return;\n  if(document.body.classList.contains('selection-active'))return;\n  try{if(typeof modeSelectionFichiers!=='undefined'&&modeSelectionFichiers)return;}catch(_){}\n  if(row.classList.contains('cdq-swiped-left')||row.classList.contains('cdq-swiped-right'))return;\n\n  const type=String(row.dataset.fileType||'').toUpperCase();\n  if(type!=='PDF')return;\n\n  const box=row.querySelector('.file-checkbox[data-file-id]');\n  if(!box)return;\n\n  e.preventDefault();\n  e.stopImmediatePropagation();\n  openPdfNativeV2404(String(box.dataset.fileId||''));\n},true);\n\ndocument.addEventListener('click',function(e){\n  if(e.target&&e.target.closest&&e.target.closest('#cdqTopDisplayButtonV2204,#displayModeButton')){\n    setTimeout(patchPdfSettingsV2404,30);\n    setTimeout(patchPdfSettingsV2404,180);\n  }\n},true);\n\nif(document.readyState==='loading'){\n  document.addEventListener('DOMContentLoaded',function(){installV2404();setTimeout(installV2404,500);},{once:true});\n}else{\n  installV2404();\n  setTimeout(installV2404,500);\n}\n\ntry{\n  new MutationObserver(function(){\n    clearTimeout(window.__cdqV2404SettingsTimer);\n    window.__cdqV2404SettingsTimer=setTimeout(patchPdfSettingsV2404,60);\n  }).observe(document.body,{childList:true,subtree:true});\n}catch(_){}\n\nwindow.cdqV2404OpenPdf=openPdfNativeV2404;\nwindow.cdqV2404ResetPdfDefault=resetPdfDefaultV2404;\n})();\n</script>\n"
    }
  ],
  "audit": {
    "scriptManagerRequired": "V39",
    "androidAppRequired": "Balance CDQ Android 24.04",
    "pdf": [
      "Un clic PDF Android ne montre plus aucun modal Balance CDQ.",
      "Le lecteur CDQ intégré est retiré du chemin Android.",
      "Aucun téléchargement navigateur ni assemblage Apps Script avant le choix.",
      "La couche Android expose le PDF par content:// et le streame depuis Drive.",
      "Android reçoit un ACTION_VIEW implicite direct, sans Intent.createChooser.",
      "Sans lecteur par défaut, Android affiche directement l'écran Ouvrir avec / Une seule fois / Toujours.",
      "Avec Toujours déjà choisi, le PDF s'ouvre directement dans cette application.",
      "Réglages Balance CDQ ajoute un bouton pour ouvrir les réglages Android des applications par défaut."
    ]
  }
