      "text": "\n\n<style id=\"cdqV2298StableFileSelectionCss\">\n/* V22.98 — sélection stable, aucun flash/scintillement Android */\nhtml:is(.android,.ios,.mobile-device) .file-row,\nhtml:is(.android,.ios,.mobile-device) .file-row *,\nhtml:is(.android,.ios,.mobile-device) #filesContainer,\nhtml:is(.android,.ios,.mobile-device) .selection-bar,\nhtml:is(.android,.ios,.mobile-device) .bottom-nav,\nhtml:is(.android,.ios,.mobile-device) .client-info-bar{\n  -webkit-tap-highlight-color:transparent!important;\n}\nhtml:is(.android,.ios,.mobile-device) .file-row,\nhtml:is(.android,.ios,.mobile-device) .file-row.selected,\nhtml:is(.android,.ios,.mobile-device) .file-row:active{\n  transition:none!important;\n  animation:none!important;\n  filter:none!important;\n}\nhtml.cdq-selection-stable-v2298 .file-row,\nhtml.cdq-selection-stable-v2298 .file-row *,\nhtml.cdq-selection-stable-v2298 .selection-bar,\nhtml.cdq-selection-stable-v2298 .bottom-nav,\nhtml.cdq-selection-stable-v2298 #filesContainer{\n  transition:none!important;\n  animation:none!important;\n}\nhtml:is(.android,.ios,.mobile-device) .file-row:focus,\nhtml:is(.android,.ios,.mobile-device) .file-row:focus-visible{\n  outline:none!important;\n}\n</style>\n<script id=\"cdqV2298DefaultAccountAndSelectionFix\">\n(function(){\n'use strict';\n\nconst ACCOUNT_KEY='cdqDefaultGoogleAccountV2298';\nconst LEGACY_KEY='cdqDefaultGoogleAccountV2294';\nconst RESET_KEY='cdqDefaultGoogleAccountResetV2298';\n\nfunction norm(v){return String(v||'').trim().toLowerCase();}\nfunction currentEmail(){\n  try{return norm(utilisateurCourantEmail||'');}catch(_){return '';}\n}\nfunction isReset(){\n  try{return localStorage.getItem(RESET_KEY)==='1';}catch(_){return false;}\n}\nfunction savedEmail(){\n  try{\n    return norm(localStorage.getItem(ACCOUNT_KEY)||localStorage.getItem(LEGACY_KEY)||'');\n  }catch(_){return '';}\n}\nfunction defaultEmail(){\n  if(isReset())return '';\n  return savedEmail()||currentEmail();\n}\nfunction saveDefault(email){\n  email=norm(email);\n  if(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))throw new Error('Adresse Google invalide.');\n  try{\n    localStorage.setItem(ACCOUNT_KEY,email);\n    localStorage.setItem(LEGACY_KEY,email);\n    localStorage.removeItem(RESET_KEY);\n  }catch(_){}\n  try{\n    if(typeof cdqPostToPwa==='function')cdqPostToPwa({type:'CDQ_DEFAULT_GOOGLE_ACCOUNT_SET',email:email,reset:false});\n  }catch(_){}\n  refreshSettings();\n  return email;\n}\nfunction resetDefault(){\n  try{\n    localStorage.removeItem(ACCOUNT_KEY);\n    localStorage.removeItem(LEGACY_KEY);\n    localStorage.setItem(RESET_KEY,'1');\n  }catch(_){}\n  try{\n    if(typeof cdqPostToPwa==='function')cdqPostToPwa({type:'CDQ_DEFAULT_GOOGLE_ACCOUNT_SET',email:'',reset:true});\n  }catch(_){}\n  refreshSettings();\n}\nfunction markFile(id){\n  try{\n    if(String(utilisateurCourantRole||'')==='lecture')return;\n    fichierOuvertPourModification=id;\n    const meta=typeof cdqDocumentMeta==='function'?(cdqDocumentMeta(id)||{}):{};\n    sessionStorage.setItem('fichierEnModification',String(id||''));\n    sessionStorage.setItem('ancienneDateModification',String(meta.dateModification||''));\n    sessionStorage.setItem('momentModification',String(Date.now()));\n  }catch(_){}\n}\nfunction chromeSheetIntent(id,email){\n  const web='https://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit?authuser='+encodeURIComponent(email)+'&usp=drivesdk';\n  return 'intent://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit?authuser='+encodeURIComponent(email)+'&usp=drivesdk'+\n    '#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url='+encodeURIComponent(web)+';end';\n}\nfunction openSheetDefault(id){\n  const email=defaultEmail();\n  if(!email)return false;\n  markFile(id);\n\n  // Le parent PWA ouvre explicitement Chrome. On évite ainsi l'application\n  // Sheets native qui affiche le sélecteur \"Sélectionner un compte\".\n  try{\n    if(typeof cdqPostToPwa==='function' && cdqPostToPwa({\n      type:'CDQ_OPEN_SHEET_DEFAULT_ACCOUNT',\n      id:String(id||''),\n      email:email\n    }))return true;\n  }catch(_){}\n\n  const web='https://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit?authuser='+encodeURIComponent(email)+'&usp=drivesdk';\n  if(/Android/i.test(navigator.userAgent||'')){\n    window.location.href=chromeSheetIntent(id,email);\n  }else{\n    const a=document.createElement('a');a.href=web;a.target='_blank';a.rel='noopener';\n    document.body.appendChild(a);a.click();a.remove();\n  }\n  return true;\n}\nasync function openPdfDefault(id){\n  const email=defaultEmail();\n  if(!email)return false;\n  markFile(id);\n\n  // Aucun Drive/Sheets natif : le PDF passe directement par le lecteur CDQ.\n  if(typeof cdqLoadPdfRecord==='function' && typeof cdqOpenPdfInternal==='function'){\n    const rec=await cdqLoadPdfRecord(id);\n    await cdqOpenPdfInternal(id,rec);\n    return true;\n  }\n  if(typeof cdqOpenPdf==='function'){\n    try{\n      if(typeof cdqSetPdfReaderPreference==='function')cdqSetPdfReaderPreference('cdq');\n    }catch(_){}\n    await cdqOpenPdf(id);\n    return true;\n  }\n  throw new Error('Lecteur PDF CDQ indisponible.');\n}\nfunction metaFor(row,id){\n  try{\n    if(typeof cdqDocumentMeta==='function'){\n      const m=cdqDocumentMeta(id);\n      if(m)return m;\n    }\n  }catch(_){}\n  return {\n    id:id,\n    nom:String(row&&row.dataset.fileName||''),\n    type:String(row&&row.dataset.fileType||'')\n  };\n}\nfunction inSelectionMode(){\n  try{\n    if(typeof modeSelectionFichiers!=='undefined'&&modeSelectionFichiers)return true;\n  }catch(_){}\n  return document.body.classList.contains('selection-active');\n}\n\n// Remplacer les fonctions de base, pas seulement modifierFichier.\nconst oldSheetApp=typeof cdqSheetAppUrl==='function'?cdqSheetAppUrl:null;\ncdqSheetAppUrl=function(id){\n  const e=defaultEmail();\n  if(e)return /Android/i.test(navigator.userAgent||'')\n    ? chromeSheetIntent(id,e)\n    : 'https://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit?authuser='+encodeURIComponent(e)+'&usp=drivesdk';\n  return oldSheetApp?oldSheetApp(id):('https://docs.google.com/spreadsheets/d/'+encodeURIComponent(id)+'/edit');\n};\nwindow.cdqSheetAppUrl=cdqSheetAppUrl;\n\nconst oldOfflineSheet=typeof cdqV19OpenOfflineSheet==='function'?cdqV19OpenOfflineSheet:null;\ncdqV19OpenOfflineSheet=function(id){\n  if(defaultEmail())return openSheetDefault(id);\n  return oldOfflineSheet?oldOfflineSheet(id):false;\n};\nwindow.cdqV19OpenOfflineSheet=cdqV19OpenOfflineSheet;\n\nfunction installModifier(){\n  if(window.__cdqV2298ModifierInstalled||typeof window.modifierFichier!=='function')return;\n  const old=window.modifierFichier;\n  window.__cdqV2298ModifierInstalled=true;\n  window.modifierFichier=function(id){\n    const e=defaultEmail();\n    if(!e)return old.apply(this,arguments);\n    let m=null;try{m=typeof cdqDocumentMeta==='function'?cdqDocumentMeta(id):null;}catch(_){}\n    const t=String(m&&m.type||'').toUpperCase();\n    if(t==='GOOGLE_SHEETS')return openSheetDefault(id);\n    if(t==='PDF')return Promise.resolve(openPdfDefault(id)).catch(function(err){\n      if(typeof afficherErreur==='function')afficherErreur(err);\n    });\n    return old.apply(this,arguments);\n  };\n}\n\n// Interception avant le vieux gestionnaire de clic Android.\ndocument.addEventListener('click',function(e){\n  const account=defaultEmail();\n  if(!account||inSelectionMode())return;\n  const row=e.target&&e.target.closest?e.target.closest('.file-row'):null;\n  if(!row||e.target.closest('button'))return;\n  if(String(row.dataset.cdqSuppressClick||'')==='1')return;\n  const box=row.querySelector('.file-checkbox[data-file-id]');\n  if(!box)return;\n  const id=String(box.dataset.fileId||'');\n  if(!id)return;\n  const m=metaFor(row,id),t=String(m&&m.type||'').toUpperCase();\n  if(t!=='GOOGLE_SHEETS'&&t!=='PDF')return;\n\n  e.preventDefault();\n  e.stopImmediatePropagation();\n\n  if(t==='GOOGLE_SHEETS'){\n    if(typeof afficherMessage==='function')afficherMessage('Ouverture avec '+account+'…',false);\n    openSheetDefault(id);\n  }else{\n    Promise.resolve(openPdfDefault(id)).catch(function(err){\n      if(typeof afficherErreur==='function')afficherErreur(err);\n    });\n  }\n},true);\n\n// Stabiliser les changements de sélection : pas d'auto-fit ni de transition pendant le clic.\nfunction stabilizeSelection(){\n  try{window.__cdqAutoFitSuppressedUntilV2217=Date.now()+1400;}catch(_){}\n  document.documentElement.classList.add('cdq-selection-stable-v2298');\n  clearTimeout(window.__cdqSelectionStableTimerV2298);\n  window.__cdqSelectionStableTimerV2298=setTimeout(function(){\n    document.documentElement.classList.remove('cdq-selection-stable-v2298');\n  },260);\n}\ndocument.addEventListener('pointerdown',function(e){\n  if(e.target&&e.target.closest&&e.target.closest('.file-row'))stabilizeSelection();\n},true);\n\nif(typeof mettreAJourInterface==='function'&&!window.__cdqV2298UiWrapped){\n  const oldUi=mettreAJourInterface;\n  window.__cdqV2298UiWrapped=true;\n  mettreAJourInterface=function(){\n    stabilizeSelection();\n    const sx=window.scrollX,sy=window.scrollY;\n    const r=oldUi.apply(this,arguments);\n    requestAnimationFrame(function(){\n      try{window.scrollTo(sx,sy);}catch(_){}\n    });\n    return r;\n  };\n  window.mettreAJourInterface=mettreAJourInterface;\n}\n\nfunction refreshSettings(){\n  const modal=document.getElementById('cdqSettingsModalV2294');\n  if(!modal)return;\n  const e=defaultEmail();\n  const status=modal.querySelector('#cdqDefaultGoogleStatusV2294');\n  const input=modal.querySelector('#cdqDefaultGoogleEmailV2294');\n  if(status){\n    status.innerHTML=e\n      ? 'Compte par défaut actif : <strong>'+String(e).replace(/[&<>\"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]);})+'</strong><br><small>Sheets s’ouvre dans Chrome et PDF dans le lecteur CDQ, sans sélecteur Android.</small>'\n      : 'Compte par défaut : <strong>Aucun</strong><br><small>Google demandera de nouveau le compte à chaque ouverture.</small>';\n  }\n  if(input&&!input.matches(':focus'))input.value=e||currentEmail()||'';\n\n  const save=modal.querySelector('#cdqSaveGoogleDefaultV2294');\n  if(save&&save.dataset.cdqV2298!=='1'){\n    save.dataset.cdqV2298='1';\n    save.addEventListener('click',function(ev){\n      ev.preventDefault();ev.stopImmediatePropagation();\n      try{\n        const v=norm(input&&input.value||'');\n        saveDefault(v);\n        if(typeof afficherMessage==='function')afficherMessage('Compte Google par défaut : '+v,true);\n      }catch(err){if(typeof afficherErreur==='function')afficherErreur(err);}\n    },true);\n  }\n  const reset=modal.querySelector('#cdqResetGoogleDefaultV2294');\n  if(reset&&reset.dataset.cdqV2298!=='1'){\n    reset.dataset.cdqV2298='1';\n    reset.addEventListener('click',function(ev){\n      ev.preventDefault();ev.stopImmediatePropagation();\n      resetDefault();\n      if(typeof afficherMessage==='function')afficherMessage('Compte par défaut réinitialisé.',true);\n    },true);\n  }\n  const current=modal.querySelector('#cdqCurrentGoogleRowV2294');\n  if(current&&current.dataset.cdqV2298!=='1'){\n    current.dataset.cdqV2298='1';\n    current.addEventListener('click',function(ev){\n      const b=ev.target&&ev.target.closest?ev.target.closest('button'):null;\n      if(!b)return;\n      ev.preventDefault();ev.stopImmediatePropagation();\n      const v=currentEmail();\n      if(v){\n        saveDefault(v);\n        if(typeof afficherMessage==='function')afficherMessage('Compte Google par défaut : '+v,true);\n      }\n    },true);\n  }\n}\n\nfunction boot(){\n  // Sans choix explicite et sans reset, le compte CDQ actif devient le défaut.\n  if(!isReset()&&!savedEmail()&&currentEmail()){\n    try{saveDefault(currentEmail());}catch(_){}\n  }\n  installModifier();\n  refreshSettings();\n}\nif(document.readyState==='loading'){\n  document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,80);setTimeout(boot,700);},{once:true});\n}else{setTimeout(boot,20);setTimeout(boot,600);}\nwindow.addEventListener('load',function(){setTimeout(boot,120);setTimeout(boot,1000);});\nwindow.addEventListener('cdq:access-ready',function(){setTimeout(boot,80);});\ntry{\n  new MutationObserver(function(){\n    clearTimeout(window.__cdqV2298Mutation);\n    window.__cdqV2298Mutation=setTimeout(function(){installModifier();refreshSettings();},120);\n  }).observe(document.body,{childList:true,subtree:true});\n}catch(_){}\n\nwindow.cdqDefaultGoogleAccountV2298=defaultEmail;\nwindow.cdqResetDefaultGoogleAccountV2298=resetDefault;\n})();\n</script>\n\n"
    }
  ],
