2%3ELORNA%20SHORE%3C%2Ftext%3E%0A%3C%2Fg%3E%0A%3Cg%20stroke%3D%22%237e1620%22%20stroke-width%3D%223%22%20opacity%3D%22.45%22%3E%0A%20%3Cpath%20d%3D%22M0%20520L260%20440M240%201080L650%20750M1920%20400L1640%20520M1580%201080L1230%20770%22%2F%3E%0A%20%3Ccircle%20cx%3D%22960%22%20cy%3D%22540%22%20r%3D%22105%22%2F%3E%3Ccircle%20cx%3D%22960%22%20cy%3D%22540%22%20r%3D%2262%22%2F%3E%0A%3C%2Fg%3E%0A%3Cg%20fill%3D%22%23b21f2d%22%20opacity%3D%22.75%22%3E%0A%20%3Ccircle%20cx%3D%22960%22%20cy%3D%22540%22%20r%3D%229%22%2F%3E%3Crect%20x%3D%22920%22%20y%3D%221010%22%20width%3D%2280%22%20height%3D%224%22%2F%3E%3Crect%20x%3D%22120%22%20y%3D%221010%22%20width%3D%22160%22%20height%3D%224%22%2F%3E%3Crect%20x%3D%221640%22%20y%3D%221010%22%20width%3D%22160%22%20height%3D%224%22%2F%3E%0A%3C%2Fg%3E%0A%3C%2Fsvg%3E\")!important;\n  background-position:center center,center center!important;\n  background-size:cover,cover!important;\n  background-repeat:no-repeat,no-repeat!important;\n  background-attachment:fixed,fixed!important;\n}\n\n/* Le shell PC doit toujours rester entièrement visible. */\nhtml.windows #cdqPcV16{overflow:hidden!important;background:#020911!important}\nhtml.windows #cdqPcV16 .pc16-stage{will-change:transform!important}\n\n/* Plus de colonne droite redondante. */\nhtml.windows #cdqPcV16 .pc16-body{\n  grid-template-columns:182px minmax(0,1fr)!important;\n  gap:8px!important;\n}\nhtml.windows #cdqPcV16 .pc16-center{\n  padding:16px 8px 8px 0!important;\n  min-width:0!important;\n}\nhtml.windows #cdqPcV16 .pc16-rail{display:none!important}\n\n/* 5 indicateurs utiles en haut. */\nhtml.windows #cdqPcV16 .pc16-kpis{\n  grid-template-columns:repeat(5,minmax(0,1fr))!important;\n  gap:9px!important;\n}\nhtml.windows #cdqPcV16 .pc16-kpi{\n  grid-template-columns:48px minmax(0,1fr)!important;\n  padding:8px 9px!important;\n  cursor:pointer!important;\n}\nhtml.windows #cdqPcV16 .pc16-kpi.cyan{--c:#20c8e8}\nhtml.windows #cdqPcV16 .pc16-kpi .ico{font-size:30px!important}\nhtml.windows #cdqPcV16 .pc16-kpi .lab{font-size:11.5px!important;white-space:normal!important;line-height:1.1!important}\nhtml.windows #cdqPcV16 .pc16-kpi strong{font-size:24px!important}\nhtml.windows #cdqPcV16 .pc16-kpi em{\n  font-size:8.8px!important;\n  white-space:nowrap!important;\n  overflow:hidden!important;\n  text-overflow:ellipsis!important;\n}\n\n/* Raccourcis propres, sans texte qui déborde. */\nhtml.windows #cdqPcV16 .pc16-shortcuts{\n  position:static!important;\n  border-top:1px solid #284757!important;\n  padding-top:9px!important;\n  display:grid!important;\n  gap:6px!important;\n  margin-top:8px!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts h4{\n  margin:0 0 3px!important;\n  font-size:11px!important;\n  font-weight:900!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts button{\n  height:auto!important;\n  min-height:48px!important;\n  border:1px solid #155f99!important;\n  border-radius:7px!important;\n  background:linear-gradient(180deg,#09243a,#071c2d)!important;\n  color:#dfeaf0!important;\n  padding:8px 9px!important;\n  display:grid!important;\n  grid-template-columns:28px minmax(0,1fr)!important;\n  gap:8px!important;\n  align-items:center!important;\n  text-align:left!important;\n  overflow:hidden!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts button:hover{\n  background:linear-gradient(180deg,#0d4b73,#082b43)!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts .qi{\n  display:grid!important;place-items:center!important;\n  width:28px!important;height:28px!important;border-radius:50%!important;\n  background:#0b5f9e!important;color:#fff!important;font-size:15px!important;\n  box-shadow:0 0 12px rgba(18,160,255,.22)!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts .qt{\n  display:grid!important;min-width:0!important;gap:2px!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts .qt b{\n  font-size:10.5px!important;line-height:1.15!important;color:#f5fbff!important;\n}\nhtml.windows #cdqPcV16 .pc16-shortcuts .qt small{\n  font-size:8.4px!important;line-height:1.2!important;color:#8fb4c8!important;\n  white-space:normal!important;overflow-wrap:anywhere!important;\n}\n\n/* Modales devant le shell PC : Affichage, Utilisateurs, Inventaire, partage. */\nhtml.windows .modal-overlay,\nhtml.windows #adminModalOverlay,\nhtml.windows #cdqDisplayModal,\nhtml.windows #cdqShareAppModal{\n  z-index:420000!important;\n}\n\n/* La zone centrale ne doit jamais pousser vers la droite. */\nhtml.windows #cdqPcV16 .pc16-main-head{\n  grid-template-columns:40px minmax(0,1fr) minmax(0,auto)!important;\n}\nhtml.windows #cdqPcV16 .pc16-main-copy{min-width:0!important}\nhtml.windows #cdqPcV16 .pc16-main-copy h2{\n  white-space:normal!important;overflow-wrap:anywhere!important;\n}\nhtml.windows #cdqPcV16 .pc16-main-tools{\n  display:flex!important;flex-wrap:wrap!important;justify-content:flex-end!important;\n  max-width:100%!important;gap:8px!important;min-width:0!important;\n}\nhtml.windows #cdqPcV16 .pc16-main-tools input{width:min(280px,100%)!important;max-width:100%!important}\n</style>\n\n<script id=\"cdqPcV2226DirectJs\">\n(function(){\n\"use strict\";\nif(!document.documentElement.classList.contains(\"windows\"))return;\n\nconst BASE_W=1536,BASE_H=864;\nlet fixing=false,lastFit=\"\";\n\nfunction viewport(){\n  const vv=window.visualViewport||null;\n  const de=document.documentElement;\n  let w=Number(vv&&vv.width)||Number(window.innerWidth)||Number(de&&de.clientWidth)||BASE_W;\n  let h=Number(vv&&vv.height)||Number(window.innerHeight)||Number(de&&de.clientHeight)||BASE_H;\n  if(de&&de.clientWidth>0)w=Math.min(w,de.clientWidth);\n  if(de&&de.clientHeight>0)h=Math.min(h,de.clientHeight);\n  return {w:Math.max(320,Math.round(w)),h:Math.max(240,Math.round(h))};\n}\nfunction fitStage(){\n  if(fixing)return;\n  const root=document.getElementById(\"cdqPcV16\");\n  const stage=root&&root.querySelector(\".pc16-stage\");\n  if(!root||!stage)return;\n  const v=viewport(),pad=6;\n  const s=Math.max(.10,Math.min(5,Math.min