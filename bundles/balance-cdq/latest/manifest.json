  "version": "V24.04",
  "build": "2026.09.21-v24.04-direct-system-pdf-resolver",
  "title": "Balance CDQ V24.04 — PDF directement dans le sélecteur Android",
  "requiresBuild": [
    "2026.09.21-v24.02-instant-native-pdf-choice"
  ],
  "patches": [
    {
      "file": "Selector.html",
      "op": "replace_build",
      "from": "2026.09.21-v24.02-instant-native-pdf-choice",
      "to": "2026.09.21-v24.04-direct-system-pdf-resolver"
    },
    {
      "file": "Code.gs",
      "op": "replace_build",
      "from": "2026.09.21-v24.02-instant-native-pdf-choice",
      "to": "2026.09.21-v24.04-direct-system-pdf-resolver"
    },
    {
      "file": "Selector.html",
      "op": "remove_script_id_if_present",
      "id": "cdqV2402FileOpenJs"
    },
    {
      "file": "Selector.html",
      "op": "remove_style_id_if_present",
      "id": "cdqV2402FileOpenCss"
    },
    {
      "file": "Selector.html",
      "op": "remove_script_id_if_present",
      "id": "cdqV2404PdfSystemJs"
