      "before": "</body>",
      "text": "\n\n<style id=\"cdqV2408PdfReaderCss\">\n#cdqV2408PdfOverlay{position:fixed!important;inset:0!important;z-index:2147483600!important;display:grid!important;place-items:center!important;padding:18px!important;background:rgba(2,8,13,.90)!important;box-sizing:border-box!important}\n#cdqV2408PdfOverlay .cdq-v2408-card{width:min(520px,100%)!important;box-sizing:border-box!important;padding:20px!important;border:1px solid #178fc8!important;border-radius:16px!important;background:#081923!important;color:#eefaff!important;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif!important}\n#cdqV2408PdfOverlay .cdq-v2408-title{margin:0 0 10px!important;font-size:19px!important;font-weight:900!important}\n#cdqV2408PdfOverlay .cdq-v2408-text{margin:0 0 12px!important;font-size:14px!important;font-weight:800!important}\n#cdqV2408PdfOverlay .cdq-v2408-track{height:11px!important;overflow:hidden!important;border-radius:999px!important;background:#07131c!important;border:1px solid #31566d!important}\n#cdqV2408PdfBar{width:0;height:100%!important;border-radius:999px!important;background:#25b8f3!important;transition:width .12s linear!important}\n#cdqV2408PdfDetail{margin-top:10px!important;font-size:12px!important;color:#a9c4d1!important;word-break:break-word!important}\n#cdqV2408PdfClose{width:100%!important;min-height:46px!important;margin-top:14px!important;border:1px solid #2baee5!important;border-radius:10px!important;background:#0d3850!important;color:#fff!important;font-weight:900!important}\n#cdqV2408PdfOverlay.error .cdq-v2408-card{border-color:#d6535f!important}\n</style>\n\n<script id=\"cdqV2408PdfScriptReaderJs\">\n(function(){\n'use strict';\n\nif(!/Android/i.test(navigator.userAgent||''))return;\n\nconst GH_ORIGIN='https://jprodrigue86.github.io';\nconst READER_URL=GH_ORIGIN+'/Rapports--talonnages-CDQ/reader.html?cdq=1&v=24.08';\nlet tap=null;\nlet busy=false;\nlet blockClickUntil=0;\nlet openedClickUntil=0;\n\nfunction rpc(name,args,timeoutMs){\n  args=Array.isArray(args)?args:[];\n  let p;\n  try{\n    if(typeof window.cdqAppelServeur==='function')p=window.cdqAppelServeur(name,args);\n    else if(typeof cdqV19Gs==='function')p=cdqV19Gs(name,args);\n    else throw new Error('Pont serveur Balance CDQ indisponible.');\n  }catch(e){return Promise.reject(e);}\n  return Promise.race([\n    Promise.resolve(p),\n    new Promise(function(_,reject){\n      setTimeout(function(){reject(new Error('Le serveur ne répond pas. Réessayez.'));},timeoutMs||30000);\n    })\n  ]);\n}\n\nfunction metaForId(id){\n  try{\n    if(typeof cdqDocumentMeta==='function'){\n      const m=cdqDocumentMeta(id);\n      if(m)return m;\n    }\n  }catch(_){}\n  const box=document.querySelector('.file-checkbox[data-file-id=\"'+String(id||'').replace(/[^A-Za-z0-9_-]/g,'')+'\"]');\n  const row=box&&box.closest('.file-row');\n  return row?{\n    id:String(id||''),\n    nom:String(row.dataset.fileName||''),\n    type:String(row.dataset.fileType||''),\n    dateModification:String(row.dataset.fileDate||'')\n  }:null;\n}\n\nfunction markOpened(id){\n  try{\n    if(String(utilisateurCourantRole||'')==='lecture')return;\n    fichierOuvertPourModification=String(id||'');\n    const meta=metaForId(id)||{};\n    sessionStorage.setItem('fichierEnModification',String(id||''));\n    sessionStorage.setItem('ancienneDateModification',String(meta.dateModification||''));\n    sessionStorage.setItem('momentModification',String(Date.now()));\n  }catch(_){}\n}\n\nfunction selectionActive(){\n  if(document.body.classList.contains('selection-active'))return true;\n  try{\n    if(typeof modeSelectionFichiers!=='undefined'&&modeSelectionFichiers)return true;\n  }catch(_){}\n  return false;\n}\n\nfunction pdfRowFromEvent(e){\n  const target=e&&e.target;\n  if(!target||!target.closest)return null;\n  if(target.closest('button,a,input,select,textarea,label'))return null;\n  const row=target.closest('.file-row');\n  if(!row)return null;\n  if(String(row.dataset.fileType||'').toUpperCase()!=='PDF')return null;\n  const box=row.querySelector('.file-checkbox[data-file-id]');\n  if(!box)return null;\n  return {row:row,id:String(box.dataset.fileId||'')};\n}\n\nfunction rowSwiped(row){\n  return !!(row&&(row.classList.contains('cdq-swiped-left')||row.classList.contains('cdq-swiped-right')));\n}\n\nfunction overlay(){\n  let o=document.getElementById('cdqV2408PdfOverlay');\n  if(o)return o;\n  o=document.createElement('div');\n  o.id='cdqV2408PdfOverlay';\n  o.innerHTML='<div class=\"cdq-v2408-card\">'+\n    '<div class=\"cdq-v2408-title\">Ouverture du PDF</div>'+\n    '<div class=\"cdq-v2408-text\" id=\"cdqV2408PdfText\">Préparation…</div>'+\n    '<div class=\"cdq-v2408-track\"><div id=\"cdqV2408PdfBar\"></div></div>'+\n    '<div id=\"cdqV2408PdfDetail\"></div>'+\n    '<button id=\"cdqV2408PdfClose\" type=\"button\" hidden>Fermer</button>'+\n  '</div>';\n  document.body.appendChild(o);\n  o.querySelector('#cdqV2408PdfClose').onclick=function(){o.remove();busy=false;};\n  return o;\n}\n\nfunction progress(text,pct,detail,error){\n  const o=overlay();\n  const t=o.querySelector('#cdqV2408PdfText');\n  const b=o.querySelector('#cdqV2408PdfBar');\n  const d=o.querySelector('#cdqV2408PdfDetail');\n  const c=o.querySelector('#cdqV2408PdfClose');\n  if(t)t.textContent=String(text||'');\n  if(b)b.style.width=Math.max(0,Math.min(100,Number(pct)||0))+'%';\n  if(d)d.textContent=String(detail||'');\n  if(c)c.hidden=!error;\n  o.classList.toggle('error',!!error);\n}\n\nfunction closeOverlay(){\n  const o=document.getElementById('cdqV2408PdfOverlay');\n  if(o)o.remove();\n}\n\nfunction b64ToBytes(base64){\n  const bin=atob(String(base64||''));\n  const out=new Uint8Array(bin.length);\n  for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i);\n  return out;\n}\n\nasync function blobToBase64(blob){\n  const bytes=new Uint8Array(await blob.arrayBuffer());\n  let binary='';\n  const step=0x8000;\n  for(let i=0;i<bytes.length;i+=step){\n    binary+=String.fromCharCode.apply(null,bytes.subarray(i,i+step));\n  }\n  return btoa(binary);\n}\n\nfunction isReadOnly(){\n  try{return String(utilisateurCourantRole||'')==='lecture';}\n  catch(_){return false;}\n}\n\nfunction openReader(id,name,blob){\n  return new Promise(function(resolve,reject){\n    const old=document.getElementById('cdqReaderFrame');\n    if(old)old.remove();\n\n    const frame=document.createElement('iframe');\n    frame.id='cdqReaderFrame';\n    frame.title=name||'Rapport PDF';\n    frame.src=READER_URL;\n    frame.referrerPolicy='origin';\n    frame.style.cssText='position:fixed;inset:0;width:100%;height:100%;border:0;z-index:2147483000;background:#101820';\n\n    let ready=false;\n    let resolved=false;\n    const saveIds=new Set();\n\n    const timer=setTimeout(function(){\n      if(ready||resolved)return;\n      resolved=true;\n      window.removeEventListener('message',receive);\n      frame.remove();\n      reject(new Error('Le lecteur PDF CDQ n’a pas répondu.'));\n    },20000);\n\n    async function receive(event){\n      if(event.source!==frame.contentWindow||event.origin!==GH_ORIGIN)return;\n      const data=event.data||{};\n\n      if(data.type==='CDQ_READER_READY'){\n        ready=true;\n        clearTimeout(timer);\n        frame.contentWindow.postMessage({\n          type:'CDQ_READER_OPEN',\n          blob:blob,\n          name:name||'Rapport.pdf',\n          fileId:String(id),\n          readOnly:isReadOnly()\n        },GH_ORIGIN);\n        if(!resolved){resolved=true;resolve(true);}\n        return;\n      }\n\n      if(data.type==='CDQ_READER_CLOSE'){\n        window.removeEventListener('message',receive);\n        frame.remove();\n        return;\n      }\n\n      if(data.type==='CDQ_READER_SAVE'&&data.blob instanceof Blob&&typeof data.requestId==='string'){\n        if(saveIds.has(data.requestId))return;\n        saveIds.add(data.requestId);\n        try{\n          const base64=await blobToBase64(data.blob);\n          const uploadId='v2408-'+crypto.randomUUID().replace(/[^A-Za-z0-9_-]/g,'');\n          await rpc('enregistrerPdfRempliCDQV24',[String(id),base64,uploadId],60000);\n          frame.contentWindow.postMessage({\n            type:'CDQ_READER_SAVED',\n            requestId:data.requestId,\n            ok:true,\n            queued:false\n          },GH_ORIGIN);\n        }catch(err){\n          frame.contentWindow.postMessage({\n            type:'CDQ_READER_SAVED',\n            requestId:data.requestId,\n            ok:false,\n            error:err&&err.message?err.message:String(err)\n          },GH_ORIGIN);\n        }\n      }\n    }\n\n    window.addEventListener('message',receive);\n    document.body.appendChild(frame);\n  });\n}\n\nasync function openPdf(id,row){\n  id=String(id||'');\n  if(!/^[A-Za-z0-9_-]{10,200}$/.test(id))return false;\n  if(busy)return true;\n\n  busy=true;\n  markOpened(id);\n  progress('Préparation du PDF…',4,'Lecture du fichier Drive…',false);\n\n  try{\n    const meta=await rpc('preparerPdfOuvertureCDQV24',[id],20000);\n    if(!meta||!meta.ok||!meta.token||!meta.chunks||!meta.taille){\n      throw new Error('Le serveur n’a pas préparé le PDF.');\n    }\n\n    const parts=[];\n    for(let i=0;i<meta.chunks;i++){\n      progress(\n        'Chargement du PDF…',\n        8+Math.round((i/meta.chunks)*76),\n        'Bloc '+(i+1)+' sur '+meta.chunks,\n        false\n      );\n\n      const part=await rpc('obtenirBlocPdfOuvertureCDQV24',[meta.token,i],30000);\n      if(!part||!part.ok||Number(part.index)!==i||!part.base64){\n        throw new Error('Bloc PDF invalide : '+(i+1)+'.');\n      }\n      parts.push(b64ToBytes(part.base64));\n    }\n\n    progress('Vérification du PDF…',88,String(meta.nom||'Rapport.pdf'),false);\n    const blob=new Blob(parts,{type:'application/pdf'});\n\n    if(blob.size!==Number(meta.taille)){\n      throw new Error('Le PDF reçu est incomplet.');\n    }\n    if((await blob.slice(0,5).text())!=='%PDF-'){\n      throw new Error('Le fichier reçu n’est pas un PDF valide.');\n    }\n\n    progress('Ouverture…',97,String(meta.nom||'Rapport.pdf'),false);\n    await openReader(id,String(meta.nom||'Rapport.pdf'),blob);\n    closeOverlay();\n    busy=false;\n\n    openedClickUntil=Date.now()+1200;\n    if(row)row.dataset.cdqV2408Opened='1';\n    setTimeout(function(){\n      if(row)try{delete row.dataset.cdqV2408Opened;}catch(_){}\n    },1300);\n\n    return true;\n  }catch(err){\n    busy=false;\n    progress(\n      'Impossible d’ouvrir le PDF',\n      100,\n      err&&err.message?err.message:String(err),\n      true\n    );\n    return false;\n  }\n}\n\nwindow.addEventListener('pointerdown',function(e){\n  const item=pdfRowFromEvent(e);\n  if(!item)return;\n  if(selectionActive())return;\n  if(rowSwiped(item.row))return;\n\n  tap={\n    row:item.row,\n    id:item.id,\n    pointerId:e.pointerId,\n    x:e.clientX,\n    y:e.clientY,\n    moved:false\n  };\n\n  e.stopImmediatePropagation();\n},true);\n\nwindow.addEventListener('pointermove',function(e){\n  if(!tap||tap.pointerId!==e.pointerId)return;\n  if(Math.abs(e.clientX-tap.x)>18||Math.abs(e.clientY-tap.y)>18){\n    tap.moved=true;\n  }\n},true);\n\nwindow.addEventListener('pointercancel',function(e){\n  if(tap&&tap.pointerId===e.pointerId)tap=null;\n},true);\n\nwindow.addEventListener('pointerup',function(e){\n  if(!tap||tap.pointerId!==e.pointerId)return;\n  const t=tap;\n  tap=null;\n\n  if(t.moved){\n    blockClickUntil=Date.now()+700;\n    return;\n  }\n  if(rowSwiped(t.row))return;\n\n  e.preventDefault();\n  e.stopImmediatePropagation();\n  openPdf(t.id,t.row);\n},true);\n\nwindow.addEventListener('click',function(e){\n  const item=pdfRowFromEvent(e);\n  if(!item)return;\n\n  if(Date.now()<=blockClickUntil){\n    e.preventDefault();\n    e.stopImmediatePropagation();\n    return;\n  }\n\n  if(Date.now()<=openedClickUntil||item.row.dataset.cdqV2408Opened==='1'){\n    e.preventDefault();\n    e.stopImmediatePropagation();\n    try{delete item.row.dataset.cdqV2408Opened;}catch(_){}\n    return;\n  }\n\n  if(selectionActive())return;\n  if(rowSwiped(item.row))return;\n\n  e.preventDefault();\n  e.stopImmediatePropagation();\n  openPdf(item.id,item.row);\n},true);\n\nfunction install(){\n  try{window.cdqV24OpenPdf=function(id){return openPdf(id,null);};}catch(_){}\n  try{\n    window.cdqOuvrirPdfCommeSheetV2275=function(id){return openPdf(id,null);};\n    cdqOuvrirPdfCommeSheetV2275=window.cdqOuvrirPdfCommeSheetV2275;\n  }catch(_){}\n  try{\n    window.cdqOpenPdf=function(id){return openPdf(id,null);};\n    cdqOpenPdf=window.cdqOpenPdf;\n  }catch(_){}\n}\n\ninstall();\nsetTimeout(install,300);\nsetTimeout(install,1000);\n\nwindow.cdqV2408OpenPdf=function(id){return openPdf(id,null);};\n})();\n</script>\n"
    }
  ],
  "audit": {
    "scriptManagerRequired": "V39",
    "androidAppRequired": "Aucune nouvelle APK requise",
    "rootCause": "Le pont natif cdqpdf:// atteint l'activité Android mais celle-ci se ferme après un flash gris sur l'APK actuellement installée.",
    "fixes": [
      "Suppression du pont cdqpdf:// pour l'ouverture PDF Android.",
      "Ouverture du vrai PDF Drive dans le lecteur CDQ intégré, entièrement pilotée par Selector.html et le backend Apps Script existant.",
