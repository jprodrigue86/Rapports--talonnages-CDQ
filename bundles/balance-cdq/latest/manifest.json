      "text": "\n\n<style id=\"cdqV2293GlobalProgressCss\">\n#cdqGlobalProgressV2293{\n  position:fixed;right:12px;bottom:calc(78px + env(safe-area-inset-bottom,0px));\n  z-index:2147483000;min-width:172px;max-width:min(78vw,320px);\n  padding:9px 11px 8px;border-radius:12px;\n  background:rgba(6,16,28,.94);border:1px solid rgba(85,224,255,.55);\n  box-shadow:0 7px 24px rgba(0,0,0,.38);\n  color:#eefcff;font-family:Arial,Helvetica,sans-serif;\n  pointer-events:none;opacity:0;transform:translateY(8px);\n  transition:opacity .16s ease,transform .16s ease;\n}\n#cdqGlobalProgressV2293.show{opacity:1;transform:translateY(0)}\n#cdqGlobalProgressV2293 .cdq-progress-head{display:flex;align-items:center;gap:9px;justify-content:space-between}\n#cdqGlobalProgressV2293 .cdq-progress-label{font-size:12px;font-weight:700;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#cdqGlobalProgressV2293 .cdq-progress-pct{font-size:14px;font-weight:800;min-width:39px;text-align:right;font-variant-numeric:tabular-nums}\n#cdqGlobalProgressV2293 .cdq-progress-track{height:4px;margin-top:7px;border-radius:99px;background:rgba(255,255,255,.14);overflow:hidden}\n#cdqGlobalProgressV2293 .cdq-progress-fill{height:100%;width:0;border-radius:inherit;background:#58e4ff;transition:width .24s ease}\n#cdqGlobalProgressV2293.failed{border-color:rgba(255,105,105,.8)}\n#cdqGlobalProgressV2293.failed .cdq-progress-fill{background:#ff6969}\nhtml.windows #cdqGlobalProgressV2293{bottom:18px;right:18px}\n@media(max-width:520px){\n  #cdqGlobalProgressV2293{right:9px;bottom:calc(72px + env(safe-area-inset-bottom,0px));min-width:158px;max-width:74vw}\n}\n</style>\n<script id=\"cdqV2293GlobalProgressJs\">\n(function(){\n'use strict';\nconst P={seq:0,active:false,value:0,label:'',timer:null,hide:null,failed:false};\n\nfunction el(){\n  let box=document.getElementById('cdqGlobalProgressV2293');\n  if(box)return box;\n  box=document.createElement('div');\n  box.id='cdqGlobalProgressV2293';\n  box.setAttribute('role','status');\n  box.setAttribute('aria-live','polite');\n  box.innerHTML='<div class=\"cdq-progress-head\"><span class=\"cdq-progress-label\">Chargement…</span><strong class=\"cdq-progress-pct\">0 %</strong></div><div class=\"cdq-progress-track\"><div class=\"cdq-progress-fill\"></div></div>';\n  document.body.appendChild(box);\n  return box;\n}\nfunction clearTimers(){\n  if(P.timer){clearInterval(P.timer);P.timer=null;}\n  if(P.hide){clearTimeout(P.hide);P.hide=null;}\n}\nfunction render(){\n  const box=el(),lab=box.querySelector('.cdq-progress-label'),pct=box.querySelector('.cdq-progress-pct'),fill=box.querySelector('.cdq-progress-fill');\n  if(lab)lab.textContent=P.label||'Chargement…';\n  if(pct)pct.textContent=Math.round(P.value)+' %';\n  if(fill)fill.style.width=Math.max(0,Math.min(100,P.value))+'%';\n  box.classList.toggle('failed',!!P.failed);\n  box.classList.toggle('show',!!P.active);\n}\nfunction set(v,label){\n  if(label)P.label=String(label);\n  if(Number.isFinite(Number(v)))P.value=Math.max(P.value,Math.min(100,Number(v)));\n  render();return P.seq;\n}\nfunction start(label,startValue){\n  if(P.active && !P.failed){\n    if(label)P.label=String(label);\n    if(Number.isFinite(Number(startValue)))P.value=Math.max(P.value,Number(startValue));\n    render();return P.seq;\n  }\n  clearTimers();P.seq++;P.active=true;P.failed=false;P.value=Math.max(1,Math.min(90,Number(startValue)||6));P.label=String(label||'Chargement…');render();\n  P.timer=setInterval(function(){\n    if(!P.active||P.failed)return;\n    let step=P.value<28?4:(P.value<58?2:(P.value<82?1:0.5));\n    P.value=Math.min(92,P.value+step);render();\n  },650);\n  return P.seq;\n}\nfunction done(label,seq){\n  if(seq&&seq!==P.seq)return;\n  if(!P.active||P.failed)return;\n  if(P.timer){clearInterval(P.timer);P.timer=null;}\n  P.value=100;P.label=String(label||'Terminé');render();\n  P.hide=setTimeout(function(){P.active=false;render();},750);\n}\nfunction fail(label,seq){\n  if(seq&&seq!==P.seq)return;\n  if(!P.active)start(label||'Erreur',8);\n  if(P.timer){clearInterval(P.timer);P.timer=null;}\n  P.failed=true;P.label=String(label||'Erreur');render();\n  P.hide=setTimeout(function(){P.active=false;P.failed=false;render();},1800);\n}\nfunction kindLabel(kind){\n  return ({photo:'Photo → Drive',note:'Note → Drive','template-copy':'Copie PDF → Drive','pdf-import':'PDF → Drive','inventory-transfer':'Synchronisation inventaire'})[String(kind||'')]||'Synchronisation Drive';\n}\nfunction loadingText(t){\n  return /(chargement|préparation|préparer|création|copie|duplication|synchronisation|en cours|téléchargement|import|envoi|conversion|transfert|enregistrement|actualisation|lecture du projet)/i.test(String(t||''));\n}\nwindow.cdqProgressStartV2293=start;\nwindow.cdqProgressSetV2293=set;\nwindow.cdqProgressDoneV2293=done;\nwindow.cdqProgressFailV2293=fail;\nwindow.cdqProgressStateV2293=P;\n\nif(typeof afficherMessage==='function'){\n  const old=afficherMessage;\n  afficherMessage=function(texte,succes){\n    const r=old.apply(this,arguments);\n    if(succes===true){\n      if(P.active&&!P.failed)done(String(texte||'Terminé'));\n    }else if(loadingText(texte)){\n      start(String(texte||'Chargement…'),8);\n    }\n    return r;\n  };\n  window.afficherMessage=afficherMessage;\n}\nif(typeof afficherErreur==='function'){\n  const old=afficherErreur;\n  afficherErreur=function(erreur){\n    fail((erreur&&erreur.message)?erreur.message:'Erreur');\n    return old.apply(this,arguments);\n  };\n  window.afficherErreur=afficherErreur;\n}\n\nif(typeof confirmerCopie==='function'){\n  const old=confirmerCopie;\n  confirmerCopie=async function(){\n    const token=start('Copie PDF → Drive',8);\n    try{\n      const r=await old.apply(this,arguments);\n      if(P.active&&!P.failed)done('PDF prêt',token);\n      return r;\n    }catch(e){fail(e&&e.message?e.message:'Erreur de copie',token);throw e;}\n  };\n  window.confirmerCopie=confirmerCopie;\n}\n\nif(typeof cdqV19HandlePhotoFile==='function'){\n  const old=cdqV19HandlePhotoFile;\n  cdqV19HandlePhotoFile=async function(){\n    const token=start('Préparation de la photo',5);\n    try{\n      set(18,'Compression de la photo');\n      const r=await old.apply(this,arguments);\n      if(P.active&&!P.failed)done('Photo enregistrée',token);\n      return r;\n    }catch(e){fail(e&&e.message?e.message:'Erreur photo',token);throw e;}\n  };\n  window.cdqV19HandlePhotoFile=cdqV19HandlePhotoFile;\n}\n\nif(typeof cdqV19ProcessAction==='function'){\n  const old=cdqV19ProcessAction;\n  cdqV19ProcessAction=async function(a){\n    if(P.active)set(Math.min(86,Math.max(32,P.value)),kindLabel(a&&a.kind));\n    const r=await old.apply(this,arguments);\n    if(P.active)set(Math.min(90,P.value+9),kindLabel(a&&a.kind));\n    return r;\n  };\n  window.cdqV19ProcessAction=cdqV19ProcessAction;\n}\n\nif(typeof cdqSynchroniserEnAttente==='function'){\n  const old=cdqSynchroniserEnAttente;\n  cdqSynchroniserEnAttente=async function(){\n    let token=P.active?P.seq:start('Synchronisation Drive',12);\n    try{\n      if(typeof cdqV19QueueGet==='function'){\n        try{\n          const q=await cdqV19QueueGet();\n          if(q&&q.length)set(Math.max(22,P.value),kindLabel(q[0].kind));\n        }catch(_){}\n      }\n      const r=await old.apply(this,arguments);\n      if(P.active&&!P.failed)done('Synchronisation terminée',token);\n      return r;\n    }catch(e){fail(e&&e.message?e.message:'Erreur de synchronisation',token);throw e;}\n  };\n  window.cdqSynchroniserEnAttente=cdqSynchroniserEnAttente;\n}\n\nif(typeof confirmerNoteFichier==='function'){\n  const old=confirmerNoteFichier;\n  confirmerNoteFichier=function(){\n    start('Enregistrement de la note',10);\n    return old.apply(this,arguments);\n  };\n  window.confirmerNoteFichier=confirmerNoteFichier;\n}\n\nif(typeof ouvrirNoteElement==='function'){\n  const old=ouvrirNoteElement;\n  ouvrirNoteElement=function(cible){\n    const r=old.apply(this,arguments);\n    try{\n      const input=document.getElementById('noteInput');\n      const modal=document.getElementById('noteModalOverlay');\n      if(input&&input.disabled&&/Chargement de la note/i.test(String(input.value||''))){\n        const token=start('Chargement de la note',10);\n        const born=Date.now();\n        const watch=setInterval(function(){\n          if(!P.active||P.seq!==token){clearInterval(watch);return;}\n          if(!input.disabled || !modal || modal.style.display!=='flex'){\n            clearInterval(watch);if(!P.failed)done('Note chargée',token);return;\n          }\n          if(Date.now()-born>30000){clearInterval(watch);}\n        },160);\n      }\n    }catch(_){}\n    return r;\n  };\n  window.ouvrirNoteElement=ouvrirNoteElement;\n}\n\nif(typeof chargerFichiers==='function'){\n  const old=chargerFichiers;\n  chargerFichiers=function(){\n    start('Chargement des fichiers',7);\n    return old.apply(this,arguments);\n  };\n  window.chargerFichiers=chargerFichiers;\n}\nif(typeof afficherContenu==='function'){\n  const old=afficherContenu;\n  afficherContenu=function(){\n    const r=old.apply(this,arguments);\n    if(P.active&&!P.failed&&/Chargement des fichiers/i.test(P.label))done('Fichiers prêts');\n    return r;\n  };\n  window.afficherContenu=afficherContenu;\n}\n\nif(typeof cdqV19OfflineStatus==='function'){\n  const old=cdqV19OfflineStatus;\n  cdqV19OfflineStatus=function(text,state,clientId){\n    const r=old.apply(this,arguments);\n    const m=String(text||'').match(/Modèle PDF\\s+(\\d+)\\/(\\d+)/i);\n    if(m){\n      const cur=Number(m[1]),tot=Math.max(1,Number(m[2]));\n      start('Téléchargement du modèle PDF',8);\n      set(Math.min(94,Math.round((cur/tot)*90)+4),'Téléchargement du modèle PDF');\n    }else if(state==='ready'&&P.active&&/modèle PDF/i.test(P.label)){\n      done('Modèle PDF prêt');\n    }\n    return r;\n  };\n  window.cdqV19OfflineStatus=cdqV19OfflineStatus;\n}\n\nwindow.addEventListener('online',function(){\n  if(P.active&&P.failed){P.failed=false;render();}\n});\n})();\n</script>\n\n"
    }
