      "text": "<style id=\"cdqPcV2226DirectCss\">\nhtml.pc16-startup-lock,\nhtml.pc16-startup-lock body,\nhtml.pc16-startup-lock #accessOverlay{\n  background-color:#02050a!important;\n  background-image:\n    linear-gradient(rgba(2,5,10,.18),rgba(2,5,10,.34)),\n    url(\"data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%201920%201080%22%3E%0A%3Cdefs%3E%0A%20%20%3ClinearGradient%20id%3D%22bg%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20stop-color%3D%22%2302050a%22%2F%3E%3Cstop%20offset%3D%22.45%22%20stop-color%3D%22%2307101a%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23010306%22%2F%3E%3C%2FlinearGradient%3E%0A%20%20%3CradialGradient%20id%3D%22glow%22%3E%3Cstop%20stop-color%3D%22%2320496a%22%20stop-opacity%3D%22.36%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23000%22%20stop-opacity%3D%220%22%2F%3E%3C%2FradialGradient%3E%0A%20%20%3Cfilter%20id%3D%22noise%22%3E%3CfeTurbulence%20baseFrequency%3D%22.8%22%20numOctaves%3D%224%22%20seed%3D%228%22%20type%3D%22fractalNoise%22%2F%3E%3CfeColorMatrix%20type%3D%22saturate%22%20values%3D%220%22%2F%3E%3CfeComponentTransfer%3E%3CfeFuncA%20type%3D%22table%22%20tableValues%3D%220%20.10%22%2F%3E%3C%2FfeComponentTransfer%3E%3C%2Ffilter%3E%0A%20%20%3Cfilter%20id%3D%22redGlow%22%3E%3CfeGaussianBlur%20stdDeviation%3D%225%22%20result%3D%22b%22%2F%3E%3CfeMerge%3E%3CfeMergeNode%20in%3D%22b%22%2F%3E%3CfeMergeNode%20in%3D%22SourceGraphic%22%2F%3E%3C%2FfeMerge%3E%3C%2Ffilter%3E%0A%3C%2Fdefs%3E%0A%3Crect%20width%3D%221920%22%20height%3D%221080%22%20fill%3D%22url(%23bg)%22%2F%3E%0A%3Crect%20width%3D%221920%22%20height%3D%221080%22%20fill%3D%22url(%23glow)%22%2F%3E%0A%3Crect%20width%3D%221920%22%20height%3D%221080%22%20filter%3D%22url(%23noise)%22%20opacity%3D%22.55%22%2F%3E%0A%3Cg%20fill%3D%22%23e7e7e7%22%20text-anchor%3D%22middle%22%20font-family%3D%22Impact%2CHaettenschweiler%2C'Arial%20Narrow%20Bold'%2Csans-serif%22%3E%0A%20%20%3Ct