{
  "schema": "cdq-script-bundle-v2",
  "version": "V22.53",
  "build": "2026.09.19-v22.53-backend-pdf32mb",
  "title": "Balance CDQ V22.53 — limite PDF serveur 32 Mo",
  "requiresBuild": [
    "2026.09.19-v22.51-progress-nonblocking",
    "2026.09.19-v22.52-pdf-open-32mb"
  ],
  "patches": [
    {
      "file": "Selector.html",
      "op": "replace_build_any",
      "from": [
        "2026.09.19-v22.51-progress-nonblocking",
        "2026.09.19-v22.52-pdf-open-32mb"
      ],
      "to": "2026.09.19-v22.53-backend-pdf32mb"
    },
    {
      "file": "Code.gs",
      "op": "replace_build_any",
      "from": [
        "2026.09.19-v22.51-progress-nonblocking",
        "2026.09.19-v22.52-pdf-open-32mb"
      ],
      "to": "2026.09.19-v22.53-backend-pdf32mb"
    },
    {
      "file": "Code.gs",
      "op": "replace_literal",
      "search": "const CDQ_DOCUMENT_MAX_BYTES_ = 15 * 1024 * 1024;",
      "replacement": "const CDQ_DOCUMENT_MAX_BYTES_ = 32 * 1024 * 1024;",
      "expected": 1
    },
    {
      "file": "Code.gs",
      "op": "replace_literal",
      "search": "Ce PDF dépasse la limite de 15 Mo pour la copie hors ligne.",
      "replacement": "Ce PDF dépasse la limite de 32 Mo pour la copie hors ligne.",
      "expected": 1
    },
    {
      "file": "Code.gs",
      "op": "replace_literal",
      "search": "Choisissez un véritable fichier PDF (15 Mo maximum).",
      "replacement": "Choisissez un véritable fichier PDF (32 Mo maximum).",
      "expected": 1
    },
    {
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "search": "const CDQ_DOCUMENT_MAX_BYTES=15*1024*1024;",
      "replacement": "const CDQ_DOCUMENT_MAX_BYTES=32*1024*1024;",
      "expected": 1
    },
    {
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "search": "Choisissez le PDF rempli, de 15 Mo maximum.",
      "replacement": "Choisissez le PDF rempli, de 32 Mo maximum.",
      "expected": 1
    },
    {
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "search": "content:\"V22.52\";",
      "replacement": "content:\"V22.53\";",
      "expected": 1
    },
    {
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "search": "meta.textContent='V22.52';",
      "replacement": "meta.textContent='V22.53';",
      "expected": 1
    },
    {
      "file": "Selector.html",
      "op": "replace_literal_if_present",
      "search": "root.dataset.build='v22.52-pdf-open-32mb';",
      "replacement": "root.dataset.build='v22.53-backend-pdf32mb';",
      "expected": 1
    }
  ],
  "audit": {
    "scriptManagerRequired": "V30",
    "notes": [
      "Corrige la vraie limite backend Code.gs de 15 Mo à 32 Mo",
      "obtenirMetaDocumentPdfCDQ accepte maintenant Balance de Plancher 22,6 Mo",
      "obtenirChunkDocumentPdfCDQ et enregistrerPdfRempliCDQ utilisent automatiquement la nouvelle limite",
      "Les messages serveur 15 Mo sont remplacés par 32 Mo",
      "Les corrections de progression et d'ouverture précédentes sont conservées"
    ]
  }
}