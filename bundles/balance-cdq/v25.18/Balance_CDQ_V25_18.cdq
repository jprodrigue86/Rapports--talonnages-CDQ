      "search": "async function loadExplorerFolder(folderId,clientId,force){\n  const req=++st.explorer.request;st.explorer.loading=true;renderMain();\n  try{\n    let r=null,erreurV79=null;\n    try{r=await gs('obtenirContenuDossierPCRapideV79',[folderId,clientId,!!force]);}\n    catch(e){erreurV79=e;try{r=await gs('obtenirContenuDossierPCRapideV72',[folderId,clientId,!!force]);}catch(e2){\n      if(String(folderId)===String(clientId)){\n        const legacy=await gs('obtenirContenuClientPC',[clientId,!!force]),root=legacy&&legacy.contenu?legacy.contenu:legacy;\n        r={dossierId:clientId,items:[...(root&&root.dossiers||[]).map(d=>({kind:'folder',id:d.id,nom:d.nom,type:'Dossier'})),...(root&&root.fichiers||[]).map(f=>Object.assign({kind:'file'},f))],crumbs:[{id:clientId,nom:st.explorer.client?st.explorer.client.nom:'Client'}]};\n      }else throw (erreurV79||e2);\n    }}\n    if(req!==st.explorer.request)return;\n    st.explorer.folderId=String(r&&r.dossierId||folderId);st.explorer.items=Array.isArray(r&&r.items)?r.items:[];st.explorer.crumbs=Array.isArray(r&&r.crumbs)&&r.crumbs.length?r.crumbs:st.explorer.crumbs;st.explorer.loading=false;renderMain();\n  }catch(e){if(req!==st.explorer.request)return;st.explorer.loading=false;renderMain();toast('Impossible d’ouvrir le dossier du client : '+(e&&e.message||e),true)}\n}\n",
      "replacement": "const pc18Folders=new Map(),pc18FolderJobs=new Map(),pc18FolderGenerations=new Map();\nlet pc18FolderOwner='';\nasync function loadExplorerFolder(folderId,clientId,force){\n  const owner=pc18Owner();if(!owner)return;\n  if(owner!==pc18FolderOwner){pc18Folders.clear();st.explorer.items=[];st.explorer.crumbs=[];st.pcSelectedFiles.clear();st.pcSelectionMode=false;pc18FolderOwner=owner;}\n  const key=owner+'|'+clientId+'|'+folderId,req=++st.explorer.request;\n  if(force)pc18Folders.delete(key);\n  const cached=pc18Folders.get(key),changed=String(st.explorer.folderId)!==String(folderId);\n  if(changed){st.pcSelectedFiles.clear();st.pcSelectionMode=false;st.explorer.items=[];st.explorer.crumbs=[{id:clientId,nom:st.explorer.client?.nom||'Client'}]}\n  st.explorer.folderId=String(folderId);\n  const apply=r=>{st.explorer.items=Array.isArray(r?.items)?r.items:[];st.explorer.crumbs=Array.isArray(r?.crumbs)&&r.crumbs.length?r.crumbs:st.explorer.crumbs;st.explorer.loading=false;st.lastSync=Date.now();renderMain()};\n  if(cached){apply(cached.value);if(Date.now()-cached.time<30000)return}\n  st.explorer.loading=true;renderMain();\n  let job=!force&&pc18FolderJobs.get(key);\n  if(!job){\n    const generation=(pc18FolderGenerations.get(key)||0)+1;pc18FolderGenerations.set(key,generation);\n    job=gs('obtenirContenuDossierPCRapideV79',[folderId,clientId,!!force]).then(value=>{\n      if(owner===pc18Owner()&&pc18FolderGenerations.get(key)===generation){\n        pc18Folders.delete(key);pc18Folders.set(key,{time:Date.now(),value});\n        while(pc18Folders.size>30)pc18Folders.delete(pc18Folders.keys().next().value);\n      }return value;\n    }).finally(()=>{if(pc18FolderJobs.get(key)===job)pc18FolderJobs.delete(key)});\n    pc18FolderJobs.set(key,job);\n  }\n  try{const r=await job;if(req===st.explorer.request&&owner===pc18Owner())apply(r)}\n  catch(e){if(req!==st.explorer.request||owner!==pc18Owner())return;pc18Folders.delete(key);st.explorer.loading=false;st.explorer.items=[];renderMain();toast('Impossible d’ouvrir le dossier : '+(e&&e.message||e),true)}\n}\n"
