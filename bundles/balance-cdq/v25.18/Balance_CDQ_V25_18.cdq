      "file": "Selector.html",
      "op": "replace_literal",
      "search": "/* Balance CDQ desktop workspace. Native CSS dimensions: no scaled fixed canvas. */\nhtml.windows,html.windows body{margin:0!important;padding:0!important;width:100%!important;height:100%!important;max-width:none!important;transform:none!important;zoom:1!important;overflow:hidden!important}\nhtml.windows.pc16-startup-lock,html.windows.pc16-startup-lock body,html.windows #accessOverlay{background:#080808 url(\"https://jprodrigue86.github.io/Rapports--talonnages-CDQ/assets/music-wall-panoramic-v2517.webp\") center/cover no-repeat!important}\nhtml.windows #accessOverlay{background-attachment:fixed!important}\nhtml.windows #cdqPcV16{--pc-bg:#0b0d10;--pc-panel:#13171c;--pc-raised:#1b2129;--pc-line:#2b333e;--pc-ink:#edf1f5;--pc-muted:#9aa7b7;--pc-accent:#50c6f6;--pc-font:15px;--pc-row:56px;position:fixed!important;inset:0!important;padding:0!important;margin:0!important;max-width:none!important;font:var(--pc-font)/1.45 system-ui,-apple-system,\"Segoe UI\",sans-serif!important;color:var(--pc-ink)!important;background:var(--pc-bg)!important;overflow:hidden!important}\nhtml.windows #cdqPcV16[data-theme=dark]{--pc-bg:#09121c;--pc-panel:#101f2e;--pc-raised:#1a2e41;--pc-line:#2d4256}\nhtml.windows #cdqPcV16[data-theme=electric]{--pc-bg:#071429;--pc-panel:#0d2340;--pc-raised:#123456;--pc-line:#28587d;--pc-accent:#56cfff}\nhtml.windows #cdqPcV16[data-theme=steel]{--pc-bg:#23282d;--pc-panel:#2d343c;--pc-raised:#3b4550;--pc-line:#566371;--pc-muted:#bcc5cf}\nhtml.windows #cdqPcV16[data-theme=violet]{--pc-bg:#140d20;--pc-panel:#20152e;--pc-raised:#302040;--pc-line:#513666;--pc-accent:#cda2f6}\nhtml.windows #cdqPcV16 *{box-sizing:border-box}\nhtml.windows #cdqPcV16 button,html.windows #cdqPcV16 input,html.windows #cdqPcV16 select{font:inherit}\nhtml.windows #cdqPcV16 button{cursor:pointer}\nhtml.windows #cdqPcV16 button:focus-visible,html.windows #cdqPcV16 input:focus-visible,html.windows #cdqPcV16 tr:focus-visible{outline:2px solid var(--pc-accent);outline-offset:2px}\nhtml.windows #cdqPcV16 svg{width:20px;height:20px;flex-shrink:0;vertical-align:middle}\nhtml.windows #cdqPcV16 .pc16-stage{position:relative!important;inset:0!important;width:100%!important;height:100%!important;transform:none!important;zoom:1!important;will-change:auto!important;display:grid!important;grid-template-rows:clamp(86px,8.6vw,132px) minmax(0,1fr)!important;background:var(--pc-bg)!important;overflow:hidden!important}\nhtml.windows #cdqPcV16 .pc16-header{position:relative!important;inset:auto!important;width:100%!important;height:100%!important;max-width:none!important;transform:none!important;background:#03080d!important;border:0!important;padding:0!important;overflow:hidden!important}\n.pc17-banner{height:100%;width:100%;background:url(\"https://jprodrigue86.github.io/Rapports--talonnages-CDQ/bundles/balance-cdq/v25.17/banner-original.webp\") center/cover no-repeat;filter:brightness(1.1)}\nhtml.windows #cdqPcV16 .pc16-body{position:relative!important;inset:auto!important;width:100%!important;height:100%!important;display:grid!important;grid-template-columns:220px minmax(0,1fr)!important;gap:0!important;min-height:0!important;padding:0!important;margin:0!important}\nhtml.windows #cdqPcV16 .pc16-sidebar{position:relative!important;inset:auto!important;width:auto!important;height:auto!important;min-width:0!important;min-height:0!important;padding:18px 12px 12px!important;border:0!important;border-right:1px solid var(--pc-line)!important;background:var(--pc-panel)!important;display:flex!important;flex-direction:column!important;overflow:auto!important}\nhtml.windows #cdqPcV16 .pc16-nav{display:grid!important;gap:5px!important;padding:0!important;margin:0!important}\nhtml.windows #cdqPcV16 .pc16-nav button{display:flex!important;align-items:center!important;gap:12px!important;min-height:43px!important;height:auto!important;padding:10px 12px!important;border:0!important;border-radius:8px!important;background:transparent!important;box-shadow:none!important;color:var(--pc-muted)!important;text-align:left!important;font-size:14px!important;font-weight:600!important;letter-spacing:0!important;white-space:normal!important}\nhtml.windows #cdqPcV16 .pc16-nav button[hidden]{display:none!important}\nhtml.windows #cdqPcV16 .pc16-nav button.active{background:var(--pc-raised)!important;color:var(--pc-ink)!important;box-shadow:inset 3px 0 var(--pc-accent)!important}\nhtml.windows #cdqPcV16 .pc16-nav .ico{display:inline-flex!important;align-items:center;justify-content:center;width:25px!important;height:25px!important;font-size:20px!important;color:inherit!important;flex:0 0 25px!important}\nhtml.windows #cdqPcV16 .pc16-nav .pc17-art{background-image:url(\"https://jprodrigue86.github.io/Rapports--talonnages-CDQ/bundles/balance-cdq/v25.15/icons-transparent.webp\");background-size:var(--cdq-art-size);background-position:var(--cdq-art-position);background-repeat:no-repeat;filter:none!important}\nhtml.windows #cdqPcV16 .pc16-shortcuts{position:static!important;display:grid!important;gap:4px!important;margin:20px 0 12px!important;padding:16px 0 0!important;border-top:1px solid var(--pc-line)!important}\nhtml.windows #cdqPcV16 .pc16-shortcuts h4{font-size:11px!important;font-weight:600!important;text-transform:uppercase;letter-spacing:1px;color:var(--pc-muted);margin:9px 10px 4px!important}\nhtml.windows #cdqPcV16 .pc16-shortcuts button{display:flex!important;align-items:center!important;gap:9px!important;min-height:36px!important;height:auto!important;padding:7px 10px!important;font-size:12px!important;color:var(--pc-muted)!important;background:transparent!important;border:0!important;border-radius:6px!important;box-shadow:none!important;text-align:left!important}\nhtml.windows #cdqPcV16 .pc16-shortcuts svg{width:17px;height:17px}\nhtml.windows #cdqPcV16 .pc16-nav button:hover,html.windows #cdqPcV16 .pc16-shortcuts button:hover{background:var(--pc-raised)!important;color:var(--pc-ink)!important}\n.pc17-clock{display:flex;flex-direction:column;gap:2px;color:var(--pc-muted);font-size:11px;padding:0 10px 8px}.pc17-clock b{font-size:16px;font-weight:600;color:var(--pc-ink)}\nhtml.windows #cdqPcV16 .pc16-side-status{position:static!important;margin-top:auto!important;padding:12px 10px 0!important;border-top:1px solid var(--pc-line)!important;background:transparent!important;font-size:12px!important}\nhtml.windows #cdqPcV16 .pc16-side-meta{display:flex!important;justify-content:space-between!important;font-size:10px!important;color:var(--pc-muted)!important;margin-bottom:10px!important}\nhtml.windows #cdqPcV16 .pc16-side-user .avatar{width:30px!important;height:30px!important;font-size:12px!important;background:var(--pc-raised)!important}.pc16-side-user .copy b{font-size:11px!important}.pc16-side-user .copy small{font-size:10px!important}\nhtml.windows #cdqPcV16 .pc16-center{display:flex!important;flex-direction:column!important;position:relative!important;width:auto!important;height:auto!important;min-width:0!important;min-height:0!important;padding:22px 26px 16px!important;gap:20px!important;overflow:hidden!important;background:var(--pc-bg)!important}\nhtml.windows #cdqPcV16 .pc16-rail,html.windows #cdqPcV16 .pc16-footer{display:none!important}\nhtml.windows #cdqPcV16 .pc16-kpis{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:12px!important;height:auto!important;flex:0 0 auto!important;padding:0!important;margin:0!important}\nhtml.windows #cdqPcV16:not([data-view=home]) .pc16-kpis{display:none!important}\nhtml.windows #cdqPcV16 .pc16-kpi{position:relative!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;justify-content:space-between!important;min-width:0!important;height:122px!important;padding:15px 16px!important;border:1px solid var(--pc-line)!important;border-top:2px solid var(--c)!important;border-radius:10px!important;background:var(--pc-panel)!important;color:var(--pc-ink)!important;box-shadow:none!important;text-al