    {
      "file": "Selector.html",
      "op": "replace_literal",
      "search": "async function loadClients(force){\n  if(!force&&!st.clients.length){\n    if(pc16RestoreGlobalCache())renderAll();\n  }\n  try{\n    let changed=false,clients;\n    try{clients=await gs('obtenirDossiersClientsPCLeger',[!!force])}\n    catch(_){clients=await gs('obtenirDossiersClients',[!!force])}\n    if(Array.isArray(clients)){\n      const a=JSON.stringify((st.clients||[]).map(c=>[c.id,c.nom,c.dateModification||'']));\n      const b=JSON.stringify(clients.map(c=>[c.id,c.nom,c.dateModification||'']));\n      if(a!==b){st.clients=clients;changed=true}\n      st.lastClientsSync=Date.now();\n    }\n    const ids=st.clients.map(c=>c.id);\n    const jobs=[\n      gs('obtenirResumesConformiteClientsCDQ',[ids]).catch(()=>null),\n      gs('obtenirRapportsRecentsPC',[40,!!force]).catch(()=>null)\n    ];\n    const result=await Promise.all(jobs);\n    if(result[0]){\n      if(JSON.stringify(st.summaries||{})!==JSON.stringify(result[0]))changed=true;\n      st.summaries=result[0];\n    }\n    if(Array.isArray(result[1])){\n      const a=JSON.stringify((st.recent||[]).map(f=>[f.id,f.nom,f.dateModification||'',f.typeBalance||'']));\n      const b=JSON.stringify(result[1].map(f=>[f.id,f.nom,f.dateModification||'',f.typeBalance||'']));\n      if(a!==b)changed=true;\n      st.recent=result[1];\n    }\n    if(!st.selected&&st.recent.length)st.selected=st.recent[0];\n    st.lastClientsSync=Date.now();pc16SaveGlobalCache();\n    if(changed)renderAll();\n  }catch(e){toast(e&&e.message||e,true)}\n}\n",
      "replacement": "let pc18ClientsJob=null,pc18ClientGeneration=0;\nfunction pc18Owner(){return String(typeof utilisateurCourantEmail==='undefined'?'':utilisateurCourantEmail).trim().toLowerCase()}\nasync function loadClients(force){\n  if(pc18ClientsJob)return pc18ClientsJob;\n  const owner=pc18Owner(),generation=++pc18ClientGeneration;\n  if(!owner)return;\n  const current=()=>owner===pc18Owner()&&generation===pc18ClientGeneration;\n  if(!force&&!st.clients.length&&pc16RestoreGlobalCache())renderAll();\n  pc18ClientsJob=(async()=>{\n    try{\n      const clients=await gs('obtenirDossiersClientsPCLeger',[!!force]);\n      if(!current())return;\n      if(Array.isArray(clients))st.clients=clients;\n      st.lastClientsSync=Date.now();pc16SaveGlobalCache();renderKpis();\n      if(st.view==='clients'||st.view==='home')renderMain();\n      // Secondary data must never hold up the client list or reset a report selection.\n      gs('obtenirResumesConformiteClientsCDQ',[st.clients.map(c=>c.id)]).then(value=>{\n        if(!current()||!value)return;st.summaries=value;pc16SaveGlobalCache();renderKpis();\n        if(st.view==='home'||st.view==='clients')renderMain();\n      }).catch(()=>{});\n      gs('obtenirRapportsRecentsPC',[40,!!force]).then(value=>{\n        if(!current()||!Array.isArray(value))return;st.recent=value;\n        if(!st.selected&&value.length)st.selected=value[0];pc16SaveGlobalCache();\n        if(st.view==='home')renderMain();\n      }).catch(()=>{});\n    }catch(e){if(current())toast(e&&e.message||e,true)}\n  })();\n  try{await pc18ClientsJob}finally{pc18ClientsJob=null}\n}\n"
