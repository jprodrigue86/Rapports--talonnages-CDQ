      "search": "async function downloadFile(f){\n  try{\n    toast('Préparation du téléchargement…');\n    const r=await gs('telechargerFichierPC',[f.id]);\n    if(r&&r.driveUrl&&!r.base64){window.open(r.driveUrl,'_blank','noopener');return}\n    if(!r||!r.base64)throw new Error('Téléchargement indisponible.');\n    const bin=atob(r.base64),bytes=new Uint8Array(bin.length);\n    for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);\n    const blob=new Blob([bytes],{type:r.mimeType||'application/octet-stream'}),url=URL.createObjectURL(blob),a=document.createElement('a');\n    a.href=url;a.download=r.nom||f.nom||'fichier';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),5000);\n    toast('Téléchargement lancé.');\n  }catch(e){toast(e&&e.message||e,true)}\n}\n",
      "replacement": "async function downloadFile(f){\n  const tab=window.open('about:blank','_blank');\n  if(!tab){toast('Autorisez l’ouverture d’un onglet pour télécharger ce fichier.',true);return}\n  try{tab.opener=null;tab.document.title='Téléchargement CDQ';tab.document.body.textContent='Préparation du téléchargement…'}catch(_){}\n  try{\n    const result=await gs('obtenirLienTelechargementPCV2518',[f.id]);\n    const url=new URL(result.url);\n    if(url.protocol!=='https:'||!['drive.google.com','docs.google.com'].includes(url.hostname))throw new Error('Adresse de téléchargement invalide.');\n    const target=typeof window.cdqWithDefaultGoogleAccountV2294==='function'?window.cdqWithDefaultGoogleAccountV2294(url.href):url.href;\n    tab.location.replace(target);toast('Téléchargement demandé à Google Drive.');\n  }catch(e){try{tab.close()}catch(_){}toast(e&&e.message||e,true)}\n}\n"
