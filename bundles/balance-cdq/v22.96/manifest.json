      "text": "\n\n<script id=\"cdqV2296DefaultAccountNoPickerJs\">\n(function(){\n'use strict';\n\nconst KEY='cdqDefaultGoogleAccountV2294';\nconst RESET_KEY='cdqDefaultGoogleAccountResetV2296';\n\nfunction emailDefault(){\n  try{return String(localStorage.getItem(KEY)||'').trim().toLowerCase();}catch(_){return '';}\n}\nfunction emailCourant(){\n  try{return String(utilisateurCourantEmail||'').trim().toLowerCase();}catch(_){return '';}\n}\nfunction hasReset(){\n  try{return localStorage.getItem(RESET_KEY)==='1';}catch(_){return false;}\n}\nfunction markReset(v){\n  try{if(v)localStorage.setItem(RESET_KEY,'1');else localStorage.removeItem(RESET_KEY);}catch(_){}\n}\nfunction setDefault(email){\n  email=String(email||'').trim().toLowerCase();\n  const setter=window.cdqSetGoogleDefaultAccountV2294;\n  if(email){\n    markReset(false);\n    if(typeof setter==='function')return setter(email);\n    try{localStorage.setItem(KEY,email);}catch(_){}\n    return email;\n  }\n  markReset(true);\n  if(typeof setter==='function')return setter('');\n  try{localStorage.removeItem(KEY);}catch(_){}\n  return '';\n}\n\n// Premier démarrage de V22.96 : le compte CDQ connecté devient le compte\n// par défaut automatiquement. Une réinitialisation explicite empêche\n// cette auto-sélection de revenir.\nfunction ensureDefaultFromCdq(){\n  if(emailDefault()||hasReset())return;\n  const e=emailCourant();\n  if(!e)return;\n  try{\n    const setter=window.cdqSetGoogleDefaultAccountV2294;\n    if(typeof setter==='function')setter(e);\n    else localStorage.setItem(KEY,e);\n  }catch(_){}\n}\n\nfunction encodeChromeIntent(url){\n  try{\n    const u=new URL(url);\n    const path=u.host+u.pathname+u.search+u.hash;\n    return 'intent://'+path+\n      '#Intent;scheme=https;package=com.android.chrome;'+\n      'S.browser_fallback_url='+encodeURIComponent(u.href)+';end';\n  }catch(_){return String(url||'');}\n}\n\nfunction markFileOpened(id){\n  if(String(typeof utilisateurCourantRole!=='undefined'?utilisateurCourantRole:'')==='lecture')return;\n  try{\n    fichierOuvertPourModification=id;\n    const meta=typeof cdqDocumentMeta==='function'?(cdqDocumentMeta(id)||{}):{};\n    sessionStorage.setItem('fichierEnModification',id);\n    sessionStorage.setItem('ancienneDateModification',String(meta.dateModification||''));\n    sessionStorage.setItem('momentModification',String(Date.now()));\n  }catch(_){}\n}\n\nfunction sheetWebUrl(id,email){\n  id=String(id||'');\n  if(!/^[\\w-]+$/.test(id))throw new Error('Identifiant de feuille invalide.');\n  const u=new URL('https://docs.google.com/spreadsheets/d/'+id+'/edit');\n  u.searchParams.set('authuser',email);\n  u.searchParams.set('usp','drivesdk');\n  return u.href;\n}\n\nfunction openSheetWithoutPicker(id){\n  const email=emailDefault();\n  if(!email)return false;\n  const url=sheetWebUrl(id,email);\n  markFileOpened(id);\n\n  // IMPORTANT : ne pas remettre le package Sheets/Drive ici.\n  // En ciblant Chrome, Android ne lance plus son sélecteur de comptes natif.\n  if(/Android/i.test(navigator.userAgent||'')){\n    window.location.href=encodeChromeIntent(url);\n  }else{\n    const a=document.createElement('a');\n    a.href=url;a.target='_blank';a.rel='noopener';\n    document.body.appendChild(a);a.click();a.remove();\n  }\n  return true;\n}\n\nasync function openPdfWithoutPicker(id){\n  const email=emailDefault();\n  if(!email)return false;\n  markFileOpened(id);\n\n  // Le PDF est récupéré par le moteur CDQ déjà authentifié puis envoyé au\n  // lecteur configuré. Aucun passage par Google Drive natif = aucun picker.\n  if(typeof cdqOpenPdf==='function'){\n    await cdqOpenPdf(id);\n    return true;\n  }\n  if(typeof cdqOpenPdfInternal==='function' && typeof cdqLoadPdfRecord==='function'){\n    const rec=await cdqLoadPdfRecord(id);\n    await cdqOpenPdfInternal(id,rec);\n    return true;\n  }\n  return false;\n}\n\nfunction installOpenOverride(){\n  if(window.__cdqV2296OpenInstalled)return;\n  if(typeof window.modifierFichier!=='function')return;\n  const old=window.modifierFichier;\n  window.__cdqV2296OpenInstalled=true;\n  window.__cdqV2296OldModify=old;\n\n  window.modifierFichier=function(id){\n    const def=emailDefault();\n    if(!def || navigator.onLine===false){\n      return old.apply(this,arguments);\n    }\n\n    let meta=null;\n    try{meta=typeof cdqDocumentMeta==='function'?cdqDocumentMeta(id):null;}catch(_){}\n\n    if(meta&&meta.type==='GOOGLE_SHEETS'){\n      try{\n        if(typeof afficherMessage==='function')afficherMessage('Ouverture avec '+def+'…',false);\n        return openSheetWithoutPicker(id);\n      }catch(e){\n        if(typeof afficherErreur==='function')afficherErreur(e);\n        return false;\n      }\n    }\n\n    if(meta&&meta.type==='PDF'){\n      if(typeof afficherMessage==='function')afficherMessage('Ouverture du PDF…',false);\n      return Promise.resolve(openPdfWithoutPicker(id)).catch(function(e){\n        if(typeof afficherErreur==='function')afficherErreur(e);\n      });\n    }\n\n    return old.apply(this,arguments);\n  };\n}\n\nfunction rebindSettings(){\n  const modal=document.getElementById('cdqSettingsModalV2294');\n  if(!modal)return;\n\n  const save=modal.querySelector('#cdqSaveGoogleDefaultV2294');\n  const reset=modal.querySelector('#cdqResetGoogleDefaultV2294');\n  const current=modal.querySelector('#cdqCurrentGoogleRowV2294');\n\n  if(save && save.dataset.cdqV2296!=='1'){\n    save.dataset.cdqV2296='1';\n    save.onclick=function(){\n      const input=modal.querySelector('#cdqDefaultGoogleEmailV2294');\n      const e=String(input&&input.value||'').trim().toLowerCase();\n      if(!e){if(typeof afficherErreur==='function')afficherErreur(new Error('Entrez le compte Google par défaut.'));return;}\n      try{\n        setDefault(e);\n        updateSettingsText();\n      }catch(err){if(typeof afficherErreur==='function')afficherErreur(err);}\n    };\n  }\n\n  if(reset && reset.dataset.cdqV2296!=='1'){\n    reset.dataset.cdqV2296='1';\n    reset.onclick=function(){\n      setDefault('');\n      updateSettingsText();\n      if(typeof afficherMessage==='function')afficherMessage('Compte par défaut réinitialisé. Google demandera de nouveau le compte.',true);\n    };\n  }\n\n  if(current && current.dataset.cdqV2296!=='1'){\n    current.dataset.cdqV2296='1';\n    current.addEventListener('click',function(e){\n      const b=e.target&&e.target.closest?e.target.closest('button'):null;\n      if(!b)return;\n      setTimeout(function(){\n        const def=emailDefault();\n        if(def)markReset(false);\n        updateSettingsText();\n      },0);\n    });\n  }\n\n  updateSettingsText();\n}\n\nfunction updateSettingsText(){\n  const modal=document.getElementById('cdqSettingsModalV2294');\n  if(!modal)return;\n  const status=modal.querySelector('#cdqDefaultGoogleStatusV2294');\n  const p=modal.querySelector('.cdq-settings-card-v2294:nth-of-type(2) p');\n  const def=emailDefault();\n  if(status){\n    status.innerHTML=def\n      ? 'Compte par défaut actif : <strong>'+def.replace(/[&<>\"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]);})+'</strong><br><small>Sheets et PDF s’ouvriront sans le sélecteur de comptes Google.</small>'\n      : 'Compte par défaut : <strong>Aucun</strong><br><small>Google demandera le compte à chaque ouverture.</small>';\n  }\n  if(p)p.textContent='Quand un compte est défini, CDQ évite le sélecteur Android de comptes Google. Réinitialisez ici pour réactiver le choix de compte.';\n}\n\nfunction boot(){\n  ensureDefaultFromCdq();\n  installOpenOverride();\n  rebindSettings();\n}\n\nif(document.readyState==='loading'){\n  document.addEventListener('DOMContentLoaded',function(){setTimeout(boot,120);setTimeout(boot,900);},{once:true});\n}else{\n  setTimeout(boot,20);setTimeout(boot,700);\n}\nwindow.addEventListener('load',function(){setTimeout(boot,150);setTimeout(boot,1200);});\nwindow.addEventListener('cdq:access-ready',function(){setTimeout(boot,80);});\n\ntry{\n  new MutationObserver(function(){\n    clearTimeout(window.__cdqV2296Mutation);\n    window.__cdqV2296Mutation=setTimeout(function(){rebindSettings();installOpenOverride();},80);\n  }).observe(document.body,{childList:true,subtree:true});\n}catch(_){}\n\nwindow.cdqDefaultGoogleAccountV2296=emailDefault;\nwindow.cdqResetDefaultGoogleAccountV2296=function(){return setDefault('');};\n})();\n</script>\n\n"
    }
