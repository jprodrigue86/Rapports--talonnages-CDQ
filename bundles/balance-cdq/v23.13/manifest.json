      "before": "</body>",
      "text": "\n<style id=\"cdqV2313AndroidUpdaterCss\">\n#cdqAndroidUpdaterBoxV2313{\n  margin:10px 0 2px;\n  padding:11px;\n  border:1px solid #2c7ea5;\n  border-radius:10px;\n  background:#071d2b;\n}\n#cdqAndroidUpdaterBoxV2313 strong{\n  display:block;\n  color:#e2f7ff;\n  margin-bottom:4px;\n}\n#cdqAndroidUpdaterBoxV2313 p{\n  margin:4px 0 9px!important;\n  color:#9fc1d4!important;\n  font-size:12px!important;\n  line-height:1.4!important;\n}\n#cdqAndroidUpdaterButtonV2313{\n  width:100%;\n  min-height:46px;\n  border:1px solid #23afe8;\n  border-radius:9px;\n  background:#0c3650;\n  color:#fff;\n  font-weight:850;\n}\n</style>\n<script id=\"cdqV2313AndroidUpdaterJs\">\n(function(){\n'use strict';\n\nfunction installUpdaterV2313(){\n  const anchor=document.getElementById('cdqNativeAccountBoxV2311') ||\n               document.getElementById('cdqDefaultGoogleStatusV2294');\n  if(!anchor)return;\n  if(document.getElementById('cdqAndroidUpdaterBoxV2313'))return;\n\n  const box=document.createElement('div');\n  box.id='cdqAndroidUpdaterBoxV2313';\n  box.innerHTML=\n    '<strong>⬆ Mise à jour Android</strong>'+\n    '<p>Les mises à jour normales de Balance CDQ continuent avec Script Manager. '+\n    'Ce bouton sert seulement quand la petite couche Android native doit être mise à jour.</p>'+\n    '<button type=\"button\" id=\"cdqAndroidUpdaterButtonV2313\">Vérifier la mise à jour Android</button>';\n\n  anchor.insertAdjacentElement('afterend',box);\n\n  box.querySelector('#cdqAndroidUpdaterButtonV2313').onclick=function(){\n    const fallback='https://jprodrigue86.github.io/Rapports--talonnages-CDQ/balance-cdq-android.html';\n    const intent='intent://check#Intent;scheme=cdqupdate;package=ca.balancecdq.android;'+\n      'S.browser_fallback_url='+encodeURIComponent(fallback)+';end';\n    window.location.href=intent;\n  };\n}\n\nfunction scheduleUpdaterV2313(){\n  clearTimeout(window.__cdqUpdaterInstallV2313);\n  window.__cdqUpdaterInstallV2313=setTimeout(installUpdaterV2313,80);\n}\n\nif(document.readyState==='loading'){\n  document.addEventListener('DOMContentLoaded',function(){\n    scheduleUpdaterV2313();\n    setTimeout(scheduleUpdaterV2313,600);\n  },{once:true});\n}else{\n  scheduleUpdaterV2313();\n  setTimeout(scheduleUpdaterV2313,600);\n}\n\nwindow.addEventListener('load',function(){\n  setTimeout(scheduleUpdaterV2313,180);\n});\n\nwindow.addEventListener('cdq:access-ready',function(){\n  setTimeout(scheduleUpdaterV2313,180);\n});\n\ntry{\n  new MutationObserver(scheduleUpdaterV2313).observe(document.body,{childList:true,subtree:true});\n}catch(_){}\n})();\n</script>\n"
    }
