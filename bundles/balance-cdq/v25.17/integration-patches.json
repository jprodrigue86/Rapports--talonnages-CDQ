    "search": "function scaleStage(){\n  const r=$('#cdqPcV16'),stage=$('.pc16-stage',r);if(!r||!stage)return;\n  const BASE_W=1536,BASE_H=864;\n  const v=pc16ViewportV21_65();\n\n  // Keep the width full, but deliberately use only 94% of the visible height.\n  // This fixes the PC dashboard looking too tall while preserving the width.\n  const scaleX=Math.max(.10,Math.min(5,v.w/BASE_W));\n  const scaleY=Math.max(.10,Math.min(5,(v.h*.94)/BASE_H));\n\n  r.style.setProperty('left','0px','important');\n  r.style.setProperty('top',v.oy+'px','important');\n  r.style.setProperty('width',v.w+'px','important');\n  r.style.setProperty('height',v.h+'px','important');\n  r.style.setProperty('max-width','none','important');\n  r.style.setProperty('max-height','none','important');\n  r.style.setProperty('margin','0','important');\n  r.style.setProperty('overflow','hidden','important');\n  r.style.background='#020911';\n\n  stage.style.setProperty('left','0px','important');\n  stage.style.setProperty('top','0px','important');\n  stage.style.setProperty('width',BASE_W+'px','important');\n  stage.style.setProperty('height',BASE_H+'px','important');\n  stage.style.setProperty('transform-origin','0 0','important');\n  stage.style.setProperty('transform','scale('+scaleX+','+scaleY+')','important');\n\n  const sig=v.w+'x'+v.h+'@'+scaleX.toFixed(4)+'x'+scaleY.toFixed(4);\n  if(pc16LastFitV21_65!==sig){\n    pc16LastFitV21_65=sig;\n    stage.dataset.fit=sig;\n    stage.dataset.viewport=v.w+'x'+v.h;\n  }\n}\n",
    "replacement": "function scaleStage(){window.cdqDesktopV2517.scale();}\n"
  },
